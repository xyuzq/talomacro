end

local function quoteId(id)

    if type(id)~="string" then return nil end

    local operation,item=id:match("^(%a+):(.+)$")

    return operation and operation..":"..canonical(item) or "buy:"..canonical(id)

end

function EconomyCatalog.provenance()return copy(provenance)end

function EconomyCatalog.quote(id,count,placeVersion)

    local definition=definitions[quoteId(id)]

    if not definition then return nil,"Item/recipe is absent from the captured catalogue" end

    count=count or 1

    if not quantity(count) or count<1 or count>10000 or definition.kind~="craft" and count~=1 then return nil,"A gear purchase is one item; recipe order count must be 1..10000" end

    if placeVersion~=nil and placeVersion~=provenance.placeVersion then return nil,"Catalogue belongs to another place version" end

    local out=copy(definition);out.quantity=count;out.sourceMapped=definition.costStatus=="captured_literal"

    out.costVerified=false;out.executable=false;out.captureId=provenance.captureId;out.placeVersion=provenance.placeVersion

    out.sourceKind=provenance.sourceKind;out.sourceHash=provenance.modules[definition.sourceModule].sha256

    for resource,amount in pairs(out.costs)do

        if not quantity(amount) or not quantity(amount*count) then return nil,"Cost is outside Luau's exact integer range" end

        out.costs[resource]=amount*count

    end

    if out.secondsPerUnit then out.totalSeconds=out.secondsPerUnit*count end

    out.operation=definition.kind=="craft" and "craft" or "buy"

    out.packageCategory=definition.kind=="collector" and "Collector" or definition.kind=="backpack" and "Backpack" or definition.kind=="accessory" and "Accessory" or nil

