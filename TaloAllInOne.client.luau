            end
            return
        elseif h.phase=="Waiting for teleport popup" or h.phase=="Waiting for teleport retry"then
            h.phase="Searching";retryAt=now+1;pendingHop=pendingHop or "Previous teleport failed"
        end
        if o.inputBlocked then
            if h.phase~="Waiting for input" then cancelJob();h.phase="Waiting for input"end
            h.message="Waiting for menu/text focus to clear; resumes automatically";return
        elseif h.phase=="Waiting for input"then h.phase="Searching";scanAt=now end
