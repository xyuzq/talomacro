function Macro.inspectStrawberryWalk()
    local _,_,root=character();if not root then return nil,"Living character required"end
    for _,busy in pairs(Macro.activity())do if busy then return nil,"Stop active work before the read-only inspection"end end
    local result={schemaVersion="talo.strawberry-inspection/1",readOnly=true,status="checking",capturedAtUnix=os.time(),
        runtimeVersion=Macro.version,start=packed(root.Position),placeVersion=game.PlaceVersion}
    telemetry.strawberryInspection=result
    local function plain(v,depth,seen)
        if finite(v)or type(v)=="boolean"then return v end
        if type(v)=="string"then return v:sub(1,2000)end
        if vector(v)then return packed(v)end
        if type(v)~="table"or depth>12 or seen[v]then return nil end
        seen[v]=true;local out,n={},0
        for k,item in pairs(v)do
            n=n+1;if n>4096 then break end
            if type(k)=="string"or finite(k)then out[k]=plain(item,depth+1,seen)end
        end
        seen[v]=nil;return out
    end
    local function save()
        result.canonical=plain(telemetry.canonical,0,{})
        if not writefile then return false,"writefile unavailable"end
        return pcall(function()writefile(filename("strawberry-walk-inspection.json"),HttpService:JSONEncode(result))end)
    end
    save()
    task.spawn(function()
        while result.status=="checking" and not closed do task.wait(.5);save()end
    end)
    local ok,route,cost,why,ready,diagnostics=pcall(function()
        return routeAtlas.plan(root.Position,Vector3.new(-320.60495,46.66157,270.04633),{},{},{walkOnly=true})
    end)
    result.status=ok and (route and "validated"or "rejected")or "error"
    result.reason=ok and why or tostring(route);result.estimatedSeconds=ok and cost or nil;result.ready=ok and ready or nil
    result.diagnostics=ok and plain(diagnostics,0,{})or nil;result.legs={}
    if ok then for _,leg in ipairs(route or {})do result.legs[#result.legs+1]={id=leg.id,kind=leg.kind,position=packed(leg.position)}end end
    local saved,err=save();result.saved=saved;result.saveError=not saved and tostring(err)or nil
    clientTools.saveSoon();print("Talo Strawberry walk inspection: "..result.status.." / "..tostring(result.reason))
    return result
end
