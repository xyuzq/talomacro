    if type(live)~="table" or live.accountId~=snapshot.accountId or live.placeVersion~=snapshot.placeVersion or not current(live.observedAt,now) or not key(live.source) then live=nil end

    local stats=type(snapshot.economy)=="table" and snapshot.economy.accountStats

    if type(stats)~="table" or stats.accountId~=snapshot.accountId or stats.placeVersion~=snapshot.placeVersion then stats=nil end

    out.requirements=EconomyCatalog.checkRequirements(quoted.requirements,stats,now)

    local owned

    if quoted.kind~="craft" then

        local ownershipFact=quoted.kind=="collector" and "gear.ownedCollectors"

            or quoted.kind=="accessory" and quoted.slot~="Container" and "gear.ownedAccessories" or "gear.ownedContainers"

