                        -- A second straight torso chord can disagree with the supported step contour.
                        local checkedGround=routeSource=="checked local walk" or routeSource=="live ground/collision graph" or routeSource=="checked transit corridor"
                        local connection = routeSource == "Roblox navmesh" and path.Blocked:Connect(function(blockedIndex)
