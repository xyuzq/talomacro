end)()

local Development=(function()
-- Parallel development projects and conservative material planning. No game APIs or spending.
local Development={}
local LIMIT=9007199254740991
local function finite(n)return type(n)=="number" and n==n and math.abs(n)<math.huge end
local function quantity(n)return finite(n) and n>=0 and n%1==0 and n<=LIMIT end
local function tableOf(t)return type(t)=="table" and t or {} end
