        job=nil;deps.release()
    end
    function h.stop(reason)
        cancelJob();h.active=false;h.phase="Off";h.message=reason or "Vicious hunt stopped"
        popupFailures,popupJoinFallback,modalJoin=0,false,nil
        if state then
            state.active=false;state.reason=h.message
