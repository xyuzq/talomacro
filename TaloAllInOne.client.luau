        if type(server)=="table" and type(server.id)=="string" and #server.id>0 and #server.id<100
            and server.id:match("^[%w%-]+$") and server.id~=current and type(server.playing)=="number"
            and type(server.maxPlayers)=="number" and server.playing%1==0 and server.playing>=1 and server.playing<=3 and server.playing<server.maxPlayers
            and (type(visited[server.id])~="number" or now-visited[server.id]>1800)then candidates[#candidates+1]=server end
    end
    table.sort(candidates,function(a,b)return a.id<b.id end)
    if #candidates==0 then return nil,"No eligible 1–3-player server"end
