        and state.active==true and state.userId==userId and state.placeId==placeId and state.pendingServer==jobId
        and type(state.resumeUntil)=="number" and state.resumeUntil>now and state.resumeUntil<=now+900
        and type(state.hops)=="number" and state.hops%1==0 and state.hops>=0
