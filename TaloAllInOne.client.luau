function Macro.setAutoSprinkler(on)clientTools.autoSprinkler=on~=false;return true end
function clientTools.placeSprinklers()
    local remote=child(child(Storage,"Events"),"PlayerActivesCommand")
    local stats=clientTools.freshStats()
    if not remote or type(stats)~="table"or type(stats.Eggs)~="table"or(stats.Eggs.SprinklerBuilder or 0)<1 then
        event("sprinkler",{placed=0,reason=remote and"Sprinkler Builder not owned"or"PlayerActivesCommand unavailable"});return
    end
    local count=clientTools.sprinklerCounts[stats.EquippedSprinkler]or 1
    local placed,field,lastUse=0,controller.field,-math.huge
    for i=1,count do
        if closed or controller.mode~="running"or controller.phase~="Preparing field"or controller.field~=field then break end
        if i>1 then
            -- Same-spot glitch: a further sprinkler only places while airborne. Land first, then jump and use it near the apex.
            local model,h=character();if not h then break end
            local landUntil=os.clock()+1.5
            while os.clock()<landUntil and h.FloorMaterial==Enum.Material.Air do task.wait(.03)end
            -- Captured EggTypes SprinklerBuilder UseCooldown is 1 s; a use inside it is silently ignored (native v0.14.37).
            while os.clock()-lastUse<1.25 do task.wait(.03)end
            h:Move(Vector3.new(0,0,0),false);h.Jump=true
            local untilTime=os.clock()+.8
            while os.clock()<untilTime and h.FloorMaterial~=Enum.Material.Air do task.wait(.03)end
            -- Apex: wait while still rising (vertical velocity above 1 stud/s), at most 0.6 s.
            local root=child(model,"HumanoidRootPart");local apexBy=os.clock()+.6
            repeat task.wait(.03);local v=get(root,"AssemblyLinearVelocity")until os.clock()>=apexBy or not v or v.Y<=1
        end
        local ok=pcall(function()
            if remote:IsA("RemoteFunction")then remote:InvokeServer({Name="Sprinkler Builder"})else remote:FireServer({Name="Sprinkler Builder"})end
        end)
        if ok then placed=placed+1 end
        lastUse=os.clock()
    end
    -- Hand over to gathering only after landing, so the field walk never starts mid-air.
    local _,h=character();local landBy=os.clock()+1.5
    while h and os.clock()<landBy and h.FloorMaterial==Enum.Material.Air do task.wait(.03)end
    event("sprinkler",{placed=placed,count=count,type=stats.EquippedSprinkler,field=field})
end
