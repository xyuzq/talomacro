-- The caller owns switch windows and deviation tolerances; negative progress remains observable.
function motion.cannonProgress(mount,shoot,force,gravity,current)
    local function finite(n)return type(n)=="number"and n==n and math.abs(n)<math.huge end
    if not finite(force)or force<=0 then return nil,nil,nil,"INVALID_FORCE"end
    if not finite(gravity)or gravity<=0 then return nil,nil,nil,"INVALID_GRAVITY"end
    local ok,mx,my,mz,sx,sy,sz,cx,cy,cz=pcall(function()
        return mount.X,mount.Y,mount.Z,shoot.X,shoot.Y,shoot.Z,current.X,current.Y,current.Z
    end)
