            and finite(value.observedAt) and value.observedAt<=now and now-value.observedAt<=15
    end
    local function main()
        local m=d.macro()
        if type(m)~="table" then return nil,"Load the main Talo macro before starting progression" end
        for _,method in ipairs({"progressionCapabilities","progressionObserve","progressionStart","progressionPoll","progressionCancel"}) do
            if type(m[method])~="function" then return nil,"Reload the main macro: its progression bridge is unavailable" end
        end
