                    for name in path:gmatch("[^.]+")do current=current and current:FindFirstChild(name)end
                    return current
                end
                add(find(d.storage,"Collectors.LocalCollect"),"collector_input",5,true)
                for _,path in ipairs({"Gui.EggMenu","Gui.QuantityBox","Gui.DragManager","CellTools","EggTypes","BeeStats","BeeStats.BeeMutations","Beequips.BeequipFile","HoneycombTools","ClientSessionManager.ClientGuiManager"})do
                    add(find(d.storage,path),"feeding",10,true)
                end
                add(find(d.storage,"Parachutes"),"core",20,true)
                add(find(d.storage,"NPCs"),"core",20,true)
                local pg=d.player:FindFirstChild("PlayerGui")
                local camera=pg and pg:FindFirstChild("Camera")
                local controls=camera and camera:FindFirstChild("Controllers")
                add(controls and controls:FindFirstChild("NPC"),"core",20,true)
                for _,path in ipairs({"MonsterTypes","StatModifiers","OsTime","TimeString","ClientScripts.MonsterTimers","ClientMonsterTools"})do add(find(d.storage,path),"timers",22,true)end
                local activatables=d.storage:FindFirstChild("Activatables")
