local function current(at,now)return finite(at) and at>=0 and at<=now and now-at<=15 end

local function fact(snapshot,name,now)

    local f=type(snapshot.facts)=="table" and snapshot.facts[name]

    if type(f)=="table" and (f.status=="observed" or f.status=="derived" and f.validated==true) and key(f.source)

        and f.coverage~=nil and f.coverage~=false and f.coverage~="truncated" and current(f.observedAt,now) then return f.value end

end

local function equal(a,b)

    if type(a)~="table" or type(b)~="table" then return false end

    for k,v in pairs(a)do if b[k]~=v then return false end end

    for k,v in pairs(b)do if a[k]~=v then return false end end

