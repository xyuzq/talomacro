    for _,m in ipairs(monsters or {}) do
        local p=m.position
        if math.abs(a.Y-p.Y)<14 or math.abs(b.Y-p.Y)<14 then
            local r=m.radius+(margin or 0)
            local t=len2>0 and math.max(0,math.min(1,((p.X-a.X)*dx+(p.Z-a.Z)*dz)/len2)) or 0
