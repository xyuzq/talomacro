        end
    end
    function h.snapshot()return {active=h.active,phase=h.phase,message=h.message,target=h.target,state=state,
        popupRecovery={failures=popupFailures,joinFallback=popupJoinFallback,joinInFlight=modalJoin~=nil}}end
    return h
end

end)()

local makeFieldDensity = (function()
-- Spatial index of observed flower geometry; no inferred inventory/pollen amounts.
return function(cellSize)
    local index={cells={},count=0,complete=false}
    local size=cellSize or 8
    local function key(x,z)return math.floor(x/size)..":"..math.floor(z/size)end
    function index.add(x,z,ref)
        local id=key(x,z);index.cells[id]=index.cells[id] or {}
        index.cells[id][#index.cells[id]+1]={x=x,z=z,ref=ref};index.count=index.count+1
    end
    function index.density(x,z,active,radius)
        local r,total=radius or 10,0
        for ix=math.floor((x-r)/size),math.floor((x+r)/size)do
            for iz=math.floor((z-r)/size),math.floor((z+r)/size)do
                for _,p in ipairs(index.cells[ix..":"..iz] or {})do
                    if (x-p.x)^2+(z-p.z)^2<=r*r then
                        local value=not active or active(p.ref)
                        total=total+(type(value)=="number" and math.max(0,math.min(1,value)) or value and 1 or 0)
                    end
                end
            end
        end
        return total
    end
    function index.anchor(width,depth,active,safe,previous)
        local best,bestScore=nil,-math.huge
        local function consider(x,z)
            if not safe or safe(x,z)then
                local count=index.density(x,z,active)
                if count==0 and index.complete and index.count>0 then return end
                local score=math.sqrt(count)-math.sqrt((x/width)^2+(z/depth)^2)*2.5
                if score>bestScore or score==bestScore and (not best or x*x+z*z<best.x*best.x+best.z*best.z)then best,bestScore={x=x,z=z},score end
            end
        end
        for ix=-1,1 do for iz=-1,1 do consider(ix*width*0.12,iz*depth*0.12) end end
        if previous then consider(previous.x,previous.z)end
        -- Actual flower-cell centres cover gaps missed by a fixed nine-point grid.
        local candidates={}
        for id,cell in pairs(index.cells)do candidates[#candidates+1]={id=id,cell=cell}end
        table.sort(candidates,function(a,b)return a.id<b.id end)
        for i,entry in ipairs(candidates)do
            if i>256 then break end
            local p=entry.cell[1]
            if math.abs(p.x)<width*0.22 and math.abs(p.z)<depth*0.22 then consider(p.x,p.z)end
        end
        if not best then for _,entry in ipairs(candidates)do local p=entry.cell[1];if math.abs(p.x)<width*0.4 and math.abs(p.z)<depth*0.4 then consider(p.x,p.z)end end end
        if best and previous and (not safe or safe(previous.x,previous.z))then
            local old=index.density(previous.x,previous.z,active)
            if old>0 and index.density(best.x,best.z,active)<old*1.3 then return previous end
        end
        return best
    end
    return index
end

end)()

local makeGlider = (function()
-- Uses Space and normal movement only; landings must be observed, never teleported.
return function(deps)
    local glider={models={}}
    local function modelKey(gear,h)
        return tostring(gear)..":"..math.floor((deps.gravity and deps.gravity() or 196.2)/5)..":"..math.floor((h and h.WalkSpeed or 20)/5)
    end
    function glider.range(gear)
        local _,h=deps.character()
        local model=glider.models[modelKey(gear,h)]
        -- The glider is a fixed BodyVelocity (Glider 70 forward, 24 down), so the measured ratio is exact; 10% covers turning and arrival.
        if model and type(model.ratio)=="number" and model.samples>=8 then return math.max(0.2,math.min(12,model.ratio*0.9)),"measured stable glide, 10% range margin",model.horizontal,model.horizontal/model.ratio end
