    local actions={claim_hive=true,gather=true,convert=true,farm_cycle=true,quest_dialogue=true,dispenser_collect=true,mob_defeat=true,
        planter_collect=true,planter_plant=true,economy=true,shop_buy=true,craft=true,feed_treats=true,hatch_egg=true,buy_slot=true}
    local function finite(value)return type(value)=="number" and value==value and math.abs(value)<math.huge end
    local function copy(value,depth,budget)
        if type(value)=="string" then return value:sub(1,1000) end
        if type(value)=="boolean" or finite(value) then return value end
        if type(value)~="table" or depth>8 then return nil end
        local out={}
        for key,item in pairs(value) do
            budget.count=budget.count+1;if budget.count>12000 then break end
