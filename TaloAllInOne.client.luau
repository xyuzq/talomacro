    local function compatible(index,candidate)
        if not index or index.placeId and index.placeId~=d.placeId or index.placeVersion and index.placeVersion~=d.placeVersion then return false end
        if candidate.fingerprint==index.geometryFingerprint then return true end
        return type(candidate.navigationFingerprint)=="string"and candidate.navigationFingerprint:match("^nav2:adler32:%x%x%x%x%x%x%x%x$")~=nil
            and candidate.navigationFingerprint==index.navigationFingerprint
    end
    local function validate(edge,a,b,c)
        if c.onValidation then c.onValidation(edge)end
        if not c.cancelled or c.cancelled()then return false,"Canonical validation time/context expired"end
        if edge.kind=="climb"then
            local seconds=modelTime(edge,a,b,c)
            if not seconds or not d.climb or type(d.climb.validate)~="function"then return false,"Observed climb profile or validator unavailable"end
            local ok,why=d.climb.validate(edge.climb,c.cancelled)
            if not ok then return false,"Observed climb geometry rejected: "..tostring(why)end
            return true,{seconds=seconds,modelStatus="manual trace with live contact checks"}
        elseif edge.kind=="cannon"then
            if not liveCannonMatches(edge,c,true)then return false,"Live cannon parameters differ from captured source model"end
            local seconds=modelTime(edge,a,b,c)
            if not seconds then return false,"Cannon requirements, cooldown or physics are unavailable"end
            if not d.clearBody then return false,"Cannon body-corridor validator unavailable"end
            local physics=edge.physics or{}
            local mount,shoot=vector(physics.mount),vector(physics.shootAt)
            local velocity=(shoot-mount).Unit*physics.force
            local flight=physics.mode=="cannon_glide"and physics.ballisticSeconds or physics.flightSeconds
            if not finite(flight)or flight<=0 or flight>8 then return false,"Source cannon trajectory duration unavailable"end
            local previous=mount
            for i=1,math.ceil(flight/0.1)do
                if c.cancelled()then return false,"Canonical validation time/context expired"end
                local t=math.min(flight,i*0.1)
                local point=mount+velocity*t-Vector3.new(0,0.5*c.gravity*t*t,0)
                if not d.clearBody(previous,point)then return false,"Source cannon flight corridor is obstructed"end
                previous=point
            end
            if physics.mode=="cannon_glide"then
                local switch=vector(physics.switchPosition)
                local gear=c.gear.Glider and"Glider"or c.gear.Parachute and"Parachute"
                if not switch or(previous-switch).Magnitude>1 or not d.glider.eligible(previous,b,gear)then return false,"Source cannon/glide switch is outside the current flight envelope"end
                local _,_,speed,sink=d.glider.range(gear)
                local flat=Vector3.new(b.X-previous.X,0,b.Z-previous.Z)
                local hold=Vector3.new(b.X,previous.Y-flat.Magnitude/speed*sink,b.Z)
                if hold.Y<b.Y or not d.clearBody(previous,hold)or not d.clearBody(hold,b)then return false,"Cannon glide/landing corridor is obstructed"end
            elseif(previous-b).Magnitude>20 then return false,"Observed landing has no matching source ballistic trajectory"end
            local landing=d.surfacePath(b,b,c.cancelled,1,true)
            if not landing then return false,"Cannon landing has no checked support"end
            return true,{input="E",seconds=seconds,modelStatus="source"}
        elseif edge.kind=="glide"then
            local launch,landing=vector(edge.launch)or a,vector(edge.landing)or b
            local seconds=modelTime(edge,a,b,c)
            if not seconds then return false,"Current gear cannot reach the canonical glide landing"end
            if not d.surfacePath(launch,launch,c.cancelled,1,true)or not d.surfacePath(landing,landing,c.cancelled,1,true)then return false,"Glide takeoff/landing lacks checked support"end
            if edge.physics and edge.physics.mode=="jump_glide"then
                if not d.clearBody then return false,"Jump-glide body validator unavailable"end
                local runup=vector(edge.physics.runup)
                if not runup or not d.surfacePath(runup,launch,c.cancelled,1,true)then return false,"Jump-glide run-up has no checked acceleration corridor"end
                local apex,velocity,time=jumpApex(launch,landing,c,edge.physics.jumpSeconds)
                local flat=Vector3.new(landing.X-launch.X,0,landing.Z-launch.Z).Unit
                local previous=launch
                for i=1,6 do
                    local t=time*i/6
                    local point=launch+flat*math.min((Vector3.new(apex.X-launch.X,0,apex.Z-launch.Z)).Magnitude,c.walkSpeed*t)+Vector3.new(0,velocity*t-0.5*c.gravity*t*t,0)
                    if not d.clearBody(previous,point)then return false,"Jump-glide launch arc is obstructed"end
                    previous=point
                end
                if not d.clearBody(apex,landing)then return false,"Jump-glide landing corridor is obstructed"end
            end
            return true,{seconds=seconds,modelStatus="source"}
        end
        local points={{Position=a,Action=Enum.PathWaypointAction.Walk}}
        if not edge.points or #edge.points==0 then
            if edge.kind=="jump"then
                local checked,failure=checkedSegment(a,a,b,"Jump",c)
                if not checked then return false,failure end
                return true,{points=checked,seconds=pathSeconds(checked,c)}
            end
            local checked=d.surfacePath(a,b,c.cancelled,1,false)
            if not checked then return false,"No local connection to the canonical road"end
