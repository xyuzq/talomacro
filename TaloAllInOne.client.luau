            if not grid or seen[grid] or not identifier(b.type) or b.status~="matching" or b.previewEligible~=true then complete=false end

            if grid then seen[grid]=true end

            bees[#bees+1]={x=b.x,y=b.y,type=b.type,level=whole(b.level) and b.level>=1 and b.level or nil,

                gifted=type(b.gifted)=="boolean" and b.gifted or nil,mutation=b.mutation,beequip=b.beequip}

