            local candidate={id=id,action=action,goalId=goalId,priority=priority,field=field,reason=reason,score=score or 0,
                requiredCapability=action,capability=type(capability)=="table" and capability.status or "unknown",
                executable=false,proposalOnly=true,blockedReasons=blocked}
            if bestField and field==bestField.name and (action=="gather" or action=="travel") then
                candidate.secondaryProjects=copy(bestField.secondaryProjects or {})
