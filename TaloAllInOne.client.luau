            local flightStart,jumpTime=launch,0
            if edge.physics and edge.physics.mode=="jump_glide"then
                if not vector(edge.physics.runup)then return end
                local apex,_,time=jumpApex(launch,landing,c,edge.physics.jumpSeconds)
                if not apex then return end
                flightStart,jumpTime=apex,time
            end
            if not gear or not d.glider.eligible(flightStart,landing,gear,edge.physics and{mode=edge.physics.mode}or nil)then return end
            local _,_,speed,sink=d.glider.range(gear)
            local delta=landing-flightStart
            local flight=jumpTime+math.max(math.sqrt(delta.X^2+delta.Z^2)/speed,math.max(0,flightStart.Y-landing.Y)/(sink or(gear=="Glider"and 24 or 14)))
            local runup=vector(physics.runup)
            local approach=runup and((a-runup).Magnitude+(runup-launch).Magnitude)or(a-launch).Magnitude
            return approach/c.walkSpeed+flight+(landing-b).Magnitude/c.walkSpeed+1.5
        end
