                h.message=tostring(reason);retryAt=now+4
                if status~="success"then pendingHop=tostring(reason)end
            elseif status~="success"then
                h.message=tostring(reason);failures=failures+1;retryAt=now+5
                retryAt=now+math.min(60,5*failures)
                if h.phase=="Claiming hive"then pendingHop="No claimable hive: "..tostring(reason)end
            end
            h.phase,scanAt="Searching",now
