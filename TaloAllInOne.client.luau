        end

    end

    -- Complete inventory/hive evidence comes from a fresh cache of this account.

    local cacheBound=c.cacheAccountMatched==true and type(cache.Honeycomb)=="table" and finite(cacheAt)

    local cacheCount=0

    if cacheBound then

        for x,col in pairs(cache.Honeycomb) do

            if type(x)~="string" or not x:match("^x[1-5]$") or type(col)~="table" then cacheBound=false;break end

            for y in pairs(col) do if type(y)~="string" or not y:match("^y[1-9]$") and y~="y10" then cacheBound=false;break end end

        end

        for x=1,5 do

            local col=cache.Honeycomb["x"..x]

            if col~=nil and type(col)~="table" then cacheBound=false;break end

            for y=1,10 do

                local cell=tableOf(col)["y"..y]

                if cell~=nil then

                    if type(cell)~="table" or type(cell.Type)~="string" then cacheBound=false;break end

                    if cell.Type~="Empty" and cell.Type~="" then cacheCount=cacheCount+1 end

                end

            end

        end

    end

    complete=complete and cacheBound and cacheCount==#bees

    if complete then

        for _,bee in ipairs(bees) do

