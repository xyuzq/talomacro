    if not isA(remote, "RemoteEvent") then return false, "Exact Events.PlayerHiveCommand RemoteEvent unavailable" end
    capabilities.hiveCommand = "candidate call; checked against live caption, Owner and proximity"
    return pcall(function() remote:FireServer("ToggleHoneyMaking") end)
end
local function ground(position, zone)
