local flowerSignal = (function()
-- Exposed height and observed recovery are proxies; flower names never establish pollen/level.
local signal={}
function signal.score(localY,height,floorY,peak,explicitPollen)
    local top=localY+height/2
    local exposed=type(floorY)=="number" and math.max(0,top-floorY) or nil
    local high=math.max(peak or top,top)
    if type(explicitPollen)=="number"then return explicitPollen>0 and 1 or 0,high,exposed,"explicit Pollen"end
    if height<0.12 or exposed and exposed<0.06 then return 0,high,exposed,"exposed height"end
    local score=exposed and exposed/math.max(0.3,high-floorY) or 1-(high-top)/math.max(0.3,height)
    return math.max(0,math.min(1,score)),high,exposed,exposed and "exposed height" or "observed top change; soil unknown"
end
return signal

end)()

local makeTransitGeometry = (function()
-- Discovers ramp/path/terrain tops; every emitted waypoint is projected onto its exact live source.
return function(d)
    local candidates,at,busy,shopFloors={},-math.huge,false,{}
    local ids,serial=setmetatable({},{__mode="k"}),0
    local namedExclusions=setmetatable({},{__mode="k"})
    local function bounds(part)
        local p,s,cf=part.Position,part.Size,part.CFrame
        local r,u,l=cf.RightVector or Vector3.new(1,0,0),cf.UpVector or Vector3.new(0,1,0),cf.LookVector or Vector3.new(0,0,1)
        local x=(math.abs(r.X)*s.X+math.abs(u.X)*s.Y+math.abs(l.X)*s.Z)/2
        local y=(math.abs(r.Y)*s.X+math.abs(u.Y)*s.Y+math.abs(l.Y)*s.Z)/2
        local z=(math.abs(r.Z)*s.X+math.abs(u.Z)*s.Y+math.abs(l.Z)*s.Z)/2
        return {minX=p.X-x,maxX=p.X+x,minZ=p.Z-z,maxZ=p.Z+z,top=p.Y+y}
    end
    local function excludedSupport(part,p)
        local cached=part and namedExclusions[part]
        if not cached or cached.parent~=part.Parent then
            local parent,excluded=part,false
            for _=1,32 do
                if not parent or not parent.Name then break end
                local name=parent.Name:lower()
                if name:find("shop",1,true) or name:find("ticket",1,true) or name:find("roof",1,true) or name:find("fence",1,true) or name:find("rail",1,true)
                    or name:find("column",1,true) or name:find("pillar",1,true) or name:find("support post",1,true)then excluded=true;break end
                parent=parent.Parent
            end
            cached={parent=part and part.Parent,excluded=excluded}
            if part then namedExclusions[part]=cached end
        end
        if cached.excluded then return true end
        if p then
            for _,floor in ipairs(shopFloors)do
                local b=floor.bounds
                if p.X>=b.minX-2 and p.X<=b.maxX+2 and p.Z>=b.minZ-2 and p.Z<=b.maxZ+2 and p.Y>=b.top-1 and p.Y<=b.top+20 then return true end
            end
        end
        return false
    end
    local function corridorDistance(start,delta,b)
        local lo,hi=0,1
        for _,axis in ipairs({{"X","minX","maxX"},{"Z","minZ","maxZ"}})do
            local a,q=start[axis[1]],delta[axis[1]]
            if math.abs(q)<0.001 then if a<b[axis[2]] or a>b[axis[3]]then hi=-1;break end
            else
                local x,y=(b[axis[2]]-a)/q,(b[axis[3]]-a)/q
                if x>y then x,y=y,x end;lo,hi=math.max(lo,x),math.min(hi,y)
                if lo>hi then break end
            end
        end
        if lo<=hi then return 0,(lo+hi)/2 end
        local best,progress=math.huge,0
        local len2=delta.X*delta.X+delta.Z*delta.Z
        local function measure(x,z)
            local t=len2>0 and math.max(0,math.min(1,((x-start.X)*delta.X+(z-start.Z)*delta.Z)/len2))or 0
            local dx,dz=x-start.X-t*delta.X,z-start.Z-t*delta.Z
            local distance=math.sqrt(dx*dx+dz*dz)
            if distance<best then best,progress=distance,t end
        end
        for _,x in ipairs({b.minX,b.maxX})do for _,z in ipairs({b.minZ,b.maxZ})do measure(x,z)end end
        for _,t in ipairs({0,1})do
            local x,z=start.X+delta.X*t,start.Z+delta.Z*t
            measure(math.max(b.minX,math.min(b.maxX,x)),math.max(b.minZ,math.min(b.maxZ,z)))
        end
        return best,progress
    end
    local function refresh()
        if busy or d.now()-at<15 then return end
        at,busy=d.now(),true
        d.spawn(function()
            local found,scanned={},0
            namedExclusions=setmetatable({},{__mode="k"})
            shopFloors={}
            local shops=d.world:FindFirstChild("Shops")
            local ticket=shops and shops:FindFirstChild("TicketShop")
            local reference=ticket and ticket:FindFirstChild("Floor")
            local floor=reference and reference:IsA("ObjectValue") and reference.Value
            if floor and floor:IsA("BasePart") and d.vector(floor.Size) and d.vector(floor.Position)then shopFloors[1]={part=floor,bounds=bounds(floor)}end
            for _,name in ipairs({"Paths","Map","Platforms"})do
                local root=d.world:FindFirstChild(name)
                for _,part in ipairs(root and root:GetDescendants() or {})do
                    scanned=scanned+1
                    if scanned>12000 then break end
                    if part:IsA("BasePart") and part.CanCollide and d.vector(part.Position) and d.vector(part.Size)then
                        local s=part.Size;local longest,shortest=math.max(s.X,s.Z),math.min(s.X,s.Z)
                        local label=part.Name:lower();local up=part.CFrame.UpVector
                        local roof=excludedSupport(part)
                        local ramp=part:IsA("WedgePart") or label:find("ramp",1,true) or label:find("stair",1,true)
                            or label:find("step",1,true) or up and math.abs(up.Y)>0.45 and math.abs(up.Y)<0.98
                        -- Thickness is not a rise to climb: a broad solid block can have a useful upper road.
                        local terrace=name~="Paths" and up and up.Y>=0.98 and shortest>=8 and longest>=18
                            and not(s.Y>math.max(40,longest*1.5) and shortest<64)
                        if not roof and longest>=5 and shortest>=3 and longest<=1024 and (ramp or name=="Paths" or terrace)then
                            if not ids[part]then serial=serial+1;ids[part]=serial end
                            local b=bounds(part);b.partId=ids[part]
                            found[#found+1]={part=part,id=ids[part],ramp=ramp and true or false,terrain=name~="Paths",root=name,bounds=b,
                                stable=string.format("%s:%s:%.3f:%.3f:%.3f:%.3f:%.3f:%.3f",name,label,part.Position.X,part.Position.Y,part.Position.Z,s.X,s.Y,s.Z)}
                        end
                    end
                    if scanned%300==0 then d.yield()end
                end
                if scanned>12000 then break end
            end
            candidates,busy=found,false
            local geometry={}
            if d.describe then for i,item in ipairs(found)do
                if i>300 then break end
                local row=d.describe(item.part,item.id,item.root,item.ramp)
                if item.part.GetFullName then row.path=item.part:GetFullName()end
                geometry[#geometry+1]=row
            end end
            d.telemetry.transitMap={parts=#found,scanned=scanned,capped=scanned>12000,geometry=geometry,shopFloorExclusions=#shopFloors}
        end)
    end
    function d.nodes(start,goal)
        refresh()
        local waitUntil=d.now()+1
        while busy and #candidates==0 and d.now()<waitUntil do d.yield()end
        local ranked={};local delta=goal-start
        for _,item in ipairs(candidates)do
            local b=item.bounds
            local corridor,t=corridorDistance(start,delta,b)
            if item.part.Parent and corridor<(item.ramp and 210 or 110) and b.top>math.min(start.Y,goal.Y)-25 and b.top<math.max(start.Y,goal.Y)+(item.ramp and 70 or 32)then
                ranked[#ranked+1]={item=item,t=t,score=corridor+math.abs(b.top-(start.Y+delta.Y*t))*0.2+(item.ramp and -35 or item.root=="Paths" and -12 or 0)}
            end
        end
        local function rank(a,b)return a.score<b.score or a.score==b.score and a.item.stable<b.item.stable end
        table.sort(ranked,rank)
        local selected,chosen,bands={},{},{}
        local reserved=0
        for _,entry in ipairs(ranked)do
            if entry.item.terrain and not entry.item.ramp and reserved<24 then
                local key=math.floor((entry.item.bounds.top-math.min(start.Y,goal.Y))/12)..":"..math.floor(entry.t*6)
                if not bands[key]then bands[key]=true;selected[#selected+1]=entry;chosen[entry.item]=true;reserved=reserved+1 end
            end
        end
        for _,entry in ipairs(ranked)do
            if #selected>=48 then break end
            if not chosen[entry.item]then selected[#selected+1]=entry;chosen[entry.item]=true end
        end
        table.sort(selected,rank)
        local nodes,seen,rows={},{},{}
        for _,entry in ipairs(selected)do
            local item=entry.item;local part=item.part
            local probes={{0,0,"centre"},{-0.43,0,"X-"},{0.43,0,"X+"},{0,-0.43,"Z-"},{0,0.43,"Z+"}}
            if not item.ramp and part.CFrame.PointToObjectSpace then
                for i,target in ipairs({start,goal})do
                    local p=part.CFrame:PointToObjectSpace(target)
                    probes[#probes+1]={math.max(-0.43,math.min(0.43,p.X/part.Size.X)),math.max(-0.43,math.min(0.43,p.Z/part.Size.Z)),i==1 and "entry" or "exit"}
                end
            end
            for _,probe in ipairs(probes)do
                local localPoint=Vector3.new(part.Size.X*probe[1],part.Size.Y/2,part.Size.Z*probe[2])
                local p=d.project(part.CFrame:PointToWorldSpace(localPoint),part)
                if p and not excludedSupport(part,p) and d.allowed(p)then
                    local key=math.floor(p.X/5)..":"..math.floor(p.Y/4)..":"..math.floor(p.Z/5)
                    if not seen[key]then
                        seen[key]=true
                        local id="surface:"..item.id..":"..probe[3]
                        nodes[id]={position=p,surface=item.id,ramp=item.ramp,terrain=item.terrain,sourceBounds=item.bounds}
                        rows[#rows+1]={name=part.Name,root=item.root,x=p.X,y=p.Y,z=p.Z,ramp=item.ramp,terrain=item.terrain,sourceBounds=item.bounds}
                    end
                end
            end
        end
        d.telemetry.transitSurfaces=rows
        d.telemetry.transitSelection={ranked=#ranked,selected=#selected,cap=48,reservedTerraces=reserved}
        return nodes
    end
    return {nodes=d.nodes,excludedSupport=excludedSupport}
end

end)()

local serverHop = (function()
-- Public server selection and account/place-bound resume validation; no HTTP side effects here.
local hop={}
function hop.select(page,current,visited,now,choose)
    if type(page)~="table" or type(page.data)~="table"then return nil,"Malformed server page"end
    local candidates={}
    for i,server in ipairs(page.data)do
        if i>100 then break end
        if type(server)=="table" and type(server.id)=="string" and #server.id>0 and #server.id<100
            and server.id:match("^[%w%-]+$") and server.id~=current and type(server.playing)=="number"
            and type(server.maxPlayers)=="number" and server.playing%1==0 and server.playing>=1 and server.playing<=3 and server.playing<server.maxPlayers
            and (type(visited[server.id])~="number" or now-visited[server.id]>1800)then candidates[#candidates+1]=server end
    end
    table.sort(candidates,function(a,b)return a.id<b.id end)
    if #candidates==0 then return nil,"No eligible 1–3-player server"end
    local index=#candidates>0 and (choose or math.random)(1,#candidates)
    return index and candidates[index] and candidates[index].id,nil
end
function hop.valid(state,userId,placeId,jobId,now)
    return type(state)=="table" and state.schemaVersion=="talo.hunt/2" and state.sourceVersion=="0.13.1"
        and state.active==true and state.userId==userId and state.placeId==placeId and state.pendingServer==jobId
        and type(state.resumeUntil)=="number" and state.resumeUntil>now and state.resumeUntil<=now+900
        and type(state.hops)=="number" and state.hops%1==0 and state.hops>=0
        and (state.maxLevel==nil or type(state.maxLevel)=="number" and state.maxLevel%1==0 and state.maxLevel>=1)
        and type(state.visited)=="table"
end
function hop.loader(checkpointPath,sourcePath)
    return string.format([=[
local ok,err=pcall(function()
 local untilTime=os.clock()+90
 local players=game:GetService("Players")
 while (not game:IsLoaded() or not players.LocalPlayer) and os.clock()<untilTime do task.wait(0.2)end
 if not players.LocalPlayer or game.PlaceId~=1537690962 or game.PlaceVersion~=1993 then return end
 local raw=readfile(%q);if type(raw)~="string" or #raw>32768 then return end
 local state=game:GetService("HttpService"):JSONDecode(raw)
 if state.schemaVersion~="talo.hunt/2" or state.sourceVersion~="0.13.1" or not state.active
  or state.userId~=players.LocalPlayer.UserId or state.placeId~=game.PlaceId or state.pendingServer~=game.JobId
  or type(state.resumeUntil)~="number" or state.resumeUntil<=os.time() or state.resumeUntil>os.time()+900 then return end
 local settingOK,stopped=pcall(function()return game:GetService("TeleportService"):GetTeleportSetting("TaloHuntStopped")end)
 if settingOK and stopped==state.started then return end
 local env=getgenv();local key=tostring(state.started)..":"..game.JobId
 if env.TaloResumeConsumed==key then return end
 local source=readfile(%q);if type(source)~="string" or #source>8000000 or not source:find("Talo runtime requires the Bee Swarm client",1,true)then return end
 local chunk,why=loadstring(source,"@TaloMacro.autoload");if not chunk then error(why)end
 env.TaloResumeConsumed=key;env.TaloHuntResume=state;chunk()
end)
if not ok then warn("Talo autoload: "..tostring(err))end
]=],checkpointPath,sourcePath)
end
return hop

end)()

local makeViciousHunt = (function()
-- Continuous night/hunt/hop scheduler. Individual actions time out; only user controls stop hunting.
return function(deps)
    local h={active=false,phase="Off",message="Vicious hunt off"}
    local state,job,nightSince,loadedAt,scanAt,retryAt,failures,generation,pendingHop
    local popupFailures,popupJoinFallback,modalJoin=0,false,nil
    local function save()if state then return deps.save(state)end end
    local function cancelJob()
        generation=(generation or 0)+1
        if job and job.cancel then job.cancel()end
        job=nil;deps.release()
    end
    function h.stop(reason)
        cancelJob();h.active=false;h.phase="Off";h.message=reason or "Vicious hunt stopped"
        popupFailures,popupJoinFallback,modalJoin=0,false,nil
        if state then
            state.active=false;state.reason=h.message
            local saved,why=save();if saved==false then h.message=h.message.." | Checkpoint write failed: "..tostring(why)end
        end
