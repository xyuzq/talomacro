    function h.start(options,resume)
        cancelJob()
        local now=deps.unix()
        state=resume or {schemaVersion="talo.hunt/2",sourceVersion="0.13.1",userId=deps.userId,placeId=deps.placeId,
            started=now,hops=0,visited={},maxLevel=options and options.maxLevel,kills=0}
        state.active,state.pendingServer=true,nil
        h.active,h.phase,h.message=true,"Loading","Waiting for the character and hive to load"
        nightSince,loadedAt,scanAt,retryAt,failures,pendingHop=nil,nil,nil,nil,0,nil
        popupFailures,popupJoinFallback,modalJoin=0,false,nil
        local saved,why=save()
        if saved==false then h.active=false;state.active=false;h.phase="Off";h.message="Checkpoint unavailable: "..tostring(why);return false,h.message end
