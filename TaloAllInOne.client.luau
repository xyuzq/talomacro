                if not options.force and not glider.eligible(part.Position,goal,gear,options)then return finish(false,"Cannon glide deployment window left the reachable envelope",part)end
                if deps.clear and not deps.clear(part.Position,goal)then return finish(false,"Cannon glide recovery corridor blocked; no second input",part)end
                record.deploymentRecoveryAttempted=true
                record.deploymentRecoveryReason="No stable glide response after the first Space input"
                local ok,reason=(deps.open or deps.space)(cancelled)
                if not ok then return finish(false,reason,part)end
                record.deploymentInputPulses=record.deploymentInputPulses+1;record.inputPulses=record.inputPulses+1
                deps.sleep(.02)
            end
        end
        transition("deployment_requested","Space input delivered; controller opening is not yet observed",root)
        while deps.now()-started<25 and valid()do
            local _,humanoid,part=deps.character()
            local delta=goal-part.Position
            local horizontal=math.sqrt(delta.X*delta.X+delta.Z*delta.Z)
            record.apexY=math.max(record.apexY,part.Position.Y)
            local velocity=part.AssemblyLinearVelocity
            if deps.now()-capturedAt>=(short and 0.03 or 0.15) and velocity and(deployed or record.descentClose)and deps.airborne(humanoid)then
                capturedAt=deps.now()
                local speed=math.sqrt(velocity.X^2+velocity.Z^2)
                if #record.samples<100 then record.samples[#record.samples+1]={t=deps.now()-started,x=part.Position.X,y=part.Position.Y,z=part.Position.Z,
