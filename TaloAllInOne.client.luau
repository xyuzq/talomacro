  or state.userId~=players.LocalPlayer.UserId or state.placeId~=game.PlaceId or state.pendingServer~=game.JobId
  or type(state.resumeUntil)~="number" or state.resumeUntil<=os.time() or state.resumeUntil>os.time()+900 then return end
