function clientTools.shopZone(operation)
    local item=clientTools.shopItems[operation]or operation -- An operation, or a shop item name for gear.
    for _,shop in ipairs(item and child(Workspace,"Shops")and child(Workspace,"Shops"):GetChildren()or{})do
        if child(child(shop,"Items"),item)then
            local floor=child(shop,"Floor");floor=isA(floor,"ObjectValue")and floor.Value or nil
            if isA(floor,"BasePart")then return floor,"floor"end
            local terrain=child(shop,"Terrain");if isA(terrain,"ObjectValue")then terrain=terrain.Value end
            if isA(terrain,"BasePart")then return terrain,"terrain"end
        end
    end
