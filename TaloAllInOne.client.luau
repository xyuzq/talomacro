        if b.gifted==true then giftedTypes[b.type]=(giftedTypes[b.type] or 0)+1 elseif b.gifted~=false then out.giftedUnknown=out.giftedUnknown+1 end
        if finite(b.level) and b.level>=1 and b.level%1==0 then out.minimumLevel=math.min(out.minimumLevel or b.level,b.level)
        else out.levelUnknown=true end
        local definition=type(catalog.bees)=="table" and catalog.bees[b.type]
        local guaranteed,possible={},{}
        if type(definition)~="table" then allKnown=false
        else
            out.colorCounts[definition.color]=(out.colorCounts[definition.color] or 0)+1
            for _,ability in ipairs(definition.abilities or {}) do
                local role=roleMap[ability.name]
                if role then
                    if ability.giftedOnly~=true or b.gifted==true then guaranteed[role]=true
                    elseif b.gifted~=false then possible[role]=true end
                end
            end
        end
        for role in pairs(guaranteed) do out.roleCounts[role]=(out.roleCounts[role] or 0)+1;possible[role]=nil end
        for role in pairs(possible) do out.possibleRoleCounts[role]=(out.possibleRoleCounts[role] or 0)+1 end
        beeRoles[i],possibleByBee[i]=guaranteed,possible
    end
    out.catalogComplete=allKnown;out.cellCount=#bees
    for _ in pairs(giftedTypes) do out.giftedTypeCount=out.giftedTypeCount+1 end
    local stage
    for _,row in ipairs(type(development)=="table" and development.hiveStages or {}) do
        if #bees>=(row.minBees or 0) and (row.maxBees==nil or #bees<=row.maxBees) and (not stage or (row.minBees or 0)>=(stage.minBees or 0)) then stage=row end
    end
    out.targetMinimumLevel=stage and stage.targetMinimumLevel
    for role,target in pairs(stage and stage.roles or {}) do
        if finite(target) and target>0 and (out.roleCounts[role] or 0)<target then
            out.missingRoles[#out.missingRoles+1]={role=role,target=target,observed=out.roleCounts[role] or 0,
                possible=(out.roleCounts[role] or 0)+(out.possibleRoleCounts[role] or 0),
                reason=allKnown and "Base-role coverage below the configured stage target; inspect beequips before replacing a bee" or "Unknown bee definitions; inspect before concluding a role is absent"}
        end
    end
    table.sort(out.missingRoles,function(a,b)return a.role<b.role end)
    for i,b in ipairs(bees) do
        local reasons={};local definition=catalog.bees[b.type]
        if not definition then reasons[#reasons+1]="Unknown bee definition" end
        if definition and (definition.rarity=="Event" or definition.rarity=="Mythic") then reasons[#reasons+1]=definition.rarity.." bee" end
        if b.gifted==true then reasons[#reasons+1]=(giftedTypes[b.type]==1 and "Only gifted copy of this type" or "Gifted bee: explicit review required")
        elseif b.gifted~=false then reasons[#reasons+1]="Gifted state unknown" end
        for _,key in ipairs({"mutation","beequip"}) do
            local value=b[key]
