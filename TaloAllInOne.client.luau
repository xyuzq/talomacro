            c.lease = nil
        elseif observation.conversion == "active" and not lease.stopSent then
            -- Never send a second toggle unless the first one is visibly active.
            local ok, err = deps.toggleConversion(observation, "stop")
            lease.stopSent, lease.cleanupUntil = true, now + 8
            emit("conversion_stop", {ok = ok, reason = err})
