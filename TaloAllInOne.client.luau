            if visiting[id] then return {id=id,status="unknown",reason="Dependency cycle",missingFacts={}} end
            visiting[id]=true
            local deps=copy(definition.dependsOn or {})
            local colorDep=definition.dependsOnSelectedColor
            if type(colorDep)=="table" and selected and colorDep[selected] then deps[#deps+1]=colorDep[selected] end
            local row={id=id,title=definition.title,phase=definition.phase or 0,status="unknown",reason="Current evidence is missing",missingFacts={},dependsOn=deps,
                developmentProject=definition.developmentProject==true,track=definition.track}
            local enabled=not OPTIONAL[id] or type(settings.enabledGoals)=="table" and settings.enabledGoals[id]==true
            if type(settings.enabledGoals)=="table" and settings.enabledGoals[id]==false then enabled=false end
            local conditional=definition.when and definition.when.selectedColorIn
            local compatible=not conditional or selected and includes(conditional,selected)
            if not enabled or conditional and selected and not compatible then
                row.status="disabled";row.reason=not enabled and "Optional project is not enabled" or "This branch is outside the selected color"
            elseif conditional and not selected then
                row.status="waiting";row.reason="Resolve Auto before selecting a color branch";row.missingFacts={"profile.selectedColor"}
            else
                local truth,missing=evaluate(definition.satisfiedWhen,read,settings)
                truthById[id]=truth;row.missingFacts=missing
                local unmet={}
                for _,dependency in ipairs(deps) do if visit(dependency).status~="complete" then unmet[#unmet+1]=dependency end end
                local project=developmentById[id]
                if definition.developmentProject and project then
                    if project.status=="complete" then truthById[id]="true";row.status="complete"
                    elseif project.status=="disabled" or project.status=="waiting" then row.status=project.status
                    elseif #unmet>0 then row.status="waiting"
                    else row.status=project.status end
                    row.reason=#unmet>0 and row.status=="waiting" and "Waiting for "..table.concat(unmet,", ") or project.reason
                    row.missingFacts=copy(project.missingFacts or {});row.active=project.active
                elseif truth=="true" and (id~="endgame" and id~="selected_collector" or #unmet==0) then
                    row.status="complete";row.reason="Verified current evidence satisfies this milestone; earlier work is not replayed"
                elseif #unmet>0 then row.status="waiting";row.reason="Waiting for "..table.concat(unmet,", ")
                elseif truth=="unknown" then row.status="unknown";row.reason="Observe fresh evidence for "..table.concat(missing,", ")
                else row.status="ready";row.reason="Prerequisites are met; this goal remains unmet" end
            end
