    local core = child(player, "CoreStats")
    local function stat(key)
        local v = child(core, key)
        local n = isA(v, "NumberValue") and v.Value or nil
        return finite(n) and n >= 0 and n or nil
    end
    local honey, pollen, capacity = stat("Honey"), stat("Pollen"), stat("Capacity")
    local position = root and root.Position
    local atHive = hive ~= nil and vector(position) and (position - spawn).Magnitude <= 9
    local caption = atHive and activationCaption() or nil
    local pointer = child(player, "ActivatableTarget")
    local interaction = isA(pointer, "ObjectValue") and pointer.Value or nil
    local platform = hive and child(hive, "Platform")
    local expectedPlatform = isA(platform, "ObjectValue") and platform.Value or nil
    local matchingTarget = not interaction or interaction == hive or interaction == expectedPlatform or (hive and interaction:IsDescendantOf(hive))
    local conversion = "unknown"
    if atHive and matchingTarget then
        if caption == "Stop Making Honey" then conversion = "active"
        elseif caption == "Make Honey" then conversion = "idle" end
    end
    local o = {alive = model ~= nil and humanoid ~= nil and root ~= nil and humanoid.Health > 0,
        characterId = model, position = packed(position), walkSpeed = humanoid and humanoid.WalkSpeed,
        honey = honey, pollen = pollen, capacity = capacity, statsValid = honey ~= nil and pollen ~= nil and capacity ~= nil and capacity > 0,
        hiveValid = hive ~= nil, fieldValid = zone ~= nil, atHive = atHive, inField = inField(zone, position) and position.Y>=zone.Position.Y+0.5,
        conversion = conversion, activationCaption = caption}
    o.inputBlocked = InputService:GetFocusedTextBox() ~= nil or get(GuiService, "MenuIsOpen") == true
    o.beeCount, o.discoveredTypes = countBees(), discoveredTypes()
    o.health,o.maxHealth=humanoid and humanoid.Health,humanoid and humanoid.MaxHealth
    o.attack,o.attackSource=combat()
    o.monsters=#refreshMonsters()
    o.parachute=cacheStats and cacheStats.EquippedParachute or "unknown"
    if humanoid then
        local gravity=get(Workspace,"Gravity") or 196.2
        o.jump={useJumpPower=humanoid.UseJumpPower,power=humanoid.JumpPower,height=humanoid.JumpHeight,
            estimatedMaxHeight=humanoid.UseJumpPower and humanoid.JumpPower^2/(2*math.max(1,gravity)) or humanoid.JumpHeight,gravity=gravity}
    end
    o.fieldAccessible, o.fieldAccessState, o.fieldAccessReason = access(name)
    return o
end
