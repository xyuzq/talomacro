                    phase("Observing","Respawned away from hive; walking to its verified platform")
                elseif now >= resetUntil then fail("Owned hive did not load after respawn", now); return
                else c.message = "Waiting for the new character at its owned hive"; return end
            elseif now >= resetUntil then fail("Reset/respawn was not acknowledged within 60 seconds", now); return
            else return end
        end
        if c.lease and c.phase ~= "Converting" then
            cleanup(o, now)
            if c.lease then return end
            if c.phase == "Conversion finishing" then
                c.cycles, c.retries = c.cycles + 1, 0
                phase("Observing", "Bag emptied; returning to the field")
            end
        elseif c.phase == "Conversion finishing" then
            c.cycles, c.retries = c.cycles + 1, 0
            phase("Observing", "Conversion complete")
        end
        if not o.alive then
            if c.phase ~= "Recovering" then recover(now, "Waiting for a living character; no reset is sent") end
            if recoveryUntil and now >= recoveryUntil then fail("Character did not recover within 60 seconds", now) end
            return
        end
        if c.phase == "Recovering" then
            lastCharacter, c.retries = o.characterId, 0
            phase("Observing", "Character recovered; rebuilding the route")
        elseif lastCharacter and o.characterId ~= lastCharacter then
            lastCharacter = o.characterId
            recover(now, "Character changed; cancelling the old route")
            return
        end
        lastCharacter = o.characterId
        if c.phase=="Claiming hive" then
            if job and job.status=="running"then return end
            if not job or job.status~="success" or not o.hiveValid then fail("Auto hive claim failed: "..tostring(job and job.reason),now);return end
