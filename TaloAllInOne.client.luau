        end
        deps.spawn(function()
            local ok, err = pcall(function()
                local character, humanoid, root = deps.character()
                if not character or not humanoid or not root then finish("failed", "Character missing"); return end
                job.character, job.root, job.humanoid = character, root, humanoid
                local landUntil=math.min(job.deadline,deps.now()+2)
