        for _,goal in ipairs(Policy.goals or {})do if goal.id==frontier.id then targets(goal.satisfiedWhen,goal);break end end
    end
    for _,row in ipairs(plan.development and plan.development.materialPlan or {})do
        if row.active==true and type(row.deficit)=="number" and row.deficit>0 then add("craft",row.resource,row.deficit,row.priority,row.reason)end
    end
