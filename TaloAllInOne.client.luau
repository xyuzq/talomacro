makeProgressionHiveGrowth=(function()
-- Hive growth: buy the next hive slot, buy a Basic Egg, hatch it into an empty unlocked cell, and spend
-- Royal Jelly on bees a mixed hive does not need.
-- Prices use the captured place-1993 formulas (HiveSlot.GetCost, Eggs basicEggCost). Every
-- spend is one server call whose result is checked against RetrievePlayerStats.
return function(d)
    local api={};local active=nil
    local function finite(v)return type(v)=="number"and v==v and math.abs(v)<math.huge end
    local function whole(v)return finite(v)and v>=0 and v%1==0 end
    local function key(v)return type(v)=="string"and #v>0 and #v<=160 end
    local MAX_CELLS=50
    -- Captured ReplicatedStorage.HiveSlot hiveSlotCost price(p9) for the n-th purchased slot.
    function api.slotCost(n)
        local i,price=0,3000000
        while i<n-1 do
            if n<=15 then price=price+price*.25+price/(i+1)+1000000
            else price=price+price*(.24+.35*((n-15)/10)^1.2)+price/(i+1)+1000000 end
            i=i+1
        end
        return math.floor(price+.5)
    end
    -- Captured ReplicatedStorage.Eggs basicEggCost price(p35), capped at 10M.
    function api.basicEggCost(n)
        local i,price=0,1000
        while i<n-1 and price<10000000 do price=price+price*.5+1000/(i+1);i=i+1 end
        return math.floor(math.min(price,10000000)+.5)
    end
    local function counters(s)
        local totals=type(s)=="table"and type(s.Totals)=="table"and s.Totals.Purchases
        local eggs=type(s)=="table"and type(s.Eggs)=="table"and s.Eggs
        if type(s)~="table"or not whole(s.UnlockedCells)or type(totals)~="table"or not eggs then return nil end
        local bought=type(totals.Eggs)=="table"and totals.Eggs.Basic or 0
        local slots=totals.HiveSlots or 0
        local basic=eggs.Basic or 0
        local jelly=eggs.RoyalJelly or 0
        if not whole(bought)or not whole(slots)or not whole(basic)or not whole(jelly)then return nil end
        return{unlocked=s.UnlockedCells,slots=slots,eggsBought=bought,basic=basic,jelly=jelly,honey=s.Honey}
    end
    local function cellType(s,x,y)
        local col=type(s.Honeycomb)=="table"and s.Honeycomb["x"..x]
        local cell=type(col)=="table"and col["y"..y]
        return type(cell)=="table"and cell.Type or nil
    end
    local function isGifted(cell)
        for _,t in pairs(type(cell.Traits)=="table"and cell.Traits or{})do if t=="Gifted"then return true end end
        return false
    end
    -- Captured EggTypes RoyalJelly (place 1993): RarityRates and TraitRates.Gifted; the Fandom Royal Jelly page agrees.
    local JELLY={Rare=.69996,Epic=.27,Legendary=.03,Mythic=.00004,gifted=.004}
    local function definition(t)return d.catalog and d.catalog.bees and d.catalog.bees[t]end
    local function rarity(t)local b=definition(t);return b and b.rarity end
    -- Mixed-hive value model (researched 2026-10-31: BSS Fandom "Gifted Bee" and "Royal Jelly" pages, mixed hive guides):
    -- * gifted hive bonuses never stack and jelly on a gifted bee almost always loses gifted, so the first gifted copy
    --   of each type is never rolled; a gifted duplicate only keeps its x1.5 stats;
    -- * jelly gives a Rare 70% of the time, so Legendary, Mythic and Event bees are never rolled;
    -- * a mixed hive wants its token roles covered; from 35 bees about 4 Music (Melody) and 3-4 Baby (Baby Love),
    --   and ungifted Rares are phased out for Epic/Legendary utility bees;
    -- * a mixed hive prefers variety, so a non-gifted duplicate of a Rare/Epic type is worth a little less.
    local ROLE={Focus="focus",Haste="haste",["Haste+"]="haste",Melody="melody",["Baby Love"]="baby_love",
        ["Honey Mark"]="marks",["Honey Mark+"]="marks",["Pollen Mark"]="marks",["Pollen Mark+"]="marks",
        ["Red Boost"]="red_boost",["Blue Boost"]="blue_boost",["Token Link"]="token_link",Rage="rage",["Rage+"]="rage"}
    local BASE={Common=0,Rare=1,Epic=2,Legendary=3,Mythic=4,Event=9}
    function api.stage(n)
        if n>=35 then return{focus=2,haste=2,red_boost=1,blue_boost=1,token_link=1,melody=4,baby_love=3,marks=2,rage=1},2,true end
        if n>=25 then return{focus=1,haste=1,red_boost=1,blue_boost=1,token_link=1,melody=2,baby_love=2,marks=2,rage=1},2,false end
        if n>=15 then return{focus=1,haste=1,red_boost=1,blue_boost=1,token_link=1,melody=1,baby_love=1,marks=1,rage=1},1.5,false end
        return{focus=1,haste=1,red_boost=1,blue_boost=1,token_link=1},1.5,false
    end
    local function roles(bee)
        local out={}
        for _,a in ipairs(definition(bee.type)and definition(bee.type).abilities or{})do
            local role=ROLE[a.name]
            if role and(a.giftedOnly~=true or bee.gifted)then out[role]=true end
        end
        return out
    end
    -- Value of one bee in this hive; the first copy in hive order counts as the original, later copies as duplicates.
    function api.beeValue(bee,bees)
        local base=BASE[bee.rarity]
        if not base then return 99,"unknown bee type"end
        local targets,_,late=api.stage(#bees)
        local earlier,earlierGifted,seen,counts=0,0,false,{}
        for _,o in ipairs(bees)do
            if o==bee then seen=true
            else
                if o.type==bee.type and not seen then earlier=earlier+1;if o.gifted then earlierGifted=earlierGifted+1 end end
                for role in pairs(roles(o))do counts[role]=(counts[role]or 0)+1 end
            end
        end
        local v,why=base,{}
        if bee.gifted and earlierGifted==0 then v=v+9;why[#why+1]="only gifted "..bee.type
        elseif bee.gifted then v=v+.5;why[#why+1]="duplicate gifted"end
        for role in pairs(roles(bee))do
            if(counts[role]or 0)<(targets[role]or 0)then v=v+1.5;why[#why+1]="needed "..role end
        end
        if earlier>0 and not bee.gifted and base<=2 then v=v-.5;why[#why+1]="duplicate"end
        if late and base==1 and not bee.gifted then v=v-.75;why[#why+1]="ungifted Rare at 35+ bees"end
        return v,(#why>0 and table.concat(why,", ")or bee.rarity)
    end
    function api.keeper(bee,bees)
        local v,why=api.beeValue(bee,bees)
        local _,threshold=api.stage(#bees)
        return v>=threshold,why,v
    end
    -- Chance one roll lands a keeper in this cell: rarity rates times the share of that rarity's types that would keep
    -- (types assumed equally likely within a rarity), plus the gifted roll.
    local function keeperChance(bee,bees)
        local byRarity={}
        for t,b in pairs(d.catalog and d.catalog.bees or{})do
            if JELLY[b.rarity]then local r=byRarity[b.rarity]or{};byRarity[b.rarity]=r;r[#r+1]=t end
        end
        local p,original=JELLY.gifted,bee.type
        local probe={x=bee.x,y=bee.y,gifted=false}
        for i,o in ipairs(bees)do if o==bee then bees[i]=probe end end
        for r,types in pairs(byRarity)do
            local keep=0
            for _,t in ipairs(types)do probe.type,probe.rarity=t,r;if api.keeper(probe,bees)and t~=original then keep=keep+1 end end
            p=p+JELLY[r]*keep/#types
        end
        for i,o in ipairs(bees)do if o==probe then bees[i]=bee end end
        return p
    end
    function api.hiveBees(s)
        local bees={}
        for col,cells in pairs(type(s)=="table"and type(s.Honeycomb)=="table"and s.Honeycomb or{})do
            local x=tonumber(tostring(col):match("^x(%d+)$"))
            for r,cell in pairs(type(cells)=="table"and cells or{})do
                local y=tonumber(tostring(r):match("^y(%d+)$"))
                if x and y and type(cell)=="table"and type(cell.Type)=="string"and cell.Type~="Empty"then
                    bees[#bees+1]={x=x,y=y,type=cell.Type,rarity=rarity(cell.Type),gifted=isGifted(cell),equipped=cell.Equips~=nil}
                end
            end
        end
        table.sort(bees,function(a,b)return a.y<b.y or a.y==b.y and a.x<b.x end)
        return bees
    end
    local focus=nil -- Cell being rolled: it keeps rolling until it lands a keeper or the jelly runs out.
    local planCache={}
    -- Every roll candidate (lowest value first) with expected jelly, the total need and the next cell to roll.
    function api.jellyPlan(s,have,reserve)
        local bees=api.hiveBees(s)
        local signature={}
        for _,b in ipairs(bees)do signature[#signature+1]=b.x..","..b.y..b.type..(b.gifted and"*"or"")..(b.equipped and"e"or"")end
        signature=table.concat(signature,";")
        if planCache.signature~=signature then
            local list,need={},0
            for _,b in ipairs(bees)do
                local keep,why,v=api.keeper(b,bees)
                if not keep and not b.equipped then
                    local p=keeperChance(b,bees)
                    if p>0 then
                        b.reason,b.value,b.expected=why,v,math.ceil(1/p)
                        -- Starting on an Epic risks ending on a Rare, so it first needs jelly for about 95% success.
                        b.commit=(BASE[b.rarity]or 0)>=2 and math.ceil(3/p)or 1
                        list[#list+1]=b;need=need+b.expected
                    end
                end
            end
            table.sort(list,function(a,b)return a.value<b.value or a.value==b.value and(a.y<b.y or a.y==b.y and a.x<b.x)end)
            planCache={signature=signature,list=list,need=need}
        end
        local list=planCache.list
        local spare=(have or 0)-(reserve or 0);local nextCell
        for _,b in ipairs(list)do if focus and focus.x==b.x and focus.y==b.y then nextCell=b end end
        if not nextCell then for _,b in ipairs(list)do if spare>=b.commit then nextCell=b;break end end end
        return{candidates=list,need=planCache.need,have=have,next=nextCell}
    end
    local function row(fields,now)
        fields.action="economy";fields.quantity=1;fields.mutatesResources=true;fields.zeroCost=false
        fields.costVerified=true;fields.costObservedAt=now;fields.exactTarget=true;fields.observedAt=now
        fields.accountId=d.accountId;fields.placeVersion=d.placeVersion();fields.timeoutSeconds=300;fields.priority=40
        fields.protectedMinimums=fields.protectedMinimums or{Honey=d.reserve()};fields.source="Talo hive growth (live cache + captured price formula)"
        return fields
    end
    local BATCH=30 -- Rolls per job: one walk and one ledger reservation, then back-to-back rolls.
    local function jellyRow(s,c,now)
        local reserve=d.jellyReserve and d.jellyReserve()or 0
        local plan=api.jellyPlan(s,c.jelly,reserve)
        local b=plan.next
        local summary=string.format("have %d, need about %d for %d bees",c.jelly,plan.need,#plan.candidates)
        if not b then
            if #plan.candidates==0 then return nil end
            return row({id="hive:jelly",operation="royal_jelly",item="RoyalJelly",costs={RoyalJelly=1},ready=false,
                stateKey="jelly:wait:"..c.jelly,protectedMinimums={RoyalJelly=reserve},costSource="One Royal Jelly per roll",
                reason="Saving Royal Jelly: "..summary},now)
        end
        local robo=type(s.RoboChallenges)=="table"and s.RoboChallenges.ActiveChallenge
        local batch=math.max(1,math.min(BATCH,c.jelly-reserve))
        return row({id="hive:jelly",operation="royal_jelly",item="RoyalJelly",costs={RoyalJelly=batch},batch=batch,cell={x=b.x,y=b.y},beeType=b.type,
            first=not(focus and focus.x==b.x and focus.y==b.y),ready=not robo and c.jelly-batch>=reserve,
            stateKey=string.format("jelly:%d,%d:%s:%d",b.x,b.y,b.type,c.jelly),protectedMinimums={RoyalJelly=reserve},
            costSource="Up to "..batch.." Royal Jelly rolled back to back on one cell (captured RoyalJelly rarity rates)",
            reason=robo and"An active Robo Bear Challenge blocks Royal Jelly"
                or string.format("Royal Jelly on %s at %d,%d (%s)",b.reason,b.x,b.y,summary)},now)
    end
    function api.observe()
        local now=d.now();local out={}
        if d.placeVersion()~=1993 then return out,"Hive growth prices are captured only for place version 1993"end
        local s=d.stats();local c=counters(s)
        local honey=d.honey()
        if not c or not whole(honey)then return out,"Hive slot/egg counters are unavailable in the live cache"end
        local jelly=jellyRow(s,c,now)
        if c.unlocked>=MAX_CELLS then out[1]=jelly;return out,"Hive already has 50 unlocked cells"end
        local empty=d.emptyCells()
        if type(empty)~="table"then return out,"Owned hive cells are not fully visible"end
        local reserve=d.reserve()
        local target=empty[1]
        if target and cellType(s,target.x,target.y)~=nil and cellType(s,target.x,target.y)~="Empty"then return out,"Visible empty cell disagrees with the cache"end
        if target and c.basic>0 then
            local robo=type(s.RoboChallenges)=="table"and s.RoboChallenges.ActiveChallenge
            out[1]=row({id="hive:hatch",operation="hatch_empty",item="Basic",costs={Basic=1},cell={x=target.x,y=target.y},
                ready=not robo,stateKey=string.format("hatch:%d,%d:%d",target.x,target.y,c.basic),
                costSource="One owned Basic Egg into an empty unlocked cell",
                reason=robo and"An active Robo Bear Challenge would end if a bee hatches"or string.format("Hatch a Basic Egg into empty cell %d,%d",target.x,target.y)},now)
        elseif target then
            local cost=api.basicEggCost(c.eggsBought+1)
            out[1]=row({id="hive:buy_egg",operation="buy_egg",item="Basic",costs={Honey=cost},ready=honey>=cost+reserve,
                stateKey=string.format("egg:%d:%d",c.eggsBought,c.basic),costSource="Eggs.GetCost Basic #"..(c.eggsBought+1),
                reason=honey>=cost+reserve and string.format("Buy a Basic Egg for %d honey",cost)
                    or string.format("Saving for a Basic Egg: %d honey plus %d reserve",cost,reserve)},now)
        else
            local cost=api.slotCost(c.slots+1)
            -- Better-value gear (ProgressionGear ladder) takes the honey first; the slot waits for it.
            local wait=d.slotWait and d.slotWait()
            out[1]=row({id="hive:buy_slot",operation="buy_slot",item="HiveSlot",costs={Honey=cost},ready=honey>=cost+reserve and not wait,
                stateKey=string.format("slot:%d:%d",c.slots,c.unlocked),costSource="HiveSlot.GetCost #"..(c.slots+1),
                reason=wait or honey>=cost+reserve and string.format("Buy hive slot %d for %d honey",c.unlocked+1,cost)
                    or string.format("Saving for hive slot %d: %d honey plus %d reserve",c.unlocked+1,cost,reserve)},now)
        end
        out[#out+1]=jelly
        return out
    end
    local function evidence(job,after,c)
        local inventory={}
        for resource in pairs(job.costs)do
            if resource=="Honey"then inventory.Honey=whole(after.Honey)and after.Honey or math.floor(tonumber(after.Honey)or -1)
            else inventory[resource]=resource=="RoyalJelly"and c.jelly or c.basic end
        end
        return{accountId=d.accountId,verified=true,source="RetrievePlayerStats after "..job.operation,observedAt=d.now(),
            transactionId=job.transactionId,placeId=d.placeId(),inventory=inventory}
    end
    local function settle(job,status,reason,after,c,rejected)
        job.result={status=status,reason=reason,cancellable=true,transactionRejected=rejected==true or nil,
