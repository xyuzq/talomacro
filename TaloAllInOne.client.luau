                grounded=grounded or deps.now()
                deps.steer(nil)
                if deps.now()-grounded>0.3 then
                    local reached=horizontal<=(short and 3 or 18) and math.abs(part.Position.Y-goal.Y)<=(short and 2 or 6)
                    if short then
                        local safe,floorY=landingSafe(part.Position,goal)
                        reached=reached and safe and type(floorY)=="number" and math.abs(floorY-goal.Y)<=2 and math.abs(part.Position.Y-floorY)<=2
                    end
                    transition("grounded",reached and "Observed landing height and horizontal proximity" or "Grounded away from the planned landing",part)
