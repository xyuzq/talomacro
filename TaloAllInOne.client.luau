    end
    function bridge.drivers(fallback)
        local registry={}
        for action in pairs(actions) do
            local name=action
            registry[name]={
                start=function(candidate,snapshot)
                    if type(candidate)~="table" or candidate.action~=name or type(snapshot)~="table" then return nil,"Progression driver action does not match its candidate" end
                    if active and not active.terminal then return nil,"A progression job already owns the main macro" end
                    local now=d.now();local inspection=bridge.inspect(now);local cap=inspection.capabilities[name]
                    if not inspection.available or type(cap)~="table" or cap.implemented~=true or cap.offlineChecked~=true
                        or cap.executionReady~=true and cap.liveAccepted~=true then return nil,inspection.reason or "Action is not implemented and ready" end
                    if snapshot.accountId~=d.accountId or snapshot.placeVersion~=d.placeVersion() then return nil,"Progression job identity changed" end
                    local m,why=main();if not m then return nil,why end
                    local ok,handle,startReason=pcall(m.progressionStart,plain(candidate))
                    if not ok then return nil,"Main macro rejected the job: "..tostring(handle):sub(1,240) end
                    if handle==nil or handle==false then return nil,tostring(startReason or "Main macro did not start the requested action") end
                    active={main=m,handle=handle,action=name,id=candidate.id,startedAt=now,terminal=false}
                    return active
                end,
                poll=function(job,snapshot)
                    if job~=active or job.terminal then return {status="failed",reason="Progression job no longer owns this bridge"} end
                    if d.macro()~=job.main or snapshot.accountId~=d.accountId or snapshot.placeVersion~=d.placeVersion() then
                        pcall(job.main.progressionCancel,job.handle,"Progression identity changed")
                        job.terminal=true;active=nil;return {status="uncertain",reason="Main macro, account or map changed during the action"}
                    end
                    local ok,result=pcall(job.main.progressionPoll,job.handle,snapshot)
                    if not ok or type(result)~="table" then
                        job.pollFailures=(job.pollFailures or 0)+1
                        if job.pollFailures>=3 then
                            pcall(job.main.progressionCancel,job.handle,"Progression status unavailable")
