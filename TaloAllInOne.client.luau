        end
        for key,row in pairs(lookup)do
            if row==false then
                for _,bee in ipairs(result.slots)do if bee.x..":"..bee.y==key then bee.status,bee.reason,bee.previewEligible="duplicate_grid","Owned hive has duplicate grid coordinates",false end end
            end
