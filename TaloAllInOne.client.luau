        local running={status="checking",reason="Checking selected route against live geometry",seconds=0,
            diagnostics={routeScope=c.routeScope,transportPolicy=c.transportPolicy,requiredCannon=c.requiredCannon,
                bees=c.bees,walkSpeed=c.walkSpeed},validationAttempts=0}
        d.telemetry.canonical=running
        c.onValidation=function(edge)
            running.seconds=d.now()-started
            running.currentEdge={id=edge.id,kind=edge.kind}
            running.validationAttempts=running.validationAttempts+1
            running.diagnostics.rejections=c.rejections
            running.diagnostics.walkFailures=c.walkFailures
            running.diagnostics.walkRepairs=c.walkRepairs
        end
