local cacheStats, cacheBusy, cacheAt, cacheGeneration, beeMemo, beeAt,beeHive,cacheApi = nil, false, -math.huge, 0, nil, -math.huge,nil,nil
local function refreshStats()
    if cacheBusy and os.clock() - cacheAt >= 8 then
        cacheGeneration, cacheBusy, cacheStats = cacheGeneration + 1, false, nil
        capabilities.statsCache = "timed out; late result ignored"
    end
    if cacheBusy or os.clock() - cacheAt < 5 then return end
    cacheAt = os.clock()
    local module = child(Storage, "ClientStatCache")
    if not isA(module, "ModuleScript") then return end
    cacheBusy, cacheGeneration = true, cacheGeneration + 1
    local generation = cacheGeneration
    task.spawn(function()
        local ok, data, binding = pcall(function() local cache = require(module); return cache:Get(),cache end)
        if closed or generation ~= cacheGeneration then return end
        cacheBusy = false
        if ok and type(data) == "table" and (data.UserId == nil or data.UserId == player.UserId) then
            cacheStats,cacheApi = data,binding; capabilities.statsCache = "captured"
        else cacheStats,cacheApi = nil,nil; capabilities.statsCache = "unavailable" end
    end)
end
local function countBees()
    local current=ownHive()
    if current~=beeHive then beeHive,beeAt=current,-math.huge end
    if os.clock() - beeAt < 1 then return beeMemo end
    beeAt, beeMemo = os.clock(), nil
    local hive = ownHive()
    local cells = hive and child(hive, "Cells")
    local seen, count, models, valid = {}, 0, 0, cells ~= nil
    for _, cell in ipairs(cells and cells:GetChildren() or {}) do
        if isA(cell, "Model") then
            models = models + 1
            local x, y, id, kind, locked = child(cell, "CellX"), child(cell, "CellY"), child(cell, "CellID"), child(cell, "CellType"), child(cell, "CellLocked")
            x, y, id = x and x.Value, y and y.Value, id and id.Value
            if not finite(x) or not finite(y) or not finite(id) or x % 1 ~= 0 or y % 1 ~= 0 or x < 1 or x > 5 or y < 1 or y > 10
                or id ~= (y - 1) * 5 + x - 1 or seen[id] or not isA(kind, "StringValue") or not isA(locked, "BoolValue") then valid = false
            else
                seen[id] = true
                if kind.Value ~= "Empty" then
                    if not kind.Value:match("Bee$") or locked.Value then valid = false else count = count + 1 end
                end
            end
        end
    end
    if valid and models == 50 then beeMemo = count end
    return beeMemo
end
local function discoveredTypes()
    local list = cacheStats and cacheStats.DiscoveredBees
    if type(list) ~= "table" then return nil end
    local count, seen = 0, {}
    for key, name in pairs(list) do
        if type(key) ~= "number" or key % 1 ~= 0 or key < 1 or type(name) ~= "string" or seen[name] then return nil end
        count, seen[name] = count + 1, true
    end
    for i = 1, count do if type(list[i]) ~= "string" then return nil end end
    return count
end
