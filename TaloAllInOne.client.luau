                    if attempt==1 and preset then waypoints,routeSource=preset,intent=="transit" and "checked transit corridor" or "continuous field pattern"end
                    if not waypoints and deps.shortPath and distance(root.Position,destination)<=320 and (not lastDirectStart or distance(root.Position,lastDirectStart)>3)then
                        lastDirectStart=root.Position
                        waypoints=deps.shortPath(root.Position,destination,function()return not valid()end)
                        if waypoints then routeSource="checked local walk" end
                    end
                    if not waypoints and attempt==1 and deps.hintPath then
                        waypoints=deps.hintPath(root.Position,destination)
                        if waypoints then routeSource="saved route hint"end
                    end
                    if not waypoints and deps.surfacePath then
