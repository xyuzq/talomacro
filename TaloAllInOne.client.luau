local State=(function()
-- Plain evidence adapter. No inputs, remotes, purchases or guessed recipes.

local State = {}

local function finite(v) return type(v)=="number" and v==v and math.abs(v)<math.huge end

local function whole(v) return finite(v) and v>=0 and v%1==0 end

local function tableOf(v) return type(v)=="table" and v or {} end

local function identifier(v)

    return type(v)=="string" and #v>0 and #v<=160 and v:match("%S") and not v:find("[^%w%s_%-%']")

end

local function canonical(v) return identifier(v) and v:gsub("[^%w]","") or nil end

local function dense(raw,limit)

    if type(raw)~="table" then return nil end

    local count,max=0,0

    for index in pairs(raw) do

        if not whole(index) or index<1 or index>(limit or 256) then return nil end

        count,max=count+1,math.max(max,index)

    end

    return count==max and count or nil

end

local function evidenceValue(v)

    if type(v)=="table" and (v.status=="observed" or v.status=="derived") and v.value~=nil then return v.value end

end

local function copyFact(v,source,at,derived)

    if type(v)=="table" and (v.status=="observed" or v.status=="derived") and v.value~=nil then

        return {value=v.value,status=v.status,source=v.source or source,observedAt=v.observedAt or v.observedAtUnix or at,

            coverage=v.coverage or "explicit_value",validated=v.status=="derived" and derived==true or nil}

    end

    return {status="unknown",reason=type(v)=="table" and v.reason or "Not observed",source=source,observedAt=at}

end

local function fact(v,source,at,derived,coverage)

    if v==nil then return {status="unknown",source=source,observedAt=at,reason="Not observed"} end

    return {value=v,status=derived and "derived" or "observed",source=source,observedAt=at,

        validated=derived or nil,coverage=coverage or "explicit_value"}

end

local events={Vicious=true,Gummy=true,Windy=true,Tabby=true,Photon=true,Festive=true,Puppy=true,Crimson=true,Cobalt=true,Bear=true,Digital=true}

local function plain(value,depth)

    if type(value)~="table" then

        if type(value)=="string" or type(value)=="boolean" or finite(value) then return value end

        return nil

    end

    if (depth or 0)>7 then return nil end

    local result,count={},0

    for k,v in pairs(value) do

        count=count+1;if count>512 then return nil end

        if type(k)=="string" or whole(k) then result[k]=plain(v,(depth or 0)+1) end

    end

    return result

end

local function base(context,at,historical)

    local c=context or {}

    local s={schemaVersion="talo.progression-state/1",accountId=c.accountId,observedAt=at,historical=historical,

        source=historical and "historical_snapshot" or "live_observation",placeId=c.placeId,placeVersion=c.placeVersion,

        facts={},inventory={},fields={},quests={},capabilities={},runtime={},warnings={}}

    s.facts["account.identity"]=fact(c.accountId,"LocalPlayer.UserId / explicit offline account label",at)

    for action,cap in pairs(tableOf(c.capabilities)) do

        if type(action)=="string" and type(cap)=="table" then

            s.capabilities[action]={implemented=cap.implemented==true,offlineChecked=cap.offlineChecked==true,

                liveAccepted=cap.liveAccepted==true and not historical,executionReady=cap.executionReady==true and not historical,

                status=cap.status or "acceptance_pending",placeVersion=cap.placeVersion,accountId=cap.accountId,field=cap.field,

                fields=plain(cap.fields),targets=plain(cap.targets),controlledTrial=cap.controlledTrial==true,

                observedAt=cap.observedAt,source=cap.source,reason=cap.reason}

        end

    end

    -- Saved observations may be inspected, but never provide executable live work.

    if not historical and type(c.routines)=="table" then s.routines=plain(c.routines) end

    if not historical and type(c.economy)=="table" then s.economy=plain(c.economy) end

    for _,f in ipairs(tableOf(c.fields)) do

        if type(f)=="table" and type(f.name)=="string" then

            s.fields[#s.fields+1]={name=f.name,accessible=f.accessible,usable=f.usable,color=f.color,bees=f.bees,reason=f.reason,

                questWeight=f.questWeight,materialWeight=f.materialWeight,observedAt=at}

        end

    end

    local r=tableOf(c.runtime)

    for _,k in ipairs({"running","phase","field","health","maxHealth","healthFraction","inputBlocked","bagFraction","honey","pollen","capacity","cycles","walkSpeed","cleanupPending"}) do

        if type(r[k])=="string" or type(r[k])=="boolean" or finite(r[k]) then s.runtime[k]=r[k] end

    end

    if type(r.developmentWork)=="table" then

        local u=r.developmentWork

        if u.accountId==c.accountId and u.windowSeconds==600 and finite(u.observedAt) and finite(u.sideSeconds) and u.sideSeconds>=0 and u.sideSeconds<=600 then

            s.runtime.developmentWork={accountId=u.accountId,windowSeconds=u.windowSeconds,observedAt=u.observedAt,

                sideSeconds=u.sideSeconds,windowStartedAt=u.windowStartedAt}

        end

    end

    return s

end

local function levels(s,bees,complete,at)

    if not complete then return end

    local values,eventTypes={},{}

    for _,b in ipairs(bees) do

        if not whole(b.level) or b.level<1 then values=nil;break end

        values[#values+1]=b.level

    end

    if values and #values>0 then

        table.sort(values);local n=#values

        s.facts["hive.minimumLevel"]=fact(values[1],"complete matching owned cells.Lvl",at,true)

        s.facts["hive.medianLevel"]=fact(n%2==1 and values[(n+1)/2] or (values[n/2]+values[n/2+1])/2,"complete matching owned cells.Lvl",at,true)

    end

    local seen={}

    for _,b in ipairs(bees) do if events[b.type] and not seen[b.type] then eventTypes[#eventTypes+1]=b.type;seen[b.type]=true end end

    table.sort(eventTypes);s.facts["hive.eventBees"]=fact(eventTypes,"complete current owned hive composition",at,true)

end

local function owned(s,key,raw,source,at)

    local length=dense(raw,256)

    if length==nil then return end

    local ids,seen={},{}

    for k=1,length do

        local id=raw[k]

        id=canonical(id)

        if not id or id=="" then return end

        if not seen[id] then ids[#ids+1]=id;seen[id]=true end

    end

    table.sort(ids);s.facts[key]=fact(ids,source,at,true,"observed_collection_only")

end

function State.objective(raw,source,at)

    if type(raw)~="table" then return nil end

    local kind=raw.Type

    local mapped={['Collect Pollen']=raw.Zone and 'field_pollen' or raw.Color and 'color_pollen' or 'pollen',

        ['Collect Goo']='goo',['Have Items']='items',['Defeat Monsters']='kills',['Collect Tokens']='tokens'}

    return {kind=mapped[kind] or 'unmapped',rawType=kind,field=type(raw.Zone)=="string" and raw.Zone or nil,

        color=type(raw.Color)=="string" and raw.Color:lower() or nil,target=finite(raw.Amount) and raw.Amount>0 and raw.Amount or nil,

        status="observed",source=source,observedAt=at,coverage="definition_only",progressStatus="unknown"}

end

function State.fromReadiness(readiness,context)

    local c=context or {};local r=tableOf(readiness);local at=r.capturedAtUnix

    local historical=c.sourceMode~="live_observation" or c.historical==true or r.historical==true or r.snapshotOnly==true

    local s=base(c,at,historical);local feed=tableOf(r.feeding);local cache=tableOf(c.cache)

    local cacheAt=c.cacheObservedAt or at

