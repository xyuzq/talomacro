            if job and job.status=="running"then return end
            local success=not prompt or job and job.status=="success"
            local why=job and job.reason or "Teleport popup recovery disappeared"
            job=nil
            popupFailures=success and 0 or popupFailures+1
            popupJoinFallback=not success and popupFailures>=2
            h.message=success and "Teleport dialog closed; choosing another server" or tostring(why)
            h.phase=success and "Searching" or popupJoinFallback and "Waiting for teleport retry" or "Waiting for teleport popup"
            pendingHop=pendingHop or "Previous teleport failed"
            retryAt=now+(success and 1 or popupJoinFallback and 1 or 2)
            deps.event("hunt_prompt_recovery",{ok=success,reason=why,failures=popupFailures,joinFallback=popupJoinFallback})
            return
        end
        if prompt and popupJoinFallback then
            if job then cancelJob()end
            if retryAt and now<retryAt then h.message="Teleport Ok input was rejected; waiting before another bounded server join";return end
            local why=pendingHop or "Recognized Teleport Failed dialog could not be dismissed"
            pendingHop=nil
