        end
    end
    local function resourceName(name)return aliases[name] or name end
    local stocks={}
    local function stock(name)
        name=resourceName(name)
        if stocks[name]~=nil then return stocks[name]~=false and stocks[name] or nil end
        local row=resourceConfig[name] or {};local names={name}
        for _,alias in ipairs(tableOf(row.aliases))do names[#names+1]=alias end
        local found=nil
        for _,key in ipairs(names)do
            local value=read("inventory."..key)
            if value~=nil then
                local supplied=tableOf(snapshot.inventory)[key]
                if not quantity(value) or supplied~=nil and supplied~=value or found~=nil and found~=value then stocks[name]=false;return nil end
                found=value
            end
        end
        stocks[name]=found==nil and false or found
        return found
    end
    local selected=settings.selectedColor or (settings.targetMode~="auto" and settings.targetMode) or nil
