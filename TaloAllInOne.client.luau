    local homeStatus=text("InspectHiveTravelStatus","Go to your hive, then choose a quantity and click Feed.",252,410,488,30,11)
    local quantityBox=make("TextBox",{Name="InspectTreatQuantity",Text="1",PlaceholderText="Treat quantity",ClearTextOnFocus=false,
        Position=UDim2.fromOffset(358,364),Size=UDim2.fromOffset(110,32),BackgroundColor3=Color3.fromRGB(13,19,29),
        TextColor3=ink,Font=Enum.Font.Gotham,TextSize=14,BorderSizePixel=0},panel)
    make("UICorner",{CornerRadius=UDim.new(0,7)},quantityBox)
    local controls={}
