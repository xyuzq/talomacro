        else route,cost,why=manager.plan(start,goal,c,blocked)end
        reason=why
        local diagnostics={routeScope=c.routeScope,transportPolicy=c.transportPolicy,requiredCannon=c.requiredCannon,bees=c.bees,discoveredTypes=c.discoveredTypes,gear=gear or"unavailable",walkSpeed=c.walkSpeed,maxSlopeAngle=c.maxSlopeAngle,rejections=c.rejections,walkStats=c.walkStats,walkFailures=c.walkFailures,walkRepairs=c.walkRepairs,
            liveMapFingerprint=index.geometryFingerprint,navigationFingerprint=index.navigationFingerprint,compiledMapFingerprint=data.fingerprint}
        diagnostics.walkingItinerary=walkingStatus or pinnedWalk and {id=walkingCoverage.id,status="rejected",minBees=walkingCoverage.minBees,points=walkingCoverage.pointCount}or nil
        d.telemetry.canonical={status=route and "validated"or"rejected",reason=why,seconds=d.now()-started,estimatedSeconds=cost,fingerprint=data.fingerprint,diagnostics=diagnostics}
        return route,cost,why,true,diagnostics
    end
    function bridge.plan(start,goal,excluded,used,options)
        -- Native route jobs catch errors, but a planner exception otherwise leaves
        -- the last successful JSON looking like an ordinary pending movement job.
        -- Keep the failure distinct from a checked geometry/access rejection.
        d.telemetry.canonical={status="checking",reason="Preparing live route context",seconds=0}
        local ok,route,cost,why,ready,diagnostics=pcall(plan,start,goal,excluded,used,options)
        if ok then
            if not route and d.telemetry.canonical.status=="checking"then
                d.telemetry.canonical={status=ready and"rejected"or"unavailable",reason=why}
            end
            return route,cost,why,ready,diagnostics
        end
        local partial=d.telemetry.canonical
        local failure="Canonical planner exception: "..tostring(route):sub(1,1000)
        reason=failure
        d.telemetry.canonical={status="error",reason=failure,stage=partial and partial.reason,
            currentEdge=partial and partial.currentEdge,seconds=partial and partial.seconds,
            diagnostics=partial and partial.diagnostics}
        return nil,nil,failure,true,partial and partial.diagnostics
    end
    function bridge.refreshWalk(edge,remaining,current,externalCancel)
