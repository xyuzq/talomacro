                        local job,reason=chosen.start(candidate,snapshot)
                        if not job then return nil,reason end
                        return {driver=chosen,job=job}
                    end,
                    poll=function(job,snapshot)return job.driver.poll(job.job,snapshot)end,
                    cancel=function(job,reason)return job.driver.cancel(job.job,reason)end,
                }
            elseif registry[name]==nil then registry[name]=driver end
        end
        registry.active=function()return bridge.active() or type(fallback)=="table" and type(fallback.active)=="function" and fallback.active() or nil end
        return registry
    end
    return bridge
end

end)()

local worldRules=(function()
-- Field access is distinct from collector/discovery unlocks and route availability.

local rules = {}

-- color: dominant flower colour (standard BSS layout; "mixed" = no dominant colour). Used for quest/yield scoring only.

rules.fields = {

    {name = "Sunflower Field", bees = 0, color = "white"}, {name = "Dandelion Field", bees = 0, color = "white"},

    {name = "Mushroom Field", bees = 0, color = "red"}, {name = "Blue Flower Field", bees = 0, color = "blue"}, {name = "Clover Field", bees = 0, color = "mixed"},

    {name = "Spider Field", bees = 5, color = "white"}, {name = "Bamboo Field", bees = 5, color = "blue"}, {name = "Strawberry Field", bees = 5, color = "red"},

    {name = "Pineapple Patch", bees = 10, color = "white"}, {name = "Stump Field", bees = 10, color = "blue"},

    {name = "Cactus Field", bees = 15, color = "mixed"}, {name = "Pumpkin Patch", bees = 15, color = "white"},

    {name = "Pine Tree Forest", bees = 15, color = "blue"}, {name = "Rose Field", bees = 15, color = "red"},

    {name = "Mountain Top Field", bees = 25, color = "mixed"}, {name = "Coconut Field", bees = 35, color = "white"}, {name = "Pepper Patch", bees = 35, color = "red"},

    {name = "Ant Field", bees = 20, special = "Ant Pass and active challenge required"},

    {name = "Hub Field", special = "Portal access; walking route unavailable"},

    {name = "Mixed Brick Field", special = "Event transport; access not mapped"},

    {name = "Blue Brick Field", special = "Event transport; access not mapped"},

    {name = "Red Brick Field", special = "Event transport; access not mapped"},

    {name = "White Brick Field", special = "Event transport; access not mapped"},

}

rules.transports = {

    {name = "Red Cannon", types = 25, bees = 0, landing = "Mountain Top Field", landingBees = 25},

    {name = "Yellow Cannon", types = 12, bees = 10, landing = "Hive area", landingBees = 0},

    {name = "Slingshot", types = 8, bees = 0, landing = "Pineapple Patch", landingBees = 10},

    -- Its activation is catalogued, but a static landing is not fabricated.

    {name = "Blue Cannon", types = 16, bees = 15, landingBees = 0},

}

rules.gates = {

    {name = "5 Bee Gate", bees = 5}, {name = "10 Bee Gate", bees = 10}, {name = "15 Bee Gate", bees = 15},

    {name = "20 Bee Gate", bees = 20}, {name = "25 Bee Gate", bees = 25}, {name = "35 Bee Gate", bees = 35},

}

function rules.field(name)

    for _, entry in ipairs(rules.fields) do if entry.name == name then return entry end end

end

function rules.access(name, bees, present)

    local entry = rules.field(name)

    if not entry then return false, "unknown", "Unmapped field requirements" end

    if entry.bees and entry.bees > 0 and type(bees) ~= "number" then return false, "unknown", "Current bee count unavailable" end

    if entry.bees and type(bees) == "number" and bees < entry.bees then

        return false, "locked", string.format("Needs %d bees; you have %d", entry.bees, bees)

    end

    if entry.special then return false, "special", entry.special end

    if not present then return false, "not_streamed", "Field is not loaded on this client" end

    return true, "unlocked", entry.bees == 0 and "Starting field" or ("Unlocked: " .. entry.bees .. " bees")

end

function rules.transportAccess(entry, bees, types)

    if entry.bees > 0 and (type(bees) ~= "number" or bees < entry.bees) then return false, "Bee gate is locked" end

    if type(types) ~= "number" or types < entry.types then return false, "Needs " .. entry.types .. " discovered bee types" end

    if type(bees) ~= "number" or bees < entry.landingBees then return false, "Landing area's bee gate is locked" end

    return true

end

-- A nearby pair of freshly projected terrain tops can propose a multi-step

-- climb. This never proves a traversable path or changes a physical jump limit.

function rules.terraceLink(a,b,jumpHeight)

    local x,y=a.sourceBounds,b.sourceBounds

    if not a.terrain or not b.terrain or not x or not y or type(jumpHeight)~="number"then return false end

    local p,q=a.position,b.position

    local dx,dz=q.X-p.X,q.Z-p.Z

    local horizontal=math.sqrt(dx*dx+dz*dz)

    local rise=q.Y-p.Y

    if rise<=math.max(1.5,jumpHeight-0.9) or rise>math.min(80,jumpHeight*4) or horizontal>100 or horizontal<rise*0.75 then return false end

    local gx=math.max(0,x.minX-y.maxX,y.minX-x.maxX)

    local gz=math.max(0,x.minZ-y.maxZ,y.minZ-x.maxZ)

    return gx*gx+gz*gz<=12*12

end

-- Repeat a verified useful transport from the same origin region. Failed/locked edges are absent.

function rules.preferFlight(nodes,edges,name)

    local toy="toy:"..name

    if not nodes[toy]then return end

    local walkEdges={}

    for id,list in pairs(edges)do

        walkEdges[id]={}

        for _,e in ipairs(list)do if e.kind=="walk"then walkEdges[id][#walkEdges[id]+1]=e end end

    end

    local prefix,cost=rules.shortest(nodes,walkEdges,"start",toy)

