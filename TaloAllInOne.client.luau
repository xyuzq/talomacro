            requestedDeploymentPulses=deploymentPulses,deploymentInputPulses=0,closeInputPulses=0,inputPulses=0,
            observedDeployed=false,deploymentConfidence="input only; controller state unobserved",modelConfidence=modelConfidence,
            samples={},transitions={},goal={x=goal.X,y=goal.Y,z=goal.Z}}
        local ratios,speeds,lastVelocity,settled={}, {},nil,0
