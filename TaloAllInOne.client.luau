    if not hit or hit.Normal.Y < 0.65 or (zone and math.abs(hit.Position.Y - zone.Position.Y) > 8) then return nil end
    return hit.Position + Vector3.new(0, math.max(2, humanoid.HipHeight + root.Size.Y / 2), 0)
end
