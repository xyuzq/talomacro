    for _,d in ipairs(tableOf(snapshot.projectDemands))do
        if current and type(d)=="table" and type(d.projectId)=="string" and type(d.resource)=="string" and quantity(d.quantity) and d.verified==true
            and d.accountId==snapshot.accountId and type(d.source)=="string" and d.source~="" and fresh(d.observedAt,now,age)
            and (d.selectedColor==nil or d.selectedColor==selected) then
            local name=resourceName(d.resource);local key=d.projectId..":"..name
            if not seenDemands[key] then demands[name]=math.min(LIMIT,(demands[name] or 0)+d.quantity);seenDemands[key]=true end
        end
    end
    local reserved=allocationReservations(snapshot,now)
    for name,row in pairs(resourceConfig)do
        local base=stageTarget(row,bees,settings.materialBuffers)
        local activation=row.activation or "early_buffer"
        local active=quantity(bees) and bees>=(row.minBees or 0) and (not finite(row.maxBees) or bees<=row.maxBees)
        if activation=="project_demand_only" then active=active and (demands[name] or 0)>0 end
        if activation=="protect_existing" then active=current end
        local value=stock(name)
        local target=activation=="protect_existing" and (value or 0) or math.max(base,demands[name] or 0)
        if activation=="project_demand_only" and not active then target=0 end
        local protect=value and (row.preserveExisting and value or row.protect and math.min(target,value) or 0) or 0
        if not active and not row.preserveExisting then protect=0 end
        report.protectedResources[name]=math.min(LIMIT,protect+(reserved[name] or 0))
        local item={resource=name,displayName=row.displayName or name,target=target,stock=value,deficit=value and math.max(0,target-value) or nil,
            protected=protect,reserved=reserved[name] or 0,activation=activation,active=active,reason=row.reason or "Preserve a bounded buffer for overlapping development projects",
            ingredientPlan={},craftingAllowed=false,goalId=row.goalId,priority=finite(row.priority) and row.priority or 70}
        report.materialPlan[#report.materialPlan+1]=item;materialMap[name]=item
    end
    table.sort(report.materialPlan,function(a,b)return a.priority<b.priority or a.priority==b.priority and a.resource<b.resource end)
    local pools={}
    local function pool(name)
        name=resourceName(name)
        if pools[name]~=nil then return pools[name]~=false and pools[name] or nil end
        local value=stock(name)
        -- A held ingredient may serve its intended upgrade. Reserve each physical unit once
        -- between projects, then protect it from optional consumption below.
        pools[name]=value and math.max(0,value-(reserved[name] or 0)) or false
