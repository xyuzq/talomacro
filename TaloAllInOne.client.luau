local function inField(part, position, inset)
    if not part or not vector(position) then return false end
    local localPos = part.CFrame:PointToObjectSpace(position)
    -- Up to 25 studs above counts as in the field: a jump (about 17 studs at JumpPower 75) must not look like leaving it.
    return math.abs(localPos.X) <= part.Size.X / 2 - (inset or 0) and math.abs(localPos.Z) <= part.Size.Z / 2 - (inset or 0)
        and localPos.Y >= -(part.Size.Y / 2 + 12) and localPos.Y <= part.Size.Y / 2 + 25
end
local function refreshMonsters()
    local selected=huntAdapter and huntAdapter.contextIdentity()
    if os.clock()-monstersAt<0.25 and monsterSelection==selected then return monsters end
    monsterSelection=selected
    monstersAt,monsters=os.clock(),{}
    local _,humanoid=character()
    local fraction=humanoid and finite(humanoid.MaxHealth) and humanoid.MaxHealth>0 and humanoid.Health/humanoid.MaxHealth or nil
    local radius=perception.radius(countBees(),combat(),fraction)
    local folder=child(Workspace,"Monsters")
    for i,model in ipairs(folder and folder:GetChildren() or {}) do
        if i>64 then break end
        local part=isA(model,"BasePart") and model or child(model,"HumanoidRootPart") or get(model,"PrimaryPart") or child(model,"Torso") or child(model,"Head")
        local h=model:FindFirstChildOfClass("Humanoid")
        if not part then
            local ok,parts=pcall(function()return model:GetDescendants()end)
            if ok then for j,p in ipairs(parts)do if j>64 then break end;if isA(p,"BasePart")then part=p;break end end end
        end
        if part and vector(get(part,"Position")) and (not h or h.Health>0) and not(huntAdapter and huntAdapter.ignoreMonster(model)) then
            local velocity=get(part,"AssemblyLinearVelocity")
            local predicted=part.Position
            if vector(velocity) and velocity.Magnitude<120 then predicted=predicted+Vector3.new(velocity.X,0,velocity.Z)*0.35 end
            local size=get(part,"Size")
            local body=vector(size) and math.max(size.X,size.Z)/2 or 2
            monsters[#monsters+1]={position=predicted,radius=perception.monsterRadius(model.Name,radius,body),name=model.Name}
        end
    end
    return monsters
end
