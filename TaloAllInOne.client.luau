        deploymentPulses=deploymentPulses or (fromCannon and 2 or 1)
        if options.deploymentRecovery and(not fromCannon or deploymentPulses~=1)then return false,"Observed deployment recovery requires one initial cannon pulse"end
        if options.landingDescent~=nil and(not fromCannon or type(options.landingDescent)~="function")then return false,"Early landing requires a cannon descent validator"end
        local model,h,root=deps.character()
