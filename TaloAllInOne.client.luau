local function pointClear(x, y)
    local pg = player:FindFirstChildOfClass("PlayerGui")
    if not pg then return false end
    local containers = {pg}
    local coreOK,core=pcall(function()return game:GetService("CoreGui")end)
    if coreOK and core then containers[#containers+1]=core
    elseif inputMode=="VirtualInputManager" then return false end
    local insetOK, topLeft = pcall(function() return GuiService:GetGuiInset() end)
    if not insetOK then return false end
    for _, container in ipairs(containers) do
        for _, offset in ipairs({0, topLeft.Y}) do
            local ok, objects = pcall(function() return container:GetGuiObjectsAtPosition(x, y - offset) end)
            if not ok then return false end
            for _, object in ipairs(objects) do
                if visible(object) and (isA(object, "GuiButton") or isA(object, "TextBox") or get(object, "Active") == true) then return false end
            end
        end
    end
    return true
end
local function gather(o)
    if closed or controller.mode ~= "running" or not o.alive or not o.inField then return false, "Gathering context changed" end
    local ready, reason = inputReady()
    if not ready then return false, reason end
    if heldMouse and heldMouse.collectorError then return false,heldMouse.collectorError end
    if heldMouse or activatedTool then return true,"Collector pulse is still pending"end
    local model = player.Character
    local tool = model and model:FindFirstChildOfClass("Tool")
    if tool then
        activatedTool = tool
        local ok, err = pcall(function() tool:Activate() end)
        if ok then task.spawn(function()
            task.wait(0.08)
            if activatedTool==tool then
                local released,why=pcall(function()tool:Deactivate()end)
                activatedTool=nil
                telemetry.collector={pulseSeconds=0.08,status=released and "released" or "release failed",reason=not released and tostring(why) or nil}
            end
        end)else release() end
        capabilities.collector = "equipped Tool:Activate"
        return ok, err
    end
    if not virtual then return false, "No equipped Tool or supported virtual input API" end
    local pressedOK,pressed=pcall(function()return InputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)end)
    if pressedOK and pressed and not heldMouse then
        capabilities.collector="waiting for physical mouse release";return true
    end
    local camera = Workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize
    if not viewport or viewport.X < 100 or viewport.Y < 100 then return false, "Camera viewport unavailable" end
    local lastError
    for _, ratio in ipairs({{0.5,0.5},{0.62, 0.62}, {0.74, 0.66}, {0.46, 0.65}, {0.68, 0.48},{0.88,0.55},{0.9,0.86}}) do
        local px, py = math.floor(viewport.X * ratio[1]), math.floor(viewport.Y * ratio[2])
        if pointClear(px,py)then
            local ok,err=pcall(mouseButton,px,py,true)
            if ok then
                local owner={x=px,y=py};heldMouse=owner
                telemetry.collector={pulseSeconds=0.08,status="pressed",requestedAt=os.clock()-runStarted}
                task.spawn(function()
                    task.wait(0.08)
                    if heldMouse~=owner then return end
                    local upOK,upError=pcall(mouseButton,px,py,false)
                    if upOK or tostring(upError):lower():find("duplicate button state",1,true)then
                        heldMouse=nil;telemetry.collector.status="released; pollen outcome observed separately"
                    else owner.collectorError=tostring(upError);telemetry.collector.status="release failed"end
                end)
                capabilities.collector=inputMode.." guarded 80ms pulse";return true
            end
            lastError=tostring(err)
            if lastError:lower():find("duplicate button state",1,true)then capabilities.collector="waiting for mouse state to settle";return true end
            -- VirtualInput rejects CoreGui hits before delivery. Try a different clear point.
            if not lastError:lower():find("coregui",1,true)then return false,err end
        end
    end
    return false,lastError or "All candidate click positions overlap interactive UI"
end
local function toggleConversion(o, intent)
