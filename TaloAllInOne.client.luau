                if c.lease then c.lease.acknowledged = true end
                c.message = "Converting; pollen " .. tostring(o.pollen)
            elseif c.lease then
                if now - c.lease.sentAt >= 8 then fail("Conversion start unconfirmed; no blind toggle retry", now) end
            elseif o.conversion == "idle" then
                c.lease = {sentAt = now, cleanupUntil = now + 8, acknowledged = false}
