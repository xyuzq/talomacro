                        local retryLanding=math.min(job.deadline,deps.now()+2)
                        while deps.airborne and deps.airborne(humanoid)and valid()and deps.now()<retryLanding do
                            job.phase="waiting for landing";deps.steer(destination,job.character);deps.sleep(0.05)
                        end
