    for _,e in ipairs(edges[toy] or {})do

        if e.kind=="flight" and e.to=="goal"then prefix[#prefix+1]=e;return prefix,cost+e.cost end

    end

end

-- Dijkstra chooses estimated time, including directed flight edges and failed-edge exclusions.

function rules.shortest(nodes, edges, startId, goalId)

    local cost, previous, visited = {[startId] = 0}, {}, {}

    while true do

        local best, bestCost

        for id, value in pairs(cost) do if not visited[id] and (not bestCost or value < bestCost or value==bestCost and tostring(id)<tostring(best)) then best, bestCost = id, value end end

        if not best then return nil, "No eligible route" end

        if best == goalId then

            local route, current = {}, goalId

            while current ~= startId do

                local edge = previous[current]

                if not edge then return nil, "Broken route graph" end

                table.insert(route, 1, edge); current = edge.from

            end

            return route, bestCost

        end

        visited[best] = true

        for _, edge in ipairs(edges[best] or {}) do

            if nodes[edge.to] and type(edge.cost) == "number" and edge.cost >= 0 then

                local nextCost = bestCost + edge.cost

                if not cost[edge.to] or nextCost < cost[edge.to] then cost[edge.to], previous[edge.to] = nextCost, edge end

            end

        end

    end

end

return rules


end)()

