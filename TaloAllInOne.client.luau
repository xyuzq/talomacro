    function a.stingers()
        local stats=d.stats();local eggs=stats and stats.Eggs
        local value=type(eggs)=="table" and eggs.Stinger
        return finite(value) and value>=0 and value or nil
    end
    function a.night()
        local value=get(lighting,"ClockTime")
        if not finite(value) or value<0 or value>24 then return nil end
        local current=value>=18 or value<6
        if current~=nightValue then nightValue,nightAt=current,clock()end
        d.telemetry.night={source="Lighting.ClockTime (client observation)",clockTime=value,candidate=current,stableSeconds=clock()-(nightAt or clock())}
        if clock()-(nightAt or clock())<2 then return nil end
        return current
    end
    local function body(model)
        local part=isA(model,"BasePart") and model or child(model,"HumanoidRootPart") or get(model,"PrimaryPart") or child(model,"Torso")
        if part and vector(get(part,"Position"))then return part end
        for i,p in ipairs(model:GetDescendants())do if i>64 then break end;if isA(p,"BasePart") and vector(get(p,"Position"))then return p end end
    end
    local function fieldAt(position)
        local found
        for _,rule in ipairs(d.rules.fields)do
            local zone=d.field(rule.name)
            if zone and d.access(rule.name)then
                local p=zone.CFrame:PointToObjectSpace(position)
                if math.abs(p.X)<zone.Size.X/2 and math.abs(p.Z)<zone.Size.Z/2 then
                    if found then return nil end
                    found=zone
                end
            end
        end
        return found
    end
    function a.target(maxLevel,monsterOnly)
        local folder=child(world,"Monsters")
        local reason="No loaded accessible Vicious Bee"
        for i,model in ipairs(folder and folder:GetChildren() or {})do
            if i>128 then break end
            local level=tonumber(model.Name:match("Vicious Bee %(Lvl%.? (%d+)%)"))
            if level then
                local part=body(model);local h=model:FindFirstChildOfClass("Humanoid")
                local zone=part and fieldAt(part.Position)
                if maxLevel and level>maxLevel then reason="Vicious level "..level.." exceeds limit "..maxLevel
                elseif zone and (not h or h.Health>0)then
                    -- Ignore the underground model Y; project its X/Z onto this field's floor.
                    local surface=d.ground(Vector3.new(part.Position.X,zone.Position.Y,part.Position.Z),zone)
                    if surface then return {instance=model,part=part,humanoid=h,level=level,name=model.Name,field=zone.Name,zone=zone,position=surface,
                        dormant=part.Position.Y<surface.Y-6}end
                else reason="Vicious field is locked, ambiguous or not loaded"end
            end
        end
        if not monsterOnly then
            local particles=child(world,"Particles")
            for i,part in ipairs(particles and particles:GetChildren() or {})do
                if i>2000 then break end
                if (part.Name=="Vicious" or part.Name=="ViciousBee") and isA(part,"BasePart") and vector(part.Position) and get(part,"Transparency")~=1 then
                    local zone=fieldAt(part.Position)
                    local surface=zone and d.ground(Vector3.new(part.Position.X,zone.Position.Y,part.Position.Z),zone)
                    if surface then return {instance=part,part=part,name="Vicious spawn spike (level unknown)",field=zone.Name,zone=zone,position=surface,spike=true}end
                end
            end
        end
        return nil,reason
    end
    local function planar(a,b)local x,z=a.X-b.X,a.Z-b.Z;return math.sqrt(x*x+z*z)end
    function a.ignoreMonster(model)
        -- The selected encounter must be approachable; other mobs retain their normal exclusion.
        return activeTarget~=nil and not activeTarget.spike and activeTarget.instance==model
    end
    function a.contextIdentity()return activeTarget and activeTarget.instance or nil end
    function a.engagement()
        if not activeTarget then return end
        return {instance=activeTarget.instance,phase=engagementPhase,field=activeTarget.field,zone=activeTarget.zone,
            position=activeTarget.position,preferredRadius=closeRadius,maxDistance=closeLimit}
    end
    local function closePoint(position,goal,activation,hold,escape,routing)
        local target=activeTarget
        if not target or not vector(position) or not vector(target.position)then return end
        local center=target.position
        local function clear(point,geometry)
            return point and planar(point,center)<=closeLimit+0.01 and d.inField(target.zone,point,2) and d.safe(point,point)
                and (routing or math.abs(point.Y-position.Y)<5 and d.safe(position,point)
                    and (not geometry or not d.localMoveClear or d.localMoveClear(position,point)))
        end
        local distance=planar(position,center)
        if hold and distance<=(activation and 2.5 or 12) and (activation or distance>=4) and clear(position,true)then return position end
        work.closeSearches=work.closeSearches+1
        if geometryOwner~=target then geometryOwner,geometryRejected=target,{}end
        local candidates={}
        local function consider(point,key)
            work.closeCandidates=work.closeCandidates+1
            if clear(point,false)then
                local travel=planar(point,position)
                -- Stay close enough to activate/attack, then choose the shortest escape.
                local value=travel+math.abs(planar(point,center)-(activation and 0 or closeRadius))*(escape and 0.15 or 2)
                if goal then value=value+math.min(40,planar(point,goal))*0.03 end
                candidates[#candidates+1]={point=point,score=value,key=key,order=#candidates+1}
            end
        end
        if activation then consider(center,"center")end
        for _,radius in ipairs({4,8,12,16,20,24})do
            for i=0,11 do
                local angle=i*math.pi/6
                consider(center+Vector3.new(math.cos(angle)*radius,0,math.sin(angle)*radius),radius..":"..i)
            end
        end
        table.sort(candidates,function(x,y)return x.score<y.score or x.score==y.score and x.order<y.order end)
        local checked=0
        for _,candidate in ipairs(candidates)do
            local rejected=geometryRejected[candidate.key]
            if not rejected or clock()-rejected>0.4 then
                checked=checked+1;work.closeGeometryChecks=work.closeGeometryChecks+1
                local point=d.ground(candidate.point,target.zone)
                if clear(point,true)then return point end
                geometryRejected[candidate.key]=clock()
                if checked>=6 then break end
            end
        end
    end
    function a.dodgePoint(position,goal)
        if engagementPhase~="activating" and engagementPhase~="fighting"then return end
        if not activeTarget or not vector(position) or planar(position,activeTarget.position)>closeLimit+12 then return end
        if closeDodgeOwner==activeTarget and clock()-closeDodgeAt<0.12 and closeDodgeFrom and planar(position,closeDodgeFrom)<4 then
            -- Cache failed searches too: an all-covered field must not run72 geometry probes every frame.
            if not closeDodge then return end
            if planar(closeDodge,activeTarget.position)<=closeLimit and d.safe(closeDodge,closeDodge) and d.safe(position,closeDodge)then return closeDodge end
        end
        closeDodge,closeDodgeAt,closeDodgeOwner=closePoint(position,goal,false,false,true),clock(),activeTarget
        closeDodgeFrom=position
        return closeDodge
    end
    function a.thorns()
        -- safeSegment is queried repeatedly by navigation and local combat search.
        -- Share one evaluated, read-only snapshot for50ms, not merely its discovery list.
        if clock()-hazardSnapshotAt<0.05 then work.hazardCacheHits=work.hazardCacheHits+1;return hazardSnapshot end
        hazardSnapshotAt=clock();work.hazardBuilds=work.hazardBuilds+1
        local warningRoots,warningScanned=0,0
        if clock()-warningAt>0.05 then
            warnings,warningAt={},clock()
            local particles=child(world,"Particles")
            local seen={}
            local function carrier(indicator)
                if isA(indicator,"BasePart")then return indicator end
                local p=get(indicator,"Parent")
                for _=1,8 do
                    if not p or p==particles then break end
                    if isA(p,"BasePart")then return p end
                    p=get(p,"Parent")
                end
            end
            local function add(indicator)
                if #warnings>=256 then return end
                local p=carrier(indicator)
                if p and not seen[p]then seen[p]=true;warnings[#warnings+1]={part=p,indicator=indicator,warning=true}end
                if not p and isA(indicator,"Model")then
                    for j,part in ipairs(indicator:GetDescendants())do
                        if j>64 then break end
                        if isA(part,"BasePart") and not seen[part]then seen[part]=true;warnings[#warnings+1]={part=part,indicator=indicator,warning=true}end
                    end
                end
            end
            -- WTs may be repeated effect parts, not a single uniquely named folder.
            for i,wts in ipairs(particles and particles:GetChildren() or {})do
                if i>3000 then break end
                if wts.Name:lower()=="wts" or wts.Name:lower()=="warningdisk"then
                    warningRoots=warningRoots+1
                    if wts.Name:lower()=="warningdisk"then add(wts)end
                    for j,p in ipairs(wts:GetDescendants())do
                        warningScanned=warningScanned+1
                        if j>2000 or warningScanned>6000 then break end
                        if p.Name:lower()=="warningdisk"then add(p)end
                    end
                end
                if warningScanned>6000 then break end
            end
            a.warningScan={roots=warningRoots,scanned=warningScanned}
        end
        if clock()-thornAt>0.8 then
            thornAt,thornList=clock(),{}
            local seen={}
            local function add(part,pooled)
                if #thornList>=256 or seen[part] or part.Name~="Thorn" or not isA(part,"MeshPart")then return end
                seen[part]=true;thornList[#thornList+1]={part=part,pooled=pooled}
            end
            for _,name in ipairs({"Particles","Monsters"})do
                local folder=child(world,name)
                for i,part in ipairs(folder and folder:GetDescendants() or {})do if i>8000 then break end;add(part,false)end
            end
            for _,part in ipairs(world:GetChildren())do add(part,false)end
            if nilInstances then
                local ok,parts=pcall(nilInstances)
                d.capabilities.nilThorns=ok and "observed; pooled parts require movement" or "unavailable"
                if ok and type(parts)=="table"then for i,part in ipairs(parts)do if i>12000 then break end;add(part,true)end end
            end
        end
        if not activeTarget and clock()-thornTargetAt>0.5 then thornTarget,thornTargetAt=a.target(nil,true),clock()end
        local target=activeTarget or thornTarget
        local _,_,localRoot=d.character()
        local localPosition=localRoot and get(localRoot,"Position")
        local localZone=vector(localPosition) and fieldAt(localPosition)
        if localZone and math.abs(localPosition.Y-localZone.Position.Y)>35 then localZone=nil end
        -- A remote Vicious can be on another map level. Local warning height follows the player's floor.
        local surfaceY=localZone and localZone.Position.Y+3 or vector(localPosition) and localPosition.Y or target and target.position.Y
        local result={}
        if not surfaceY then hazardSnapshot=result;return result end
        local entries={};for _,e in ipairs(warnings)do entries[#entries+1]=e end
        for _,e in ipairs(thornList)do entries[#entries+1]=e end
        local activeWarnings,records=0,{}
        for _,entry in ipairs(entries)do
            local p=entry.part;local position=get(p,"Position");local size=get(p,"Size")
            local alpha=get(p,"Transparency")
            local visible=finite(alpha) and alpha<0.995
            if entry.warning and not visible then
                local visuals={entry.indicator}
                for j,o in ipairs(p:GetDescendants())do if j>64 then break end;visuals[#visuals+1]=o end
                for _,o in ipairs(visuals)do
                    local transparency=get(o,"Transparency")
                    if (isA(o,"Decal") or isA(o,"Texture")) and finite(transparency) and transparency<0.995 and get(o,"Texture")~=""then visible=true;break end
                    if isA(o,"SurfaceGui") or isA(o,"BillboardGui")then
                        if get(o,"Enabled")~=false then
                            for j,image in ipairs(o:GetDescendants())do
                                if j>32 then break end
                                if get(image,"Visible")~=false and (isA(image,"ImageLabel") or isA(image,"ImageButton")) and (get(image,"ImageTransparency") or 0)<0.995 then visible=true;break end
                            end
                        end
                    end
                    if visible then break end
                end
            end
            if entry.warning and #records<24 then records[#records+1]={carrier=p.Name,class=get(entry.indicator,"ClassName"),alpha=alpha,visual=visible}end
            if vector(position) and vector(size) and visible then
                local old=thornMemo[p]
                local changed=old and ((position-old.position).Magnitude>0.15 or (size-old.size).Magnitude>0.15)
                local velocity=get(p,"AssemblyLinearVelocity")
                local moving=changed or not entry.pooled and vector(velocity) and velocity.Magnitude>0.5
                local lastMotion=moving and clock() or old and old.lastMotion or -math.huge
                thornMemo[p]={position=position,size=size,lastMotion=lastMotion}
                local reference=vector(localPosition) and localPosition or target and target.position
                local dx,dz=position.X-reference.X,position.Z-reference.Z
                local vertical=entry.warning and math.min(size.X,size.Y,size.Z)/2 or size.Y/2
                if dx*dx+dz*dz<14400 and position.Y+vertical>surfaceY-12 and position.Y-vertical<surfaceY+12
                    and (not entry.pooled and p:IsDescendantOf(world) or entry.pooled and clock()-lastMotion<0.8)then
                    local _,humanoid=d.character()
                    local reaction=humanoid and finite(humanoid.WalkSpeed) and math.min(5,humanoid.WalkSpeed*0.12) or 2
                    local radius=entry.warning and math.min(32,math.max(4,math.max(size.X,size.Y,size.Z)/2+2+reaction)) or math.min(10,math.max(3,math.max(size.X,size.Z)/2+2))
                    if entry.warning then activeWarnings=activeWarnings+1 end
                    result[#result+1]={position=Vector3.new(position.X,surfaceY,position.Z),radius=radius,name=entry.warning and "Vicious WarningDisk" or "Vicious Thorn",early=entry.warning or nil}
                end
            end
        end
        d.telemetry.thorns={observed=#thornList,active=#result,warningDisks=#warnings,activeWarnings=activeWarnings,scan=a.warningScan,records=records}
        hazardSnapshot=result
        return result
    end
    function a.save(state)
        if teleports and get(teleports,"SetTeleportSetting")then
            local stopped=false;if not state.active then stopped=state.started end
            pcall(function()teleports:SetTeleportSetting("TaloHuntStopped",stopped)end)
        end
        if not d.writefile then return false,"writefile unavailable"end
        local ok,why=pcall(function()d.writefile(checkpointPath,d.http:JSONEncode(state))end)
        return ok,why
    end
    function a.prepare()
        if not request or not queue or not d.writefile or not d.readfile or not d.api("loadstring") or not teleports then return false,"Hunt needs request, queueonteleport, readfile/writefile, loadstring and TeleportService"end
        local source=d.source
        if type(source)~="string"then local ok,value=pcall(d.readfile,sourcePath);if ok then source=value end end
        if type(source)~="string" or #source>8000000 or not source:find("Talo runtime requires the Bee Swarm client",1,true)then return false,"Run the entire dist bundle once to install local autoload (maximum 8 MB local source)"end
        local ok,why=pcall(function()d.writefile(sourcePath,source);assert(d.readfile(sourcePath)==source,"Autoload source read-back mismatch")end)
        if ok then d.capabilities.huntAutoload="local source saved and verified; next hop pending"end
        return ok,why
    end
    local function guiVisible(o)
        for _=1,32 do
            if not o then return true end
            if get(o,"Visible")==false or (isA(o,"ScreenGui") and get(o,"Enabled")==false)then return false end
            o=get(o,"Parent")
        end
        return false
    end
    local function readTeleportPrompt()
        local roots={}
        local ok,core=pcall(function()return game:GetService("CoreGui")end)
        local promptGui=ok and child(core,"RobloxPromptGui")
        if promptGui then roots[#roots+1]=promptGui end
        local pg=player.FindFirstChildOfClass and player:FindFirstChildOfClass("PlayerGui") or child(player,"PlayerGui")
        if pg then roots[#roots+1]=pg end
        for _,container in ipairs(roots)do
            for i,root in ipairs(container:GetDescendants())do
                if i>3000 then break end
                local name=root.Name:lower()
                if (name=="errorprompt" or name=="teleportprompt" or name=="teleportfailed") and guiVisible(root)then
                    local title,message,button=false,{},nil
                    for j,o in ipairs(root:GetDescendants())do
                        if j>250 then break end
                        if guiVisible(o)then
                            local text=get(o,"Text")
                            if type(text)=="string"then
                                local plain=text:gsub("<[^>]+>","")
                                if plain:lower():gsub("%s+","")=="teleportfailed"then title=true end
                                message[#message+1]=plain:sub(1,400)
                                if isA(o,"GuiButton") or isA(o,"TextButton")then
                                    local caption=plain:lower():gsub("%s+","")
                                    if caption=="ok" and get(o,"Interactable")~=false then button=o end
                                end
                            end
                        end
                    end
                    local text=table.concat(message," | "):sub(1,1200)
                    if title and button and (text:lower():find("teleport",1,true))then
                        local path=root.GetFullName and root:GetFullName() or root.Name
                        return {root=root,button=button,text=text,path=path}
                    end
                end
            end
        end
    end
    function a.teleportPrompt()
        local ok,prompt=pcall(readTeleportPrompt)
        if not ok then
            d.capabilities.teleportPrompt="read unavailable: "..tostring(prompt):sub(1,180)
            return nil
        end
        if prompt then d.capabilities.teleportPrompt="recognized engine Teleport Failed / Ok"end
        return prompt
    end
    function a.recoverTeleportPrompt(cancelled)
        local job={status="running"}
        local deadline=clock()+6
        local function finish(status,reason)
            if job.status~="running"then return end
            job.status,job.reason=status,reason
        end
        function job.cancel()finish("cancelled","Teleport prompt recovery stopped")end
        task.spawn(function()
            local ok,why=pcall(function()
                local attempts,lastClick,seen=0,-math.huge,false
                while job.status=="running" and not cancelled() and clock()<deadline do
                    local prompt=a.teleportPrompt()
                    if not prompt then finish("success",seen and "Teleport Failed popup dismissed" or "Teleport popup already closed");return end
                    seen=true
                    if attempts<3 and clock()-lastClick>=0.7 then
                        if not d.clickTeleportPrompt then finish("failed","Teleport Failed popup needs a supported scoped Ok input");return end
                        local sent,reason=d.clickTeleportPrompt(prompt.button,prompt.root)
                        attempts=attempts+1;lastClick=clock()
                        d.event("hunt_prompt_dismiss",{ok=sent,path=prompt.path,text=prompt.text,reason=reason,attempt=attempts})
                        if not sent then finish("failed","Teleport prompt input rejected: "..tostring(reason));return end
                    end
                    task.wait(0.1)
                end
                finish(cancelled() and "cancelled" or "failed",cancelled() and "Teleport prompt recovery stopped" or "Teleport Failed popup did not close after bounded Ok input")
            end)
            if not ok then finish("failed",tostring(why))end
        end)
        return job
    end
    function a.hop(state,cancelled)
        local job={status="running"};local connection,attempted
        local deadline=clock()+30
        local function close(status,reason)
            if job.status=="running"then job.status,job.reason=status,reason end
            if connection then connection:Disconnect();connection=nil end
        end
        function job.cancel()close("cancelled","Hop cancelled");state.pendingServer=nil;a.save(state)end
        task.spawn(function()
            local ok,why=pcall(function()
                local function valid()return job.status=="running" and not cancelled() and clock()<deadline end
                local cursor,chosen=nil,nil
                for _=1,6 do
                    if not valid()then return end
                    local url="https://games.roblox.com/v1/games/1537690962/servers/Public?sortOrder=Asc&excludeFullGames=true&limit=100"
                    if cursor then url=url.."&cursor="..d.http:UrlEncode(cursor)end
                    local response=request({Url=url,Method="GET"})
                    if not valid()then return end
                    if type(response)~="table" or response.StatusCode~=200 or type(response.Body)~="string" or #response.Body>2000000 then error("Public-server HTTP response invalid: "..tostring(type(response)=="table" and response.StatusCode))end
                    local page=d.http:JSONDecode(response.Body)
                    chosen=d.serverHop.select(page,game.JobId,state.visited,os.time())
                    if chosen then break end
                    cursor=type(page.nextPageCursor)=="string" and #page.nextPageCursor<1024 and page.nextPageCursor or nil
                    if not cursor then break end
                end
                if not chosen then error("No unvisited 1–3-player server in six pages")end
                if not valid()then return end
                for id,at in pairs(state.visited)do if type(at)~="number" or os.time()-at>1800 then state.visited[id]=nil end end
                local ordered={};for id,at in pairs(state.visited)do ordered[#ordered+1]={id=id,at=at}end
                table.sort(ordered,function(x,y)return x.at<y.at end)
                for i=1,math.max(0,#ordered-250)do state.visited[ordered[i].id]=nil end
                state.visited[game.JobId]=os.time();state.visited[chosen]=os.time()
                state.pendingServer,state.hops=chosen,state.hops+1
                state.resumeUntil=os.time()+600 -- Delivery freshness only; the hunt itself has no expiry.
                local saved,saveWhy=a.save(state);if not saved then error(saveWhy)end
                if not queued then queue(d.serverHop.loader(checkpointPath,sourcePath));queued=true end
                if not valid()then return end
                if get(teleports,"TeleportInitFailed")then
                    connection=teleports.TeleportInitFailed:Connect(function(who,result,reason)
                        if who~=player then return end
                        local text=tostring(result).." "..tostring(reason)
                        local full=text:lower():find("full",1,true)~=nil
                        job.failureKind=full and "server_full" or "teleport_failed"
                        state.pendingServer=nil
                        state.visited[chosen]=os.time()
                        a.save(state)
                        d.event("hunt_join_failed",{kind=job.failureKind,result=tostring(result),reason=tostring(reason)})
                        close("failed",full and "Server filled before join; choosing another 1–3-player server" or "Teleport failed: "..text)
                    end)
                end
                d.event("hunt_teleport",{hop=state.hops,reason="Searching for night/Vicious; local autoload queued"})
                attempted=true
                teleports:TeleportToPlaceInstance(game.PlaceId,chosen,player)
                while valid()do task.wait(0.1)end
                if job.status=="running"then close("failed",cancelled() and "Hop cancelled" or "Teleport not acknowledged within 30 seconds")end
            end)
            if not ok then
                job.failureKind=tostring(why):lower():find("full",1,true) and "server_full" or attempted and "teleport_failed" or "request_failed"
                state.pendingServer=nil;a.save(state)
                d.event("hunt_join_failed",{kind=job.failureKind,reason=tostring(why)})
                close("failed",tostring(why))
            end
            if job.status=="running"then close("failed","Hop deadline/cancellation")end
        end)
        task.spawn(function()
            while job.status=="running" and clock()<deadline and not cancelled()do task.wait(0.1)end
            if job.status=="running"then close("failed",cancelled() and "Hop cancelled" or "HTTP/teleport deadline; late results ignored")end
        end)
        return job
    end
    function a.fight(target,cancelled)
        local job={status="running"};local walk;activeTarget,engagementPhase=target,"approaching"
        local initialCharacter=d.character()
        local function finish(status,reason)
            if job.status~="running"then return end
            job.status,job.reason=status,reason
            if walk and walk.status=="running"then walk.cancel()end
            if activeTarget==target then activeTarget,engagementPhase=nil,nil end
