        for _,edge in ipairs(data.edges)do
            if used and(used[edge.id]or used[edge.name]or used[edge.physicalId])then blocked[edge.id]=true end
            if scoped and(edge.kind=="cannon"or edge.kind=="glide")then
                -- A failed scoped flight must not become a tour of the ordinary launcher graph.
                local royal=edge.kind=="cannon"and edge.name=="Red Cannon"and edge.requiresRouteScope==c.routeScope
                    and type(edge.physics)=="table"and edge.physics.mode=="cannon_glide"
                if not royal or not cannonUsable then blocked[edge.id]=true end
            end
        end
