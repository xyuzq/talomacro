        s.facts["hive.cells"]=fact(bees,"matching owned cells and account-bound Honeycomb cache",math.min(at,cacheAt),true,"complete_owned_cells")

        s.facts["hive.occupiedCells"]=fact(#bees,"matching owned cells / cache count",math.min(at,cacheAt),true)

        levels(s,bees,true,math.min(at,cacheAt))

    else s.warnings[#s.warnings+1]="Owned cell coverage or account-bound cache is incomplete; counts and levels withheld" end

    if c.cacheAccountMatched==true and type(cache.Eggs)=="table" then

        for name,amount in pairs(cache.Eggs) do

            if identifier(name) and whole(amount) then

                s.inventory[name]=amount;s.facts["inventory."..name]=fact(amount,"ClientStatCache.Eggs."..name,cacheAt)

            end

        end

        s.facts["inventory.coverage"]=fact("explicit_entries_only","account-bound ClientStatCache.Eggs",cacheAt)

    end

    local rt=s.runtime

    if finite(rt.honey) and rt.honey>=0 then s.inventory.Honey=rt.honey;s.facts["inventory.Honey"]=fact(rt.honey,"CoreStats.Honey",at) end

    if c.cacheAccountMatched==true then

        owned(s,"gear.ownedCollectors",cache.Collectors,"ClientStatCache.Collectors",cacheAt)

        owned(s,"gear.ownedContainers",cache.Accessories,"ClientStatCache.Accessories (observed owned identifiers)",cacheAt)

        owned(s,"gear.ownedAccessories",cache.Accessories,"ClientStatCache.Accessories (complete owned accessory identifiers)",cacheAt)

        local p=cache.EquippedParachute

        if p=="Glider" or p=="Parachute" then s.facts["gear.movementOwned"]=fact(true,"ClientStatCache.EquippedParachute",cacheAt) end

    end

    if type(c.farmCycleAccepted)=="boolean" then s.facts["capabilities.farmCycleAccepted"]=fact(c.farmCycleAccepted==true and not historical,"current-version native cycle evidence",at,true) end

    s.quests=tableOf(c.quests)

    if c.questPortfolioComplete==true then s.facts["quests.portfolioObserved"]=fact(true,"exact active quest list and supported objective mapping",at,true) end

    return s

end

function State.fromNormalized(n,context)

    local data=tableOf(n);local c=context or {};local at=data.capturedAtUnix

    local s=base(c,at,true) -- A file never becomes live because it was read now.

    s.placeId,s.placeVersion=data.placeId,data.placeVersion

    local function map(key,input,derived)

        s.facts[key]=copyFact(input,"normalized historical observation",at,derived)

    end

    local hive=tableOf(data.hive);local ownership=tableOf(hive.ownership)

    if ownership.status=="observed" and type(ownership.value)=="boolean" then

        map("hive.ownership",{status="observed",value=ownership.value and "owned" or "unclaimed",source=ownership.source,observedAtUnix=ownership.observedAtUnix})

    end

    local complete=hive.cellsCoverage=="bounded_tree_complete" and ownership.status=="observed" and ownership.value==true

    local cellsLength=dense(hive.cells,50)

    local count=evidenceValue(hive.beeCount)

    complete=complete and cellsLength~=nil and whole(count) and count<=50

    local bees,seen={},{}

    local oldestAt=at

    local function older(input)

        local t=type(input)=="table" and (input.observedAtUnix or input.observedAt)

        if finite(t) then oldestAt=finite(oldestAt) and math.min(oldestAt,t) or t end

    end

    older(ownership);older(hive.beeCount)

    if complete then

        for index=1,cellsLength do

            local cell=hive.cells[index]

            if type(cell)~="table" then complete=false;break end

            local occupancy=evidenceValue(cell.occupancy)

            local grid=tableOf(evidenceValue(cell.grid))

            local validGrid=whole(grid.x) and grid.x>=1 and grid.x<=5 and whole(grid.y) and grid.y>=1 and grid.y<=10

            local gridKey=validGrid and (grid.x..":"..grid.y)

            if not validGrid or seen[gridKey] or (grid.cellId~=nil and grid.cellId~=(grid.y-1)*5+grid.x-1) or (occupancy~="occupied" and occupancy~="empty") then complete=false;break end

            seen[gridKey]=true;older(cell.grid);older(cell.occupancy)

            if occupancy=="occupied" then

                local kind=evidenceValue(cell.beeType)

                local label=type(kind)=="string" and kind:match("^(.+)Bee$")

                local cached=evidenceValue(cell.cacheType)

                if not identifier(label) or (cached~=nil and cached~=label) then complete=false;break end

                local level=evidenceValue(cell.level)

                local gifted=evidenceValue(cell.gifted)

                local bee={x=grid.x,y=grid.y,type=label,level=whole(level) and level>=1 and level or nil}

                if type(gifted)=="boolean" then bee.gifted=gifted end

                bees[#bees+1]=bee

                older(cell.beeType);older(cell.level);older(cell.gifted);older(cell.cacheType)

            end

        end

    end

    complete=complete and #bees==count

    if complete then

        s.facts["hive.occupiedCells"]=fact(count,"normalized complete owned cells / corroborated count",oldestAt,true,"complete_owned_cells")

        s.facts["hive.cells"]=fact(bees,"normalized complete owned cells",oldestAt,true,"complete_owned_cells")

        levels(s,bees,true,oldestAt)

    else s.warnings[#s.warnings+1]="Normalized owned cell coverage/count is incomplete or inconsistent; counts and levels withheld" end

    local inv=tableOf(data.inventory)

    for name,item in pairs(tableOf(inv.items)) do

        if identifier(name) and type(item)=="table" then

            if item.status=="observed" and whole(item.value) then

                map("inventory."..name,item);s.inventory[name]=item.value

            elseif item.status=="observed" then s.facts["inventory."..name]=fact(nil,item.source or "normalized inventory",item.observedAtUnix or at)

            else map("inventory."..name,item) end

        end

    end

    if inv.status=="partial" or inv.status=="observed" then

        s.facts["inventory.coverage"]=fact("explicit_entries_only","normalized inventory",at)

    end

    local honey=tableOf(tableOf(data.currency).honey)

    if honey.status=="observed" and whole(honey.value) then map("inventory.Honey",honey);s.inventory.Honey=honey.value

    else s.facts["inventory.Honey"]=fact(nil,honey.source or "normalized Honey",honey.observedAtUnix or at) end

    local gear=tableOf(data.gear);local equipment=tableOf(gear.owned)

    for _,row in ipairs({{"gear.ownedCollectors","collectors"},{"gear.ownedContainers","accessories"},{"gear.ownedAccessories","accessories"}}) do

        local item=tableOf(equipment[row[2]])

        if item.status=="observed" or (item.status=="derived" and item.validated==true) then

            owned(s,row[1],item.value,item.source or ("normalized owned "..row[2]),item.observedAtUnix or item.observedAt or at)

        end

    end

    local p=tableOf(tableOf(gear.equipped).parachute)

    if p.status=="observed" and (p.value=="Glider" or p.value=="Parachute") then map("gear.movementOwned",{value=true,status="derived",source=p.source,observedAtUnix=p.observedAtUnix},true) end

    local discovery=tableOf(data.giftedDiscovery)

    if discovery.count then map("hive.historicalGiftedTypeCount",discovery.count,true) end

    for _,f in ipairs(tableOf(data.fields)) do

        if type(f)=="table" and identifier(f.name) then

            local access=tableOf(f.access);local meta=tableOf(f.metadata)

            local accessible=nil;if access.status=="observed" and type(access.value)=="boolean" then accessible=access.value end

            local color=evidenceValue(meta.ColorGroup)

            s.fields[#s.fields+1]={name=f.name,accessible=accessible,usable=nil,

                color=type(color)=="string" and color or nil,reason="Historical geometry; live route acceptance unavailable",observedAt=at}

        end

    end

    for _,q in ipairs(tableOf(evidenceValue(tableOf(data.quests).active))) do

        local objectives={}

        for _,row in ipairs(tableOf(tableOf(q.objectives).value)) do

            local raw,source,stamp={},{},nil

            for name,item in pairs(tableOf(row.fields)) do

                if type(item)=="table" and item.status=="observed" then raw[name]=item.value;stamp=stamp and math.min(stamp,item.observedAtUnix or at) or item.observedAtUnix or at;source[#source+1]=item.source or "quest definition" end

            end

            local o=State.objective(raw,table.concat(source,"; "),stamp or at)

            if o then objectives[#objectives+1]=o end -- Inferred counters intentionally do not become current progress.

        end

        s.quests[#s.quests+1]={name=q.name,objectives=objectives}

    end

    local bag=tableOf(data.bag)

    for _,row in ipairs({{"bagFraction",bag.fillRatio},{"honey",honey},{"pollen",bag.pollen},{"capacity",bag.capacity},{"health",tableOf(data.character).health}}) do

        local amount=evidenceValue(row[2]);s.runtime[row[1]]=finite(amount) and amount>=0 and amount or nil

    end

    s.warnings[#s.warnings+1]="Historical capture: no action can use this file as fresh inventory or capability evidence"

    return s

end

return State


end)()

local Ledger=(function()
-- Pure account-bound reservations and transaction journal. No game or file APIs.
-- Times are absolute seconds supplied by the caller (use the same clock after reload).
