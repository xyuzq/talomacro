local function fieldYield(field,settings)
    local yield=TIER_YIELD[field.bees] or 1
    if field.color~=nil and field.color~="mixed" and field.color==settings.targetMode then yield=yield*1.3 end -- Hive colour bonus.
    return yield
end
local function rankFields(snapshot,settings,now)
    local out,seen={},{}
    for _,field in ipairs(snapshot.fields or {}) do
        if type(field)=="table" and type(field.name)=="string" and field.name~="" and not seen[field.name]
            and field.accessible==true and field.usable~=false then
            seen[field.name]=true
            local overlap,unknownObjectives,value=0,0,0
            for _,entry in ipairs(objectives(snapshot.quests)) do
                local objective,weight=entry.objective,entry.weight
                if type(objective)=="table" then
                    local observed=objective.status=="observed" or objective.status=="derived" and objective.validated==true
                    local fresh=finite(objective.observedAt) and objective.observedAt<=now+5 and now-objective.observedAt<=settings.maxFactAgeSeconds
                    local provenance=type(objective.source)=="string" and objective.source~=""
                    local fieldMatch=(objective.kind=="field_pollen" or objective.kind=="goo") and objective.field==field.name
                    local colorMatch=objective.kind=="color_pollen" and type(objective.color)=="string" and (objective.color==field.color or field.color=="mixed")
                    local share=objective.kind=="color_pollen" and field.color=="mixed" and 1/3 or 1
                    local target=objective.target
                    local remaining=objective.remaining
                    if not finite(remaining) and finite(target) and finite(objective.current) then remaining=math.max(0,target-objective.current) end
                    if observed and fresh and provenance and (fieldMatch or colorMatch) and finite(target) and target>0 and finite(remaining) and remaining>0 then
                        overlap=overlap+math.min(1,remaining/target)*share
                        -- Nearly finished and small objectives are worth more: finishing a quest unlocks its reward and the next quest.
                        value=value+weight*share*(1+2*math.max(0,1-remaining/target)+1.5*math.min(1,2000000/remaining))
                    elseif observed and fresh and provenance and (fieldMatch or colorMatch) and finite(target) and target>0
                        and remaining==nil and objective.progressStatus=="unknown" then
                        -- A current accepted definition gives direction, never a completion amount or ETA.
                        overlap=overlap+0.15*share;value=value+0.15*share*weight;unknownObjectives=unknownObjectives+1
                    end
                end
            end
            local travel=finite(field.travelSeconds) and math.max(0,field.travelSeconds) or 0
            local material=finite(field.materialWeight) and math.max(0,math.min(1,field.materialWeight)) or 0
            local extra=finite(field.questWeight) and math.max(0,math.min(1,field.questWeight)) or 0
            local yield=fieldYield(field,settings)
            -- Badge progress is a small tie-breaker (user: farm toward badges, but not as a priority).
            local badge=finite(field.badgeWeight) and math.max(0,math.min(1,field.badgeWeight))*0.3 or 0
            local score=yield*(1+4*value+material+extra+badge)/(30+travel)
            out[#out+1]={name=field.name,score=score,questOverlap=overlap,questValue=value,yield=yield,badgeWeight=badge>0 and badge or nil,unknownProgressObjectives=unknownObjectives,travelSeconds=travel,usable=field.usable,
                reason=unknownObjectives>0 and "Accessible field overlaps current accepted quest definitions; remaining amounts and ETA are unknown"
                    or overlap>0 and "Accessible field advances observed outstanding quest objectives" or "Accessible background field; no confirmed quest overlap"}
        end
    end
    table.sort(out,function(a,b)return a.score>b.score or a.score==b.score and a.name<b.name end)
    return out
end

function Planner.new(policy,input,dependencies)
    assert(type(policy)=="table" and policy.schemaVersion=="talo.progression-policy/1","Expected progression policy v1")
    local settings=resolveSettings(policy,input)
    local self={settings=settings,policy=policy}
    local Development=type(dependencies)=="table" and dependencies.Development or nil
