end
-- A Stop or interruption during a spend leaves its transaction uncertain, which blocks every later spend (native
-- v0.14.38: one Royal Jelly roll stopped all rolling). Settle it from a fresh RetrievePlayerStats read: whatever the
-- server did is in that inventory, and planning restarts from it. A "sent" one counts only once no job could own it.
local reconciling=false
local function reconcileUncertain()
    if reconciling or not ledger or not ledger:hasUncertain() then return end
    reconciling=true
    task.spawn(function()
        local ok,data=pcall(function()return child(child(Storage,"Events"),"RetrievePlayerStats"):InvokeServer()end)
        reconciling=false
        if closed or not ok or type(data)~="table" or not ledger then return end
        local now,eggs=os.time(),type(data.Eggs)=="table" and data.Eggs or {}
        local settled=0
        for id,tx in pairs(ledger:export().transactions)do
            if tx.state=="uncertain_after_send" or tx.state=="sent" and type(tx.sentAt)=="number" and now-tx.sentAt>900 then
                local inventory={}
                for resource in pairs(tx.amounts)do
                    local v=tonumber(resource=="Honey" and data.Honey or eggs[resource] or 0) or 0
                    inventory[resource]=math.max(0,math.floor(v))
                end
                if ledger:reconcile(id,"confirmed",{accountId=account,verified=true,source="RetrievePlayerStats auto-reconcile",
                    observedAt=now,transactionId=id,inventory=inventory},now) then settled=settled+1 end
            end
        end
        if settled>0 and type(writefile)=="function" then pcall(writefile,prefix.."journal-"..account..".json",Json.encode(ledger:export()))end
    end)
end
