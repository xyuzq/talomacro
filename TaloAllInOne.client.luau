                    -- cannot hover by receiving a zero Move direction.
                    deps.steer(horizontal>2 and goal or nil)
                elseif options.landingDescent and deployed then
                    local proof,why=options.landingDescent(part.Position,velocity,goal)
                    if proof then
                        if not valid()then return finish(false,"Cancelled before early landing close",part)end
                        local ok,reason=(deps.close or deps.space)(cancelled,.015)
                        if not ok then return finish(false,reason,part)end
                        record.closeInputPulses=record.closeInputPulses+1;record.inputPulses=record.inputPulses+1
                        deployed=false;record.descentClose=proof;record.closeY=part.Position.Y;record.closeHeight=proof.height
