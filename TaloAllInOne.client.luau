        end
        function job.cancel()finish("cancelled","Vicious combat cancelled")end
        task.spawn(function()
            local ok,why=pcall(function()
                local deadline=clock()+240;local before=a.stingers();local confirmed=false;local goneAt
                local function valid()local model,h,r=d.character();return job.status=="running" and not cancelled() and clock()<deadline and model==initialCharacter and r and h and h.Health>0 end
                local function updateSurface()
                    local position=target.part and get(target.part,"Position")
                    if vector(position)then
                        local surface=d.ground(Vector3.new(position.X,target.zone.Position.Y,position.Z),target.zone)
                        if surface and d.inField(target.zone,surface,1)then target.position=surface end
                    end
