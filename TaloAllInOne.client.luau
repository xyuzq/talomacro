              end
              for _,action in ipairs(definition.preferredActions or {}) do
                -- Conversion comes only from the bag threshold above; a goal row once sent an almost empty bag home.
                if (action~="gather" and action~="travel" or bestField) and action~="convert" then
                    propose(action,row.id,action=="gather" and 50 or action=="quest_claim" and 30 or 50,
                        row.title..": "..row.reason,(action=="gather" or action=="travel") and bestField and bestField.name or nil,
                        action=="gather" and bestField and bestField.score or 0)
                end
              end
            end
        end
