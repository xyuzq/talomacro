                        end
                        return {status="running",cancellable=true,reason="Waiting for main macro job status"}
                    end
                    job.pollFailures=0
                    local out=plain(result)
                    if out.status=="success" or out.status=="failed" or out.status=="uncertain" then job.terminal=true;active=nil
                    elseif out.status~="running" then out.status="running" end
