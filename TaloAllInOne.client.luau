local HiveAudit=(function()
-- Base-role and protection audit. Reference abilities never authorize a reroll or feeding.
local HiveAudit={}
local roleMap={Focus="focus",Haste="haste",["Haste+"]="haste",Melody="melody",["Baby Love"]="baby_love",
    ["Honey Mark"]="marks",["Honey Mark+"]="marks",["Pollen Mark"]="marks",["Pollen Mark+"]="marks",
    ["Red Boost"]="red_boost",["Blue Boost"]="blue_boost",["Token Link"]="token_link",Rage="rage",["Rage+"]="rage"}
