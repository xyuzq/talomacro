                if not valid()or walk.status~="success"then finish("failed","Vicious surface approach failed");return end
                engagementPhase="activating"
                if target.spike or target.dormant then
                    local waitUntil=clock()+12
                    local startingHealth=target.humanoid and get(target.humanoid,"Health")
                    while valid() and clock()<waitUntil do
