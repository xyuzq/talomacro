        BackgroundColor3=Color3.fromRGB(13,19,29),BorderSizePixel=0,ScrollBarThickness=5,CanvasSize=UDim2.fromOffset(0,284)},panel)
    local body=text("InspectionBody","Observing…",10,9,688,266,12,scroll)
