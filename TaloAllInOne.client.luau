local function selectColor(snapshot,settings,policy,now)
    if COLORS[settings.targetMode] then
        return settings.targetMode,{reason="Requested final color retained; no temporary funding color is selected",confidence="configured",resolved=true}
    end
    local read=reader(snapshot,settings,now,nil,false)
    local observed=read("profile.selectedColor")
    if COLORS[observed] then return observed,{reason="Retaining the current observed Auto selection",confidence="observed",resolved=true} end
    local evidence=read("profile.colorEvidence")
    if type(evidence)~="table" then return nil,{reason="Auto remains mixed until measured performance, transition cost, gear, roles, materials and driver evidence are available",confidence="unknown",resolved=false} end
    local ranked={}
    for _,color in ipairs({"blue","red","white"}) do
        local e=evidence[color]
        if type(e)=="table" then
            local score,valid=1,true
            for _,key in ipairs({"engineCoverage","gearCoverage","questReadiness","materialReadiness","driverReliability"}) do
                local n=e[key]
                if not finite(n) or n<0 or n>1 then valid=false;break end
                score=math.min(score,n)
            end
            if not finite(e.measuredHoneyPerSecond) or e.measuredHoneyPerSecond<=0 or not finite(e.transitionCostSeconds) or e.transitionCostSeconds<0 then valid=false end
            if valid and score>=0.6 then
                ranked[#ranked+1]={color=color,score=e.measuredHoneyPerSecond*score/(1+e.transitionCostSeconds/3600)}
            end
        end
    end
    table.sort(ranked,function(a,b)return a.score>b.score or a.score==b.score and a.color<b.color end)
    local best,runner=ranked[1],ranked[2]
    if not best or #ranked<2 then return nil,{reason="Auto lacks comparable measured evidence for at least two viable colors",confidence="unknown",resolved=false} end
    local improvement=policy.autoSelection.minimumImprovementFraction or 0.25
    if best.score<runner.score*(1+improvement) then return nil,{reason="Auto candidates are too close; keeping the mixed build instead of switching on RNG",confidence="insufficient_margin",resolved=false} end
    return best.color,{reason="Coherent measured multi-signal evidence clears the configured improvement margin",confidence="measured",resolved=true,recommendation=best.color,scores=ranked}
end
