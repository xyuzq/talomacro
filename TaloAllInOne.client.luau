    events[#events + 1] = entry
    if kind~="navigation_path" and kind~="navigation_result" and kind~="route_plan" and kind~="surface_search" and kind~="token_detour" and kind~="road_learned"then
        notices[#notices+1]=entry;if #notices>80 then table.remove(notices,1)end
    end
