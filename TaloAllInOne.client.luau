local function available(snapshot,resource,now)

    local n=fact(snapshot,"inventory."..resource,now)

    if not quantity(n) or type(snapshot.inventory)~="table" or snapshot.inventory[resource]~=n then return nil,"Fresh observed inventory is missing: "..resource end

    local journal=snapshot.ledger

    if journal~=nil then

        if type(journal)~="table" or journal.schemaVersion~="talo.progression-ledger/1" or journal.accountId~=snapshot.accountId then return nil,"Reservation journal identity/schema is unknown" end

        local balance=type(journal.balances)=="table" and journal.balances[resource]

        if balance then

            if not quantity(balance.value) then return nil,"Invalid settled balance" end

            n=math.min(n,balance.value)

        end

        local protected=type(journal.protectedMinimums)=="table" and journal.protectedMinimums[resource] or 0

        if not quantity(protected) then return nil,"Invalid protected resource budget" end

        n=n-protected

        for _,reservation in pairs(type(journal.reservations)=="table" and journal.reservations or {})do

            local amount=type(reservation)=="table" and type(reservation.amounts)=="table" and reservation.amounts[resource] or 0

            if not quantity(amount)then return nil,"Invalid resource reservation"end

            n=n-amount

        end

    end

    return math.max(0,n)

end

function EconomyCatalog.assess(snapshot,request,now)

