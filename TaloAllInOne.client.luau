            for i,raw in ipairs(edge.points)do
                local source=vector(raw.position or raw.Position or raw)
                if not source or c.cancelled()then return false,"Invalid or cancelled ground template"end
                local point=source
                if i>1 and i<#edge.points and(source-b).Magnitude>.1 then
                    local actual=d.projectWalkPoint(source,c.cancelled)
                    local projected=vector(actual)
                    if not projected or math.abs(projected.X-source.X)>.05 or math.abs(projected.Z-source.Z)>.05 or math.abs(projected.Y-source.Y)>16 then
                        return false,{reason=string.format("Captured walking waypoint has no nearby live surface at %.1f, %.1f, %.1f",source.X,source.Y,source.Z),
                            from={x=source.X,y=source.Y,z=source.Z},to={x=source.X,y=source.Y,z=source.Z},action="Walk",
                            support={code="UNPROJECTABLE_SCOPED_WAYPOINT",actual=projected and{x=projected.X,y=projected.Y,z=projected.Z}or nil}}
                    end
                    if math.abs(projected.Y-source.Y)>.1 then
                        c.walkRepairs=c.walkRepairs or{}
                        if #c.walkRepairs<16 then c.walkRepairs[#c.walkRepairs+1]={kind="live internal ground projection",
                            from={x=source.X,y=source.Y,z=source.Z},to={x=projected.X,y=projected.Y,z=projected.Z}}end
                    end
                    point=projected
                end
                routePoints[i]={position=point,action=raw.action or raw.Action or"Walk"}
            end
        end
        local function append(checked)
            -- Join the incoming checked walk directly to a small repaired takeoff.
            -- Otherwise visiting the raw rim first would create an avoidable retreat.
            local jump=checked[#checked]
            local current,before=points[#points],points[#points-1]
            if before and current.Action==Enum.PathWaypointAction.Walk and jump.Action==Enum.PathWaypointAction.Jump
                and jump.Takeoff and #checked>=2 and not c.cancelled()then
                local takeoff=vector(jump.Takeoff)
                local shift=takeoff and(takeoff-current.Position).Magnitude
                local prefixWalk=true
                for i=1,#checked-1 do
                    local action=checked[i].Action
                    if action~=nil and action~=Enum.PathWaypointAction.Walk and action~="Walk"then prefixWalk=false;break end
                end
                if prefixWalk and shift and shift>=0.1 and shift<=3.001 and(takeoff-before.Position).Magnitude<=24 then
                    local joined=d.surfacePath(before.Position,takeoff,c.cancelled,1,true)
                    local allWalk=type(joined)=="table"and #joined>=2
                    if allWalk then for _,point in ipairs(joined)do
                        if point.Action~=nil and point.Action~=Enum.PathWaypointAction.Walk and point.Action~="Walk"then allWalk=false;break end
                    end end
