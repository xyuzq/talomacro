    local out={schemaVersion="talo.hive-audit/1",status="unknown",source=catalog.source or "Unmapped catalogue",observedAt=f and f.observedAt,
        roleCounts={},possibleRoleCounts={},missingRoles={},protectedCells={},reviewCandidates={},typeCounts={},colorCounts={},
        giftedTypeCount=0,giftedUnknown=0,limitations={"Base bee roles only; beequips, token uptime, mutations and combat performance require separate inspection"}}
    local valid=type(f)=="table" and f.status=="derived" and f.validated==true and f.coverage=="complete_owned_cells"
        and type(f.value)=="table" and type(f.source)=="string" and finite(f.observedAt)
    if not valid then out.reason="Complete corroborated owned cells are required";return out end
    if catalog.placeId~=snapshot.placeId or catalog.placeVersion~=snapshot.placeVersion then
        out.reason="Bee catalogue does not match the captured place/version";return out
    end
    out.coverage=f.coverage
    local historical=snapshot.historical==true or snapshot.source~="live_observation" or not finite(now) or f.observedAt>now or now-f.observedAt>15
    out.status=historical and "historical" or "observed"
    local bees=f.value;local giftedTypes,beeRoles,possibleByBee,grid={}, {}, {}, {}
    local allKnown=true
    for i,b in ipairs(bees) do
        if type(b)~="table" or type(b.type)~="string" or not finite(b.x) or not finite(b.y) or b.x%1~=0 or b.y%1~=0
            or b.x<1 or b.x>5 or b.y<1 or b.y>10 or grid[b.x..":"..b.y] then
            out.status="unknown";out.reason="Invalid or duplicate owned cell";return out
        end
