applyMovement=function()
    do
        -- A glider push must end on landing; the game's own cleanup is only hooked after it opened a glider itself.
        local _,h,r=character();local steering=r and r:FindFirstChild("SteeringVelocity")
        if steering and h and h.FloorMaterial~=Enum.Material.Air and not flightActive then
            pcall(function()steering:Destroy()end);clientTools.parachuteCommand("Close")
        end
    end
    local progressionOwns=clientTools.progressionActions and clientTools.progressionActions.status().status=="running"
    if closed or controller.mode~="running" and not(hunt and hunt.active) and not(bearJob and bearJob.status=="running")
        and not(clientTools.dispenser and clientTools.dispenser.active) and not progressionOwns or controller.phase=="Resetting to hive" then return end
    local model, humanoid, root = character()
    if not humanoid or not root or humanoid.Health<=0 or (target and model~=steeringCharacter)then release();return end
    if (progressionOwns or bearJob and bearJob.status=="running" or clientTools.dispenser and clientTools.dispenser.active) and not inputReady()then humanoid:Move(Vector3.new(0,0,0),false);return end
    if controller.phase=="Converting" or controller.phase=="Conversion finishing"then
        humanoid:Move(Vector3.new(0,0,0),false);lastHeading=nil;return
    end
    local jump=airborneState.jump
    if jump then
        if jump.model~=model or jump.humanoid~=humanoid or os.clock()>jump.expires or humanoid.FloorMaterial==Enum.Material.Air then
            if jump.humanoid==humanoid then humanoid.Jump=false end
            telemetry.jump.status=humanoid.FloorMaterial==Enum.Material.Air and "takeoff observed" or "expired/character changed"
            airborneState.jump=nil
        else humanoid.Jump=true;telemetry.jump.status="applied after character controls"end
    end
    if flightActive then
        if glideDirection then
            humanoid:Move(glideDirection,false)
            -- The game's glider flies along the character's facing (Controls: SteeringVelocity = LookVector*Speed),
            -- so turn to the steering direction at once instead of waiting for AutoRotate. Rotation only; position is kept.
            local flat=Vector3.new(glideDirection.X,0,glideDirection.Z)
            local steering=root:FindFirstChild("SteeringVelocity")
            local spec=clientTools.parachuteSpecs[cacheStats and cacheStats.EquippedParachute]
            if flat.Magnitude>0.1 and steering then
                pcall(function()root.CFrame=CFrame.lookAt(root.Position,root.Position+flat)end)
                -- Keep the push pointed where we steer (the game's own loop does this from LookVector every 0.1 s).
                if spec then local unit=flat.Unit;pcall(function()steering.Velocity=Vector3.new(unit.X*spec.speed,spec.float,unit.Z*spec.speed)end)end
            end
        end
        return
    end
    if humanoid.FloorMaterial==Enum.Material.Air then
        local delta=target and target-root.Position
        local desired=delta and Vector3.new(delta.X,0,delta.Z) or Vector3.new(0,0,0)
        if desired.Magnitude>1 then desired=desired.Unit else desired=Vector3.new(0,0,0)end
        local passed=airborneState.groundModel==model and motionGeometry.passedAirEndpoint(root.Position,target,airborneState.groundPosition,airborneState.groundTarget)
        if passed then desired=Vector3.new(0,0,0)end
        local dt=airborneState.at and os.clock()-airborneState.at or 1/60;airborneState.at=os.clock()
        local heading=motionGeometry.airHeading(airborneState,true,desired,model,dt)
        humanoid:Move(heading or Vector3.new(0,0,0),false)
        telemetry.motion={position=packed(root.Position),target=packed(target),heading=packed(heading),grounded=false,applied=true,
            reason=not target and "No active movement target" or passed and "Passed unchanged airborne endpoint; braking without reversing" or desired.Magnitude<0.01 and "At airborne steering endpoint" or "Ordinary jump air steering"}
        return
    end
    motionGeometry.airHeading(airborneState,false,lastHeading,model)
    airborneState.groundModel,airborneState.groundPosition,airborneState.groundTarget=model,root.Position,target
    local destination=target
    if not target or dodge.target and (target-dodge.target).Magnitude>12 then dodge.goal,dodge.at,dodge.side,dodge.clearAt=nil,nil,nil,nil end
    dodge.target=target
    local danger=dangerAhead(root.Position,target)
    local huntTarget=hunt and hunt.active and hunt.target
    local farmingZone=fieldPart(huntTarget and huntTarget.field or controller.field)
    local stayInField=farmingZone and (controller.phase=="Gathering" or controller.phase=="Preparing field" or inField(farmingZone,root.Position,6))
    if danger then dodge.clearAt=nil
    elseif dodge.goal then dodge.clearAt=dodge.clearAt or os.clock() end
    local holdingDetour=dodge.goal and dodge.clearAt and os.clock()-dodge.clearAt<.35 and (dodge.goal-root.Position).Magnitude>2 and safeSegment(root.Position,dodge.goal)
    if danger or holdingDetour then
        local engagement=huntAdapter and huntAdapter.engagement()
        local closeCombat=engagement and (engagement.phase=="activating" or engagement.phase=="fighting") and inField(engagement.zone,root.Position,0)
        if closeCombat then
            dodge.goal=huntAdapter.dodgePoint(root.Position,target)
        elseif not dodge.goal or not dodge.at or os.clock()-dodge.at>1.0 or (dodge.goal-root.Position).Magnitude<=2 or not safeSegment(root.Position,dodge.goal)then
            dodge.at,dodge.goal=os.clock(),nil
            local bestScore,bestSide=-math.huge,nil
            local hazards={};for _,m in ipairs(monsters)do hazards[#hazards+1]=m end
            for _,m in ipairs(huntAdapter and huntAdapter.thorns() or {})do hazards[#hazards+1]=m end
            for i=0,11 do
                local angle=math.pi*2*i/12
                local point=ground(root.Position+Vector3.new(math.cos(angle)*10,0,math.sin(angle)*10))
                if point and math.abs(point.Y-root.Position.Y)<4 and (not stayInField or inField(farmingZone,point,6)) and safeSegment(root.Position,point)then
                    local middle=ground((root.Position+point)*0.5)
                    if middle and math.abs(middle.Y-root.Position.Y)<4 then
                        local params=RaycastParams.new()
                        params.FilterType,params.FilterDescendantsInstances=Enum.RaycastFilterType.Exclude,{model}
                        params.RespectCanCollide=true;params.CollisionGroup=root.CollisionGroup
                        local hit=Workspace:Raycast(root.Position,point-root.Position,params)
                        if not hit or hit.Normal.Y>0.65 then
                            local clearance=math.huge
                            for _,m in ipairs(hazards)do clearance=math.min(clearance,(point-m.position).Magnitude-m.radius)end
                            local score=math.min(4,clearance)-(target and (point-target).Magnitude*0.2 or 0)
                            local sign
                            if target then
                                local to,step=target-root.Position,point-root.Position
                                local cross=to.X*step.Z-to.Z*step.X
                                if math.abs(cross)>.1 then sign=cross>0 and 1 or -1 end
                                if dodge.side and sign and sign~=dodge.side then score=score-2.5 end
                            end
                            if score>bestScore then dodge.goal,bestScore,bestSide=point,score,sign end
                        end
                    end
                end
            end
            dodge.side=dodge.side or bestSide
        end
        destination=dodge.goal
        telemetry.avoidance={active=true,destination=packed(dodge.goal),reason=closeCombat and "Close Vicious warning escape" or "Monster / warning-disk / thorn clearance; attack "..select(2,combat()),
            maxTargetDistance=closeCombat and engagement.maxDistance or nil}
    else dodge.goal,dodge.at,dodge.side,dodge.clearAt=nil,nil,nil,nil;telemetry.avoidance={active=false}end
    if not destination then
        humanoid:Move(Vector3.new(0,0,0),false)
        return
    end
    local delta = destination - root.Position
    local direction = Vector3.new(delta.X, 0, delta.Z)
    -- Navigator reaches precise jump takeoffs inside 0.65 studs; do not stop
    -- outside that radius and leave its progress watchdog waiting for motion.
    lastHeading=direction.Magnitude>0.1 and direction.Unit or Vector3.new(0,0,0)
    if airborneState.precise and direction.Magnitude>0.1 then
        lastHeading=lastHeading*math.min(1,direction.Magnitude/math.max(1,humanoid.WalkSpeed*0.08))
    end
    humanoid:Move(lastHeading,false)
    telemetry.motion={position=packed(root.Position),target=packed(destination),grounded=true,applied=true}
end
