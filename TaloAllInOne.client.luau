    local function plainText(text)
        return text:gsub("<[^>]+>",""):match("^%s*(.-)%s*$")
    end
    local function clockSeconds(text)
        local h,m,s=text:match("^(%d+):(%d%d):(%d%d)$")
        if h then
            h,m,s=tonumber(h),tonumber(m),tonumber(s)
            if h<=9999 and m<60 and s<60 then return h*3600+m*60+s end
            return
        end
        local minutes,seconds=text:match("^(%d+):(%d%d)$")
        if minutes then
            minutes,seconds=tonumber(minutes),tonumber(seconds)
            if minutes<=999999 and seconds<60 then return minutes*60+seconds end
        end
    end
    local function timerSeconds(text,monsterType,timerScope)
        if type(text)~="string"then return end
        text=plainText(text)
        -- MonsterTimers writes `<MonsterType>: <TimeString>` to TimerLabel.
        -- Word wrapping can place the clock on a second line; the prefix must
        -- match this scoped spawner, so name/level labels cannot become clocks.
        if type(monsterType)=="string"then
            local prefix=monsterType..":"
            if text:sub(1,#prefix)==prefix then
                local seconds=clockSeconds(text:sub(#prefix+1):match("^%s*(.-)%s*$"))
                if seconds~=nil then return seconds,"monster_type_clock" end
                return
            end
        end
        if timerScope then
            local seconds=clockSeconds(text)
            if seconds~=nil then return seconds,"clock"end
        end
    end
    local function visibleTimer(label)
        if not d.visible(label)then return false end
        local transparency=d.get(label,"TextTransparency")
        if finite(transparency) and transparency>=1 then return false end
        local ancestor=label
        while ancestor do
            if (d.isA(ancestor,"BillboardGui") or d.isA(ancestor,"SurfaceGui") or d.isA(ancestor,"ScreenGui")) and d.get(ancestor,"Enabled")==false then return false end
            ancestor=d.get(ancestor,"Parent")
        end
        return true
    end
    local function namedTimer(label,stop)
        local o=label
        while o and o~=stop do
            local name=tostring(d.get(o,"Name") or ""):lower()
            if name:find("timer",1,true) or name:find("cooldown",1,true)then return true end
            o=d.get(o,"Parent")
        end
        return false
    end
    local function belongs(label,spawner,territory,uniqueTerritory)
        if label:IsDescendantOf(spawner)then return true end
        local o=label
        while o and o~=territory do
            if d.get(o,"Name")==spawner.Name then return true end
            local reference=child(o,"MonsterSpawner") or child(o,"Spawner")
            if reference and d.isA(reference,"ObjectValue") and d.get(reference,"Value")==spawner then return true end
            local adornee=d.get(o,"Adornee")
            if adornee==spawner or adornee and adornee:IsDescendantOf(spawner) or uniqueTerritory and adornee==territory then return true end
            o=d.get(o,"Parent")
        end
        return false
    end
    local function mobs(stats)
        local folder=child(d.world,"MonsterSpawners")
        local spawners=folder and folder:GetChildren() or {}
        local timestamps=type(stats)=="table" and type(stats.MonsterTimes)=="table" and stats.MonsterTimes or {}
        local rows,territoryCounts={},{}
        for i,spawner in ipairs(spawners)do
            if i>128 then break end
            local territory=value(spawner,"Territory",{"ObjectValue"})
            if territory then territoryCounts[territory]=(territoryCounts[territory] or 0)+1 end
        end
        for i,spawner in ipairs(spawners)do
            if i>128 then break end
            local territory=value(spawner,"Territory",{"ObjectValue"})
            local row={name=spawner.Name,type=value(spawner,"MonsterType",{"StringValue"}),level=value(spawner,"MonsterLevel",{"IntValue","NumberValue"}),
                status="unknown",timerSource="not observed",spawnStatus="unmapped",timers={}}
            if type(row.type)~="string" or #row.type==0 or #row.type>100 then row.type=nil end
            if not integer(row.level) or row.level<1 then row.level=nil end
            row.timestamp=nonnegative(timestamps[spawner.Name])
            row.timestampStatus=row.timestamp~=nil and "cache kill-time reference used by ClientMonsterTools" or "not observed"
            row.baseCooldown=nonnegative(value(spawner,"Cooldown",{"IntValue","NumberValue"}))
            row.baseCooldownStatus=row.baseCooldown~=nil and "raw spawner Cooldown; client respawn uses MonsterTypes Stats.RespawnCooldown" or "not observed"
            if territory then
                row.territoryName=d.get(territory,"Name")
                local ok,path=pcall(function()return territory:GetFullName()end)
                if ok then row.territoryPath=path end
            end
            local seen={}
            local roots={spawner};if territory then roots[#roots+1]=territory end
            for _,root in ipairs(roots)do
                for j,label in ipairs(root:GetDescendants())do
                    if j>256 then row.timerScanCapped=true;break end
                    if not seen[label] and d.isA(label,"TextLabel") and visibleTimer(label) and belongs(label,spawner,territory,territory and territoryCounts[territory]==1)then
                        seen[label]=true
                        local text=d.get(label,"Text")
                        if type(text)=="string" and #text<=500 then
                            local timerScope=namedTimer(label,root)
                            local seconds,format=timerSeconds(text,row.type,timerScope)
                            local ready=timerScope and plainText(text):lower():match("^%s*ready!?%s*$")~=nil
                            if seconds~=nil or ready or timerScope then
                                local ok,path=pcall(function()return label:GetFullName()end)
                                row.timers[#row.timers+1]={text=text,path=ok and path or nil,format=format,remainingSeconds=seconds,readyCandidate=ready or seconds==0}
                                if #row.timers>=12 then row.timerScanCapped=true;break end
                            end
                        end
                    end
                end
            end
            local remaining,conflict=nil,false
            for _,timer in ipairs(row.timers)do
                local n=timer.remainingSeconds
                if timer.readyCandidate then n=0 end
                if n~=nil then
                    if remaining~=nil and n~=remaining then conflict=true else remaining=n end
                end
            end
            if #row.timers>0 then
                local texts={};for _,t in ipairs(row.timers)do texts[#texts+1]=t.text end
                row.rawTimerText=table.concat(texts," | ")
                row.timerSource="visible scoped timer text"
                if conflict then row.status="ambiguous_timer"
                elseif remaining~=nil then
                    row.remainingSeconds=remaining;row.readyCandidate=remaining==0
                    row.status=remaining==0 and "ready_candidate" or "cooldown_candidate"
                else row.status="unparsed_timer"end
            end
            rows[#rows+1]=row
        end
        table.sort(rows,function(a,b)return a.name<b.name end)
        return rows,#spawners>128
    end
    function readiness.scan()
        local stats=d.stats();local hive=d.ownedHive()
        local feed=feeding(stats,hive)
        local monsters,capped=mobs(stats)
        return {schema="talo.progression-readiness/1",readOnly=true,capturedAtUnix=d.unix(),observedAt=d.now(),feeding=feed,gear=gear(stats),mobs=monsters,
            mobTimerMapping={source="captured ClientScripts.MonsterTimers and ClientMonsterTools",
                labelLocation="Workspace.MonsterSpawners.<spawner>.(TimerAttachment or Attachment).TimerGui.TimerLabel",
                labelFormat="<MonsterType>: <TimeString>",timestampMeaning="MonsterTimes[spawnerName] is the client kill-time cooldown reference",
                cooldownFormula="MonsterTypes.Get(MonsterType).Stats.RespawnCooldown * (1 - MonsterCooldownReduction)",
                countdownFormula="effectiveCooldown - (floor(OsTime()) - (MonsterTimes[spawnerName] or 0))",
                reductionLookup="ModifierCaches.Value.MonsterCooldownReduction[StatModifiers.ParamsTag()]",
                inferenceStatus="Visible timer only; formula inputs not mapped",
                missingInputs={"Per-type Stats.RespawnCooldown","StatModifiers.ParamsTag and reduction mapping","OsTime clock semantics"}},
            coverage={spawnersCapped=capped},limitations={"Treat preview does not spend or predict bond/level outcome","Timer readiness is a client-text candidate, not proof of a spawned or defeated mob","Raw spawner Cooldown is not the respawn duration; per-type/modifier/clock inputs are still unmapped"}}
    end
    function readiness.previewTreats(x,y,quantity)
        if not integer(x) or x<1 or x>5 or not integer(y) or y<1 or y>10 then return nil,"Bee grid must be integer x=1..5, y=1..10"end
        if not integer(quantity) or quantity<1 then return nil,"Treat quantity must be a positive integer"end
        local stats=d.stats();local hive=d.ownedHive()
        if not hive then return nil,"Uniquely owned hive unavailable"end
        local feed,lookup=feeding(stats,hive)
        local row=lookup[x..":"..y]
        if not row then return nil,row==false and "Owned hive has duplicate grid coordinates" or "Owned bee cell metadata unavailable"end
        if not row.previewEligible then return nil,row.reason or "Selected owned cell is empty"end
        if feed.availableTreats==nil then return nil,"Treat inventory unavailable or malformed"end
        if quantity>feed.availableTreats then return nil,"Not enough observed Treat inventory"end
        return {previewOnly=true,willSpend=false,action="feed_treat_preview",resource="Treat",quantity=quantity,availableTreats=feed.availableTreats,
            projectedRemainingTreats=feed.availableTreats-quantity,bee=row,bondOutcome="unknown; feeding control/reward mapping pending"}
    end
    return readiness
end

end)()

local makeFeedingInspector = (function()
-- Pure inspection of supplied call records. No game, input, remote, or module dependency.
return function()
    local inspector={}
    local remotes={ConstructHiveCellFromEgg=6,GetBondToLevel=2}
    local function finite(n)return type(n)=="number" and n==n and math.abs(n)<math.huge end
    local function integer(n)return finite(n) and n%1==0 end
    local function remoteName(name)
        if type(name)~="string"then return end
        if remotes[name]then return name end
        local short=name:match("^ReplicatedStorage%.Events%.([%w_]+)$")
        return short and remotes[short] and short or nil
    end
    function inspector.inspectCall(remote,args,reportedQuantity)
        local name=remoteName(remote)
        if not name then return nil,"Unsupported remote record"end
        if type(args)~="table" or getmetatable(args)~=nil or not integer(args.n) or args.n<0 or args.n>16 then
            return nil,"Plain packed arguments with an explicit n (0 to 16) are required"
        end
        for key in pairs(args)do
            if key~="n" and (not integer(key) or key<1 or key>args.n)then return nil,"Argument key is outside the declared count"end
        end
        if reportedQuantity~=nil and (not integer(reportedQuantity) or reportedQuantity<1)then return nil,"Reported quantity must be a positive integer"end
        local row={remote="ReplicatedStorage.Events."..name,argumentCount=args.n,arguments={},
            readOnly=true,evidenceOnly=true,willSpend=false,argumentMappingStatus="unverified",
            argumentShapeStatus=args.n==remotes[name] and "matches_reported_count" or "different_from_reported_count",
            source="supplied_call_record",reason="Caller source and inventory delta not captured"}
        for index=1,args.n do
            local value=args[index]
            local kind=type(value)
            if kind~="nil" and kind~="boolean" and kind~="string" and kind~="number"then return nil,"Only scalar arguments can be retained"end
            if kind=="number" and not finite(value)then return nil,"Non-finite argument"end
            if kind=="string" and #value>512 then return nil,"Argument text exceeds inspection limit"end
            row.arguments[index]={index=index,type=kind,value=value}
        end
        -- Grid and quantity labels are candidates, never an executable call contract.
        if args.n==remotes[name] and integer(args[1]) and args[1]>=1 and args[1]<=5 and integer(args[2]) and args[2]>=1 and args[2]<=10 then
            row.gridCandidate={x=args[1],y=args[2]}
        end
        if name=="ConstructHiveCellFromEgg" and args.n==6 and args[3]=="Treat" and integer(args[4]) and args[4]>0 then
            row.resourceCandidate="Treat"
            row.quantityCandidate=args[4]
            row.quantityStatus="candidate; consumption unverified"
            row.reportedQuantity=reportedQuantity
            if reportedQuantity~=nil then
                row.quantityMismatch=reportedQuantity~=args[4]
                if row.quantityMismatch then row.reason="Reported quantity differs from the fourth logged argument"end
            end
        end
        if name=="GetBondToLevel"then row.querySemantics="unknown; no query is executed"end
        return row
    end
    function inspector.reported()
        local records={
            assert(inspector.inspectCall("ConstructHiveCellFromEgg",{n=6,1,1,"Treat",1,false},1)),
            assert(inspector.inspectCall("ConstructHiveCellFromEgg",{n=6,1,3,"Treat",4,false},3)),
            assert(inspector.inspectCall("GetBondToLevel",{n=2,1,1})),
            assert(inspector.inspectCall("GetBondToLevel",{n=2,1,3})),
        }
        for _,row in ipairs(records)do row.source="user_supplied_historical_log"end
        records[1].context="User reported feeding one Treat"
        records[2].context="User reported three Treats; fourth argument was 4"
        records[3].context="User reported dragging a Treat onto a bee"
        records[4].context="User reported dragging a Treat onto another bee"
        return records
    end
    return inspector
end

end)()

local makeTreatFeeder = (function()
-- Fixed-quantity ordinary Treat action, started only by an explicit caller.
-- No scheduling, remote lookup, game-module initialization or retry lives here.
return function(d)
    local feeder={}
    local active,last
    local function integer(n)return type(n)=="number" and n==n and math.abs(n)<math.huge and n%1==0 end
    local function emit(kind,detail)if d.event then pcall(d.event,kind,detail)end end
    local function rejected(x,y,quantity,why,keepPending)
        local record={status="rejected",resource="Treat",sent=false,reason=why,
            x=integer(x)and x>=1 and x<=5 and x or nil,y=integer(y)and y>=1 and y<=10 and y or nil,
            quantity=integer(quantity)and quantity>=1 and quantity or nil}
