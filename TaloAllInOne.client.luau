local makeScopedClick = (function()
-- Normal paired mouse input restricted to a currently observed UI scope.
return function(d)
    return function(control,scope,mode)
        if d.closed() or not control or not scope or not control.Parent or not d.visible(control)then return false,"UI scope is no longer visible"end
        if control~=scope and not control:IsDescendantOf(scope)then return false,"Control is outside its observed scope"end
        if mode=="teleport"then
            local prompt=d.teleportPrompt()
            if not prompt or prompt.root~=scope or prompt.button~=control or not d.keyboardClear()then return false,"Teleport prompt changed"end
        elseif not d.ready()then return false,"Input is blocked"end
        if not control:IsA("GuiButton") and not(mode=="input-surface" and control:IsA("GuiObject") and d.get(control,"Active")==true)then return false,"Unrecognized input surface"end
        local p,s=d.get(control,"AbsolutePosition"),d.get(control,"AbsoluteSize")
        if not p or not s or type(s.X)~="number" or type(s.Y)~="number" or s.X<2 or s.Y<2 then return false,"No visible UI rectangle"end
        local x,y=math.floor(p.X+s.X/2),math.floor(p.Y+s.Y/2)
        local core,pg=d.core(),d.gui()
        local inCore=core and control:IsDescendantOf(core)
        local function inspect(container)
            if not container then return nil end
            local ok,objects=pcall(function()return container:GetGuiObjectsAtPosition(x,y)end)
            if not ok then return false end
            for _,o in ipairs(objects)do
                if d.visible(o) and (o:IsA("GuiButton") or o:IsA("TextBox") or d.get(o,"Active")==true)then
                    if o==control or o:IsDescendantOf(control)then return true end
                    if not control:IsDescendantOf(o)then return false end
                end
            end
            return nil
        end
        local coreHit=inspect(core)
        if inCore then
            if coreHit~=true then return false,"Teleport control is covered or not hit-testable"end
        else
            if coreHit~=nil then return false,"Core UI covers the dialogue"end
            if inspect(pg)~=true then return false,"Dialogue surface is covered or not hit-testable"end
        end
        return d.press(x,y,mode)
    end
end

end)()

