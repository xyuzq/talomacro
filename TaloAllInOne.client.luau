            h.message="Teleport dialog input unavailable; attempting another 1–3-player server without character input"
            deps.event("hunt_modal_join_fallback",{failures=popupFailures,reason=why})
            return
        end
        if prompt then
            if retryAt and now<retryAt then h.message="Waiting briefly before retrying the Teleport Failed Ok control";return end
            if deps.dismissTeleportPrompt then
                pendingHop="Teleport Failed popup: "..tostring(prompt.text or "engine failure")
