    local exposed=type(floorY)=="number" and math.max(0,top-floorY) or nil
    local high=math.max(peak or top,top)
    if type(explicitPollen)=="number"then return explicitPollen>0 and 1 or 0,high,exposed,"explicit Pollen"end
    if height<0.12 or exposed and exposed<0.06 then return 0,high,exposed,"exposed height"end
    local score=exposed and exposed/math.max(0.3,high-floorY) or 1-(high-top)/math.max(0.3,height)
    return math.max(0,math.min(1,score)),high,exposed,exposed and "exposed height" or "observed top change; soil unknown"
end
