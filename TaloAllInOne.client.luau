            if h.phase~="Recovering"then cancelJob();h.phase="Recovering";loadedAt=now end
            if now-(loadedAt or now)>60 then h.message="Still waiting for a living character; hunt remains enabled"end
            return
        elseif h.phase=="Recovering"then h.phase="Loading";loadedAt=nil end
        if h.phase=="Loading"then
            loadedAt=loadedAt or now
