local makeViciousHunt = (function()
-- Continuous night/hunt/hop scheduler. Individual actions time out; only user controls stop hunting.
return function(deps)
    local h={active=false,phase="Off",message="Vicious hunt off"}
    local state,job,nightSince,loadedAt,scanAt,retryAt,failures,generation,pendingHop
    local popupFailures,popupJoinFallback,modalJoin=0,false,nil
    local function save()if state then return deps.save(state)end end
    local function cancelJob()
        generation=(generation or 0)+1
