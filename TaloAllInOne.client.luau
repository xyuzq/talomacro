        if type(item)~="string" or operation~="buy" and operation~="craft"then return end
        local canonical=item:gsub("[^%w]","");if canonical=="SparkStaff"then return end
        local id=operation..":"..canonical;if seen[id]then return end
        quantity=operation=="buy" and 1 or type(quantity)=="number" and math.max(1,math.ceil(quantity)) or 1
        if quantity>10000 or not EconomyCatalog.quote(id,quantity,game.PlaceVersion)then return end
        seen[id]=true;requests[#requests+1]={id=id,quantity=quantity,priority=priority or 60,reason=reason}
