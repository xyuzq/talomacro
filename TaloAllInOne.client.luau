    if #quoted.requirements>0 and not (out.requirements.known and out.requirements.met or not out.requirements.known and live and live.requirementsMet==true)then

        block("Evaluate the exact captured prerequisites against the live account")

    end

    if out.requirements.known and out.requirements.met and live and live.requirementsMet==false then block("Live prerequisite check conflicts with the captured requirement mapping")end

    if not (live and live.accessible==true and live.stationReady==true)then block("Observe the accessible shop/station and its ready state")end

    if not (live and key(live.stateKey))then block("A stable native readiness witness is required")end

