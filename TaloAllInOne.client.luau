        end
        if not cancelled()then deps.steer(nil)end
        return finish(false,cancelled() and "Glide cancelled" or "Glide landing timeout",select(3,deps.character()))
    end
    return glider
end

end)()

local makeJumpGlide = (function()
-- An explicit short ascent: normal jump first, deployment only at an observed apex.
return function(d)
    local controller={}
    local function finite(n)return type(n)=="number" and n==n and math.abs(n)<math.huge end
    local function planar(a,b)local delta=b-a;return math.sqrt(delta.X*delta.X+delta.Z*delta.Z)end
    function controller.run(edge,cancelled,ticket)
        if edge.glideMode~="jump_glide"then return false,"Jump/glide mode was not explicitly selected"end
        local model,h,root=d.character()
        local launch,goal,runup=edge.takeoff,edge.position,edge.runup
        if not model or not h or not root or not launch or not goal or not runup then return false,"Jump/glide character, launch or supported run-up unavailable"end
        local gear=d.gear()
        if gear~="Glider" and gear~="Parachute"then return false,"Jump/glide equipment unavailable before the run-up"end
        local function valid()
            local current,humanoid,part=d.character()
            return not cancelled() and current==model and humanoid and humanoid.Health>0 and part~=nil
        end
        local function finish(ok,reason)
            d.finish(ticket)
            if d.event then d.event("jump_glide_result",{ok=ok,reason=reason,id=edge.id})end
            return ok,reason
        end
        if (root.Position-runup).Magnitude>1 then
            local job=d.walk(runup,cancelled,nil,12)
            local untilTime=d.now()+12
            while job.status=="running" and valid() and d.now()<untilTime do d.sleep(0.03)end
            if job.status~="success" or not valid()then if job.cancel then job.cancel()end;return finish(false,"Checked jump/glide takeoff approach failed")end
            _,h,root=d.character()
        end
        if not valid() or d.airborne(h) or (root.Position-runup).Magnitude>3 then return finish(false,"Jump/glide needs a grounded checked run-up")end
        local plannedSpan=planar(launch,goal)
        if plannedSpan<=1 or plannedSpan>40 then return finish(false,"Short jump/glide span is outside one to forty studs")end
        local aim=goal-launch
        local forward=Vector3.new(aim.X/plannedSpan,0,aim.Z/plannedSpan)
        local behind=(launch.X-root.Position.X)*forward.X+(launch.Z-root.Position.Z)*forward.Z
        if behind<2 or behind>16 or math.abs(root.Position.Y-launch.Y)>3 then return finish(false,"Supported run-up does not provide a grounded acceleration corridor")end
        if type(d.landingSafe)~="function" then return finish(false,"Checked short landing footprint unavailable")end
        d.begin(forward,ticket)
        local runStarted,ready=d.now(),false
        while valid() and d.now()-runStarted<3 do
            _,h,root=d.character()
            if d.airborne(h) or math.abs(root.Position.Y-launch.Y)>3 then return finish(false,"Run-up lost floor support before the queued jump")end
            local progress=(root.Position.X-launch.X)*forward.X+(root.Position.Z-launch.Z)*forward.Z
            local lateral=math.abs((root.Position.X-launch.X)*forward.Z-(root.Position.Z-launch.Z)*forward.X)
            local velocity=root.AssemblyLinearVelocity
            local speed=velocity and velocity.X*forward.X+velocity.Z*forward.Z or 0
            if not finite(h.WalkSpeed) or h.WalkSpeed<=0 then return finish(false,"Current run-up speed unavailable")end
            if d.telemetry then d.telemetry.jumpGlide={id=edge.id,phase="run-up",launchProgress=progress,lateral=lateral,forwardSpeed=speed,requiredSpeed=h.WalkSpeed*0.9}end
            if progress>= -0.8 and (not finite(speed) or speed<h.WalkSpeed*0.9)then return finish(false,"Run-up speed was not acknowledged before the ledge")end
            if progress>= -0.15 then
                if progress>math.max(0.8,h.WalkSpeed*0.03) or lateral>0.75 then return finish(false,"Precise takeoff alignment was missed")end
                ready=true;break
            end
            local delta=launch-root.Position
            local length=math.sqrt(delta.X*delta.X+delta.Z*delta.Z)
            local heading=length>0.1 and Vector3.new(delta.X/length,0,delta.Z/length) or forward
            if not d.clear(root.Position,root.Position+heading*math.min(2,length))then return finish(false,"Grounded run-up body corridor is obstructed")end
            d.steer(heading);d.sleep(0.02)
        end
        if not ready then return finish(false,cancelled() and "Jump/glide run-up cancelled" or "Grounded run-up deadline")end
        local profile=d.profile and d.profile(h)
        if type(profile)~="table" or not finite(profile.speed) or profile.speed<=0 or not finite(profile.gravity) or profile.gravity<=0
            or not finite(h.WalkSpeed) or h.WalkSpeed<=0 then return finish(false,"Current jump/gravity profile unavailable")end
        local span=planar(root.Position,goal)
        if span<=1 or span>40 then return finish(false,"Short jump/glide span is outside one to forty studs")end
        local delta=goal-root.Position
        local direction=Vector3.new(delta.X/span,0,delta.Z/span)
        local origin=root.Position
        local apexTime=profile.speed/profile.gravity
        local height=profile.speed*profile.speed/(2*profile.gravity)
        local delay=edge.jumpSeconds or 0
        if not finite(delay) or delay<0 then return finish(false,"Jump/glide deployment delay is invalid")end
        local switchTime=math.max(apexTime,delay)
        local velocity=root.AssemblyLinearVelocity
        local observedSpeed=velocity and velocity.X*direction.X+velocity.Z*direction.Z or 0
        local launchSpeed=math.min(h.WalkSpeed,observedSpeed)
        if not finite(launchSpeed) or launchSpeed<h.WalkSpeed*0.9 then return finish(false,"Precise takeoff lost its acknowledged forward velocity")end
        local advance=math.min(span,launchSpeed*switchTime)
        local predicted=origin+direction*advance+Vector3.new(0,profile.speed*switchTime-profile.gravity*switchTime*switchTime/2,0)
        local options={mode="jump_glide",landingSafe=d.landingSafe}
        if not d.glider.eligible(predicted,goal,d.gear(),options)then return finish(false,"Source-predicted jump apex cannot reach the short glide landing")end
        if finite(edge.rangeMargin) and edge.rangeMargin>0 and edge.rangeMargin<=1 then
            local ratio,_,horizontal,sink=d.glider.range(d.gear())
            local conservative=finite(horizontal) and finite(sink) and sink>0 and math.min(ratio,horizontal/sink*edge.rangeMargin) or ratio
            if planar(predicted,goal)>(predicted.Y-goal.Y)*conservative then return finish(false,"Acknowledged run-up cannot retain the modeled short-glide range margin")end
        end
        -- Body clearance is tested along the actual current jump profile, not a straight ground chord.
        local previous=origin
        for i=1,6 do
            local t=switchTime*i/6
            local point=origin+direction*math.min(span,launchSpeed*t)+Vector3.new(0,profile.speed*t-profile.gravity*t*t/2,0)
            if not d.clear(previous,point)then return finish(false,"Jump/glide arc or headroom is obstructed")end
            previous=point
        end
        if not valid()then return finish(false,"Jump/glide cancelled before jumping")end
        d.steer(direction)
        if not d.requestJump(h,model)then return finish(false,"Normal jump could not be queued from this takeoff")end
        local started=d.now()
        local risen=false
        while valid() and d.now()-started<math.min(3,apexTime*2+1)do
            local _,humanoid,part=d.character()
            local rise=part.Position.Y-origin.Y
            local progress=(part.Position.X-origin.X)*direction.X+(part.Position.Z-origin.Z)*direction.Z
            local velocity=part.AssemblyLinearVelocity
            local inAir=d.airborne(humanoid)
            if inAir and rise>=1.5 and velocity and finite(velocity.Y) and velocity.Y>1 then risen=true end
            if d.telemetry then d.telemetry.jumpGlide={id=edge.id,phase=risen and "rising" or "waiting for jump",rise=rise,progress=progress,
                predictedApexY=origin.Y+height,predictedSwitchY=predicted.Y,minimumDeploySeconds=delay}end
            d.steer(direction)
            if risen and inAir and velocity and finite(velocity.Y) and velocity.Y<=3 and d.now()-started>=math.max(0.12,delay)then
                if progress<math.min(2,span*0.2)then return finish(false,"Jump rose without forward progress")end
                if not d.clear(part.Position,goal)then return finish(false,"Observed apex-to-landing body corridor is blocked")end
                if not d.glider.eligible(part.Position,goal,d.gear(),options)then return finish(false,"Observed apex is outside the short glide envelope")end
                if d.telemetry then d.telemetry.jumpGlide.phase="short glide"end
                local ok,why=d.glider.fly(goal,cancelled,false,options)
                return finish(ok,why)
            end
            if risen and not inAir then return finish(false,"Jump grounded before an eligible glide apex")end
            d.sleep(0.02)
        end
        return finish(false,cancelled() and "Jump/glide cancelled" or "Normal jump/apex was not observed")
    end
    return controller
end

end)()

local fieldPatterns = (function()
-- Original coordinate patterns. Scores describe a coverage model, not proven honey yield.
local patterns = {names = {"Lines", "E sweep", "Loops"}}
local function dist(a,b) local x,z=a.x-b.x,a.z-b.z; return math.sqrt(x*x+z*z) end
function patterns.points(name, width, depth, spacing)
    local w,d = math.max(2,math.min(width/2-10,width*0.18,16)),math.max(2,math.min(depth/2-10,depth*0.18,16))
    local raw = {}
    local function add(x,z) raw[#raw+1]={x=x,z=z} end
    if name == "Loops" then
        local r=1
        while r>0.15 do add(-w*r,-d*r);add(w*r,-d*r);add(w*r,d*r);add(-w*r,d*r);add(-w*r,-d*r);r=r-0.25 end
    elseif name == "E sweep" then
        local n=math.max(2,math.ceil(depth/(spacing or 12)))
        for i=0,n do local z=-d+2*d*i/n; add(-w,z);add(w,z);add(-w,z) end
    else
        -- Run along the longest axis, reducing turns in narrow fields.
        local swap=depth>width
        local long,short=swap and d or w,swap and w or d
        local n=math.max(1,math.ceil(2*short/(spacing or 12)))
        for i=0,n do
            local v=-short+2*short*i/n
            local a,b=i%2==0 and -long or long,i%2==0 and long or -long
            if swap then add(v,a);add(v,b) else add(a,v);add(b,v) end
        end
    end
    if dist(raw[#raw],raw[1])>0 then add(raw[1].x,raw[1].z)end
    local result={raw[1]}
    for i=2,#raw do
        local a,b=raw[i-1],raw[i]
        local n=math.max(1,math.ceil(dist(a,b)/10))
        for j=1,n do result[#result+1]={x=a.x+(b.x-a.x)*j/n,z=a.z+(b.z-a.z)*j/n} end
    end
    return result
end
function patterns.rank(width,depth,speed)
    local ranked={}
    for _,name in ipairs(patterns.names) do
        local points=patterns.points(name,width,depth)
        local length,covered=0,0
        for i=2,#points do length=length+dist(points[i-1],points[i]) end
        local total=0
        for x=-width/2+8,width/2-8,8 do
            for z=-depth/2+8,depth/2-8,8 do
                total=total+1
                for _,p in ipairs(points) do if dist(p,{x=x,z=z})<=8 then covered=covered+1;break end end
            end
        end
        local seconds=length/math.max(1,speed)+#points*0.04
        ranked[#ranked+1]={name=name,points=points,length=length,coverage=covered/math.max(1,total),
            score=(covered/math.max(1,total))/math.max(1,seconds),estimatedSeconds=seconds}
    end
    table.sort(ranked,function(a,b)return a.score>b.score or a.score==b.score and a.name<b.name end)
    return ranked
end
function patterns.new()
    local state={fields={}}
    function state.suspend()for _,s in pairs(state.fields)do s.suspended=true end end
    function state.select(field,width,depth,speed,now,pollen,signature,eligible)
        local s=state.fields[field]
        if not s or s.signature~=signature then
            s={signature=signature,ranked=patterns.rank(width,depth,speed),index=1,started=now,pollen=pollen,samples={},cursor=1}
            state.fields[field]=s
        end
        if s.suspended then s.started,s.pollen,s.suspended=now,pollen,false end
        if not eligible or pollen<s.pollen then s.started,s.pollen=now,pollen end
        if eligible and now-s.started>=60 then
            local name=s.ranked[s.index].name
            local rate=(pollen-s.pollen)/(now-s.started)
            local prior=s.samples[name]
            s.samples[name]={rate=prior and prior.rate*0.5+rate*0.5 or rate,windows=(prior and prior.windows or 0)+1}
            local nextIndex,best=1,-math.huge
            for i,item in ipairs(s.ranked) do
                local sample=s.samples[item.name]
                local score=sample and sample.rate or math.huge-i
                if score>best then nextIndex,best=i,score end
            end
            if s.index~=nextIndex then s.cursor,s.joined=1,false end
            s.index,s.started,s.pollen=nextIndex,now,pollen
        end
        return s.ranked[s.index],s
    end
    return state
end
return patterns

end)()

local makeSurfaceRouter = (function()
-- Bounded A* over live, collision-checked support samples; independent of Roblox's navmesh.
return function(deps)
    local function length(a, b) return (a - b).Magnitude end
    local function planar(a, b)
        local d = a - b
        return math.sqrt(d.X * d.X + d.Z * d.Z)
    end
    local function push(heap, value)
        heap[#heap + 1] = value
        local i = #heap
        while i > 1 do local p = math.floor(i / 2); if heap[p].f <= value.f then break end; heap[i] = heap[p]; i = p end
        heap[i] = value
    end
    local function pop(heap)
        local first, last = heap[1], table.remove(heap)
        if #heap > 0 then
            local i = 1
            while i * 2 <= #heap do
                local child = i * 2
                if child < #heap and heap[child + 1].f < heap[child].f then child = child + 1 end
                if heap[child].f >= last.f then break end
                heap[i] = heap[child]; i = child
            end
            heap[i] = last
        end
        return first
    end
    return function(start, goal, options)
        options = options or {}
        local step, deadline = options.spacing or 8, deps.now() + (options.seconds or 5)
        local heuristicWeight=options.heuristicWeight or 1.25
        local cancelled = options.cancelled or function() return false end
        local function valid() return not cancelled() and deps.now() < deadline end
        local function interrupted()return cancelled() and "Cancelled surface route" or "Surface route time budget reached"end
        local function sample(x,z,reference)
            local p,reason=deps.sample(x,z,reference)
            if p and (not deps.nodeAllowed or deps.nodeAllowed(p))then return p end
            return nil,reason
        end
