local function validCoverage(v)
    if type(v)=="table" then return v.complete==true or v.status=="complete" or v.status=="explicit" end
    if type(v)~="string" or v=="" then return false end
    v=v:lower();return not(v:find("unknown",1,true) or v:find("unmapped",1,true) or v:find("truncated",1,true) or v:find("incomplete",1,true))
