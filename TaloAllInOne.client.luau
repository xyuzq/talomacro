        local walkingStatus
        if pinnedWalk then
            local sourceId=data.dispenserRoutes.strawberryWalkFrom
            local source
            for _,node in ipairs(data.nodes)do if node.id==sourceId then source=vector(node.position);break end end
            if not source then why="Pinned Strawberry walking entrance is unavailable"
            else
                local approach,approachCost,approachWhy=manager.plan(start,source,c,blocked)
                if not approach then why=approachWhy
                else
                    local itineraryBlocked={};for id,value in pairs(blocked)do itineraryBlocked[id]=value end
                    for _,edge in ipairs(data.edges)do
                        local gatePassage=walkingCoverage.outside and walkingCoverage.inside and
                            (edge.from==walkingCoverage.outside and edge.to==walkingCoverage.inside or edge.from==walkingCoverage.inside and edge.to==walkingCoverage.outside)
                        if edge.requiresRouteScope~=c.routeScope and not gatePassage then itineraryBlocked[edge.id]=true end
                    end
                    local onward,onwardCost,onwardWhy=manager.plan(source,goal,c,itineraryBlocked)
                    if not onward then why=onwardWhy
                    else
                        route={};for _,leg in ipairs(approach)do route[#route+1]=leg end;for _,leg in ipairs(onward)do route[#route+1]=leg end
                        cost=approachCost+onwardCost;why="Pinned Strawberry ground itinerary validated"
                        walkingStatus={id=walkingCoverage.id,status="validated",minBees=walkingCoverage.minBees,
                            points=walkingCoverage.pointCount,sourceHash=walkingCoverage.sourceHash,canopySurfaces=false,liveProfileChecked=true}
                    end
