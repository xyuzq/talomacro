        emit("treat_rejected",record)
        return nil,why
    end
    local function preview(x,y,quantity)
        local ok,result,why=pcall(d.preview,x,y,quantity)
        if not ok then return nil,"Treat preview failed: "..tostring(result)end
        if type(result)~="table"then return nil,why or "Owned bee/Treat preview unavailable"end
        local bee=result.bee
        if result.previewOnly~=true or result.willSpend~=false or result.resource~="Treat" or result.quantity~=quantity
            or not integer(result.availableTreats) or result.availableTreats<quantity or type(bee)~="table"
            or bee.x~=x or bee.y~=y or bee.previewEligible~=true or bee.status~="matching" or type(bee.type)~="string"then
            return nil,"Owned bee/Treat preview is malformed or no longer eligible"
        end
        local stamp={stock=result.availableTreats}
        for _,key in ipairs({"x","y","slotId","slotName","cellType","type","cacheType","level","bond","gifted","birth"})do stamp[key]=bee[key]end
        if d.identity then
            local identityOK,hive,cell,birth=pcall(d.identity,x,y)
            if not identityOK or not hive or not cell then return nil,"Owned hive/cell identity unavailable"end
            stamp.hiveIdentity,stamp.cellIdentity,stamp.birthIdentity=hive,cell,birth
        end
        return stamp
    end
    local function same(a,b)
        for key,value in pairs(a)do if b[key]~=value then return false end end
        for key,value in pairs(b)do if a[key]~=value then return false end end
        return true
    end
    function feeder.feed(x,y,quantity)
        if active and (active.status=="idle" or active.status=="sending")then return rejected(x,y,quantity,"A Treat request is already pending",true)end
        if not integer(x) or x<1 or x>5 or not integer(y) or y<1 or y>10 or not integer(quantity) or quantity<1 then
            return rejected(x,y,quantity,"Choose an occupied hive slot and a positive integer Treat quantity")
        end
        local original,why=preview(x,y,quantity)
        if not original then return rejected(x,y,quantity,why)end
        local job={status="idle",x=x,y=y,quantity=quantity,resource="Treat",sent=false,availableTreats=original.stock}
        active,last=job,job
        local function finish(status,reason)
            job.status,job.reason=status,reason
            if active==job then active=nil end
            emit("treat_result",{status=status,reason=reason,x=x,y=y,quantity=quantity,sent=job.sent,serverAccepted=job.serverAccepted,
                remainingTreats=job.remainingTreats,cacheApplied=job.cacheApplied,cancelRequested=job.cancelRequested})
        end
        function job.cancel()
            if job.status~="idle" and job.status~="sending"then return false,"Treat request already finished"end
            job.cancelRequested=true
            if job.sent then return false,"Treat request already sent; awaiting its authoritative result"end
            finish("cancelled","Treat request cancelled before sending")
            return true
        end
        local function run()
            if job.status~="idle" or job.cancelRequested then return end
            local current,reason=preview(x,y,quantity)
            if not current then finish("failed",reason);return end
            if not same(original,current)then finish("failed","Owned bee or Treat inventory changed; review the selection again");return end
            if job.status~="idle" or job.cancelRequested then return end
            job.status,job.sent="sending",true
            emit("treat_sending",{x=x,y=y,quantity=quantity,resource="Treat",untilGifted=false})
            local ok,remaining,success,honeycomb,discovered,totals=pcall(d.invoke,x,y,"Treat",quantity,false,nil)
            if not ok then finish("failed","Treat request outcome is uncertain; no retry: "..tostring(remaining));return end
            job.serverAccepted=success==true
            if success~=true then finish("failed","Server did not confirm the Treat request; no retry");return end
            if not integer(remaining) or remaining<0 or remaining>original.stock or type(honeycomb)~="table"
                or type(discovered)~="table" or type(totals)~="table"then
                finish("failed","Server accepted the Treat request but returned an unmapped cache payload; refresh stats before another request");return
            end
            job.remainingTreats=remaining
            if type(d.applyResult)~="function"then finish("failed","Treat accepted; cache update unavailable, refresh stats before another request");return end
            local applied,accepted,applyWhy=pcall(d.applyResult,{remainingTreats=remaining,honeycomb=honeycomb,discoveredBees=discovered,totalsEggUses=totals})
            if not applied or accepted==false then
                finish("failed","Treat accepted; cache update failed: "..tostring(applied and applyWhy or accepted));return
            end
            job.cacheApplied=true
            finish("success","Server confirmed the fixed Treat quantity")
        end
