            zeroCost=false,mutatesResources=true,priority=r.priority,sourceQuote={captureId=quoted.captureId,module=quoted.sourceModule,line=quoted.sourceLine,hash=quoted.sourceHash}}

    end

    return out

end

-- Requests come from the progression policy's current goal frontier. Prices alone

-- do not tell us whether a colored tool or a sidegrade advances that account.

function EconomyCatalog.next(snapshot,requests,now)

    local result={schemaVersion="talo.economy-catalog-plan/1",accountId=snapshot and snapshot.accountId,quotes={},executable=false}

    local ordered={}

    for index,request in ipairs(type(requests)=="table" and requests or {})do

