                            row.cacheType=type(cacheType)=="string" and cacheType or nil
                            if locked then row.status,row.reason="locked","Owned cell is locked"
                            elseif not label then row.status,row.reason="unknown_cell_type","Owned CellType is not a mapped Bee suffix"
                            elseif type(cached)~="table"then row.status,row.reason="cache_unavailable","Matching Honeycomb cache cell unavailable"
                            elseif cacheType~=label then row.status,row.reason="type_mismatch","Owned CellType and cache Type disagree"
                            else
                                row.status,row.previewEligible="matching",true
                                row.level=integer(cached.Lvl) and cached.Lvl>0 and cached.Lvl or nil
