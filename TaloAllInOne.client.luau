        end
        local ran,points,why=pcall(function()
            if type(edge)~="table"or edge.kind~="walk"or type(remaining)~="table"or #remaining<1 or #remaining>512 then return nil,"Walk refresh requires the remaining ordinary route edge"end
            local count=0
            for key in pairs(remaining)do if not finite(key)or key%1~=0 or key<1 or key>#remaining then return nil,"Remaining walk suffix is not a dense array"end;count=count+1 end
            if count~=#remaining then return nil,"Remaining walk suffix is not a dense array"end
            from,to=vector(current),vector(edge.position)
            if not from or not to then return nil,"Walk refresh endpoints unavailable"end
            local index,contextReason
            c,index,contextReason=makeContext(externalCancel,true)
            if not c then return nil,contextReason end
            if c.cancelled()then return nil,"Walk refresh time/context cancelled"end
            c.requireExplicitActions=true
            local suffix={kind="walk",points={}}
            local precision={}
            for _,old in ipairs(remaining)do
                if type(old)~="table"then return nil,"Malformed remaining walk point"end
                local p=vector(old.Position or old.position)
                local action=old.Action or old.action or Enum.PathWaypointAction.Walk
                if not p or action~=Enum.PathWaypointAction.Walk and action~="Walk"and action~=Enum.PathWaypointAction.Jump and action~="Jump"then return nil,"Malformed remaining walk action/position"end
                -- Stale takeoffs/timing/profile fields are intentionally not copied.
                suffix.points[#suffix.points+1]={position=p,action=(action==Enum.PathWaypointAction.Jump or action=="Jump")and"Jump"or"Walk"}
                if old.Precision==true then precision[#precision+1]=p end
            end
            local ok,detail=validate(suffix,from,to,c)
            if not ok then return nil,type(detail)=="table"and detail.reason or tostring(detail)end
            local checked=detail and detail.points
            if type(checked)~="table"or #checked<1 then return nil,"Walk refresh returned no checked suffix"end
            local last=checked[#checked].Position
            if (last-to).Magnitude>.1 then
                local tail,tailWhy=d.surfacePath(last,to,c.cancelled,1,true)
                if type(tail)~="table"or #tail<2 then return nil,"Walk refresh endpoint has no checked ordinary connection: "..tostring(tailWhy)end
                for _,point in ipairs(tail)do
                    if not vector(point.Position)or point.Action~=nil and point.Action~=Enum.PathWaypointAction.Walk and point.Action~="Walk"then return nil,"Walk refresh endpoint connection is not ordinary Walk"end
                end
                if (tail[1].Position-last).Magnitude>.25 or(tail[#tail].Position-to).Magnitude>.25 then return nil,"Walk refresh endpoint connection disagrees with its destination"end
                for i=2,#tail do checked[#checked+1]=tail[i]end
            end
            if not vector(checked[1].Position)or(checked[1].Position-from).Magnitude>3 or(checked[#checked].Position-to).Magnitude>.25 then return nil,"Walk refresh changed its current start or final destination"end
            for _,point in ipairs(checked)do
                for _,p in ipairs(precision)do if(point.Position-p).Magnitude<=.25 then point.Precision=true;break end end
            end
            if remaining[#remaining].Precision==true then checked[#checked].Precision=true end
            local fresh=readManifest(true)
            if not compatible(fresh,data)or c.cancelled()then return nil,"Walk refresh time/context/map changed during validation"end
            return checked,"Remaining walk revalidated with the current movement profile"
        end)
        if not ran then return finish(nil,"Walk refresh failed: "..tostring(points))end
        return finish(points,why)
    end
    function bridge.status()
        local state=manager.status();state.reason=reason;state.sourceFile=data and data.sourceFile
        return state
    end
    function bridge.destination(name)
        for _,node in ipairs(data and data.nodes or{})do if node.id==name or node.id=="field:"..name then return vector(node.position)end end
    end
    return bridge
end

end)()

local makeReturnLandings = (function()
-- Candidate intermediate descent landings are sampled from live collision geometry.
return function(d)
    local m={}
    function m.add(nodes,goal,gear)
        local sources={}
        for id,n in pairs(nodes)do if id=="start" or n.takeoff or id:sub(1,4)=="rim:"then sources[#sources+1]={id=id,node=n}end end
        table.sort(sources,function(a,b)return a.id<b.id end)
        local count,queries,seen=0,0,{}
        for _,source in ipairs(sources)do
            local p=source.node.position;local v=goal-p;local length=math.sqrt(v.X*v.X+v.Z*v.Z)
            if length>30 and p.Y-goal.Y>20 then
                local x,z=v.X/length,v.Z/length
                for _,angle in ipairs({0,-0.65,0.65,-1.3,1.3})do
                    local c,s=math.cos(angle),math.sin(angle)
                    for _,distance in ipairs({35,60,90,120,170,220,280})do
                        if queries>=100 or count>=24 then return count end
                        queries=queries+1
                        local q=d.floor(Vector3.new(p.X+(x*c-z*s)*distance,p.Y,p.Z+(x*s+z*c)*distance))
                        local key=q and source.id..":"..math.floor(q.X/8)..":"..math.floor(q.Y/8)..":"..math.floor(q.Z/8)
                        if q and not seen[key] and q.Y<p.Y-20 and p.Y-q.Y<250 and d.eligible(p,q,gear) and d.allowed(q)then
                            seen[key]=true
                            count=count+1
                            nodes["drop:"..source.id..":"..count]={position=q,landing=true,descentFrom=source.id}
                        end
                    end
                end
            end
        end
        return count
    end
    return m
end

end)()

local makeUpperReturn = (function()
-- Prefer a supported nearby upper takeoff and an in-range intermediate base landing.
return function(d)
    local m={}
    local function nearbyPlan(start,goal,excluded,used)
        local blocked={}
        for key,value in pairs(used)do blocked[key]=value end
        for _,name in ipairs({"Red Cannon","Blue Cannon","Yellow Cannon","Slingshot"})do blocked[name]=true end
        local approaches,lastReason=0,"No untried supported takeoff and landing within measured glide range"
        for _,launch in ipairs(d.takeoffs(start,goal))do
            local id="descent:polar-return:"..launch.id
            if not excluded[id] and not used[id] and (launch.stages or approaches<3)then
                local landing
                for _,point in ipairs(d.landings(goal,launch.position))do
                    if d.eligible(launch.position,point,launch.apex)then landing=point;break end
                end
                if landing then
                    local route,cost,current={},0,start
                    local stages={}
                    if launch.stages and d.stages then
                        local required,why=d.stages()
                        if not required then lastReason=why or "Upper climbing landmarks unavailable"else
                            for _,stage in ipairs(required)do if stage.position.Y>=start.Y-6 then stages[#stages+1]=stage end end
                        end
                        if not required then stages=nil end
                    end
                    if stages then
                        stages[#stages+1]={position=launch.position,name=launch.name}
                        local valid=true
                        for _,stage in ipairs(stages)do
                            if (current-stage.position).Magnitude>5 then
                                if not launch.stages then approaches=approaches+1 end
                                local part,seconds=d.climb(current,stage.position,excluded,blocked)
                                if not part or #part==0 or not part[#part].position or (part[#part].position-stage.position).Magnitude>5 then
                                    valid=false;lastReason="Checked upper approach unavailable: "..tostring(seconds);break
                                end
                                for _,edge in ipairs(part)do if edge.kind~="walk"then valid=false;lastReason="Upper approach cannot use a cannon or lower descent";break end end
                                if not valid then break end
                                for _,edge in ipairs(part)do route[#route+1]=edge end
                                cost=cost+(seconds or 0)
                            end
                            current=stage.position
                        end
                        if valid then
                            route[#route+1]={kind="descent",name=launch.name.." jump + glider",id=id,from=launch.id,to="base-landing",position=landing,takeoff=launch.position,apex=launch.apex}
                            if (landing-goal).Magnitude>5 then route[#route+1]={kind="walk",id="walk:polar-base-to-owned-hive",from="base-landing",to="goal",position=goal}end
                            return route,cost+(launch.position-landing).Magnitude/70+(landing-goal).Magnitude/math.max(1,d.speed())+3
                        end
                    end
                end
            end
        end
        return nil,lastReason
    end
    function m.plan(start,goal,excluded,used)
        if d.takeoffs then return nearbyPlan(start,goal,excluded,used)end
        local takeoff=d.takeoff()
        if not takeoff then return nil,"Mountain Top takeoff has no verified live support"end
        local blockedFlights={}
        for k,v in pairs(used)do blockedFlights[k]=v end
        for _,name in ipairs({"Red Cannon","Blue Cannon","Yellow Cannon","Slingshot"})do blockedFlights[name]=true end
        local targets={}
        if d.stages and start.Y<takeoff.Y-6 then
            local stages,why=d.stages()
            if not stages then return nil,why or "Polar-side climbing landmarks unavailable"end
            for _,s in ipairs(stages)do if s.position.Y>=start.Y-6 then targets[#targets+1]=s end end
        end
        targets[#targets+1]={position=takeoff,name="Mountain Top rim"}
        local prefix,cost,current={},0,start
        for _,stage in ipairs(targets)do
            if (current-stage.position).Magnitude>=5 then
                local part,seconds=d.climb(current,stage.position,excluded,blockedFlights)
                if not part then return nil,"Custom upper approach unavailable: "..tostring(seconds)end
                if #part==0 or not part[#part].position or (part[#part].position-stage.position).Magnitude>5 then return nil,"Custom climb did not reach its required upper landmark"end
                for _,e in ipairs(part)do
                    if e.kind~="walk"then return nil,"Upper approach cannot use a low descent or cannon detour"end
                    prefix[#prefix+1]=e
                end
                if #part>0 then part[#part].name="Climb: "..stage.name end
                cost=cost+(seconds or 0)
            end
            current=stage.position
        end
        for i,landing in ipairs(d.landings(goal))do
            local id="descent:mountain-polar-base:"..i
            if not excluded[id] and not used[id] and d.eligible(takeoff,landing)then
                local route={}
                for _,e in ipairs(prefix)do route[#route+1]=e end
                route[#route+1]={kind="descent",name="Mountain Top / Polar-side jump + glider",id=id,from="mountain-rim",to="base-landing",position=landing,takeoff=takeoff,apex=true}
                if (landing-goal).Magnitude>5 then
                    route[#route+1]={kind="walk",id="walk:upper-base-to-owned-hive",from="base-landing",to="goal",position=goal}
                end
                return route,cost+(takeoff-landing).Magnitude/70+(landing-goal).Magnitude/math.max(1,d.speed())+3
            end
        end
        return nil,"No supported base landing within measured glide range"
    end
    return m
end

end)()

local makeBearTest = (function()
-- One explicit NPC dialogue test, using normal walking, E and scoped GUI clicks only.
return function(d)
    local b={}
    local function child(o,name)return o and o:FindFirstChild(name)end
    local function textOf(o)
        local text=d.get(o,"Text")
        return type(text)=="string" and text:gsub("<[^>]+>","") or nil
    end
    function b.session(name)
        local gui=d.gui and d.gui()
        local camera=child(gui,"Camera")
        local controller=child(child(camera,"Controllers"),"NPC")
        local pointer=child(controller,"ActiveNPC")
        if not pointer then return {known=false,active=false,matching=false}end
        local active=d.get(pointer,"Value")
        local identity=child(active,"NPC")
        local npcName=active and (identity and d.get(identity,"Value") or d.get(active,"Name"))
        local cameraState=child(camera,"CamState")
        local state=cameraState and d.get(cameraState,"Value")
        local open=active~=nil and (state==nil or state=="NPC")
        return {known=true,active=open,matching=open and npcName==name,npcName=type(npcName)=="string" and npcName or nil,
            cameraState=type(state)=="string" and state or nil}
    end
    function b.dialogue(name)
        local gui=d.gui();if not gui then return end
        local session=b.session(name)
        local diagnostics={session=session,candidates={}}
        b.lastObservation=diagnostics
        -- The captured Activatables.NPCs module binds conversations through this ObjectValue.
        -- A visible template alone is not an active dialogue once that value is cleared.
        if session.known and not session.matching then return end
        local matches={}
        for i,root in ipairs(gui:GetDescendants())do
            if i>5000 then break end
            local n=root.Name:lower()
            local named=n:find("dialog",1,true) or session.matching and (n:find("npc",1,true) or n=="speech" or n=="conversation")
            local ancestor=root
            while ancestor and ancestor~=gui do
                local label=ancestor.Name:lower()
                if label:find("chat",1,true) or label:find("shop",1,true) or label:find("purchase",1,true) or label:find("trade",1,true) or label:find("talo",1,true)then named=false;break end
                ancestor=ancestor.Parent
            end
            if named and (root:IsA("GuiObject") or root:IsA("ScreenGui")) and d.visible(root)then
                local labels,button,speaker,buttons,controls={},nil,false,{},{}
                local inputSurface
                for j,o in ipairs(root:GetDescendants())do
                    if j>500 then break end
                    if d.visible(o)then
                        local text=textOf(o)
                        if type(text)=="string" and #text>0 then
                            labels[#labels+1]=text:sub(1,500)
                            if text:lower()==name:lower()then speaker=true end
                        end
                        if o:IsA("GuiButton")then
                            local label=(type(text)=="string" and text or ""):lower()
                            local id=o.Name:lower()
                            if #controls<12 then controls[#controls+1]={name=o.Name,class=o.ClassName,text=label:sub(1,80)}end
                            if label=="next" or label=="continue" or label=="skip" or label=="▶" or id=="next" or id=="continue" or id=="continuebutton" or id=="dialoguebutton" or id=="buttonoverlay"then button=o end
                            if id~="close" and id~="cancel" and label~="close" and label~="cancel" and label~="yes" and label~="no" and label~="buy" and label~="accept" and label~="decline"then buttons[#buttons+1]=o end
                        elseif session.matching and o:IsA("GuiObject") and d.get(o,"Active")==true then
                            local id=o.Name:lower()
                            if id=="buttonoverlay" or id=="dialogue" or id=="speech" or id=="text"then inputSurface=o end
                        end
                    end
                end
                if #diagnostics.candidates<8 then diagnostics.candidates[#diagnostics.candidates+1]={path=root:GetFullName(),preview=table.concat(labels," | "):sub(1,600),controls=controls}end
                if speaker or session.matching and (n=="npc" or n:find("npc",1,true) or n:find("dialog",1,true) or n=="speech" or n=="conversation")then
                    if not button and #buttons==1 then button=buttons[1]end
                    if not button and root:IsA("GuiButton")then button=root end
                    if not button and session.matching then
                        button=inputSurface or root:IsA("GuiObject") and d.get(root,"Active")==true and root or nil
                    end
                    local path=root:GetFullName()
                    matches[#matches+1]={root=root,button=button,advanceKind=button and (button:IsA("GuiButton") and "button" or "input-surface") or nil,
                        fingerprint=path.."|"..table.concat(labels,"|"):sub(1,2500),preview=table.concat(labels," | "):sub(1,600),path=path,
                        source=session.matching and "active NPC controller" or "speaker label",controls=controls}
                end
            end
        end
        local outer={}
        for _,a in ipairs(matches)do
            local nested=false
            for _,other in ipairs(matches)do if other~=a and a.root:IsDescendantOf(other.root)then nested=true;break end end
            if not nested then outer[#outer+1]=a end
        end
        if #outer==1 then return outer[1]end
    end
    function b.run(name,cancelled)
        local job={status="running",phase="Walking",pages=0};local walk
        local model,h=d.character();local npc=d.npc(name)
        local started=d.now()
        local function valid()
            local current,humanoid=d.character()
            -- The router may reset to the hive on purpose mid-approach; keep the job and adopt the respawned character.
            if d.intentionalReset and d.intentionalReset()then
                if current and current~=model and humanoid and humanoid.Health>0 then model=current end
                return job.status=="running" and not cancelled() and d.now()-started<150
            end
            return job.status=="running" and not cancelled() and d.now()-started<150 and current==model and humanoid and humanoid.Health>0
        end
        local function finish(status,reason)
            if job.status~="running"then return end
            job.status,job.reason=status,reason
            if walk and walk.status=="running"then walk.cancel()end
            d.release();d.event("bear_test_result",{name=name,status=status,reason=reason,pages=job.pages})
        end
        function job.cancel()finish("cancelled","Bear test stopped")end
        d.spawn(function()
            local ok,err=pcall(function()
                if not model or not h or not npc then finish("failed","Bear/character is not loaded");return end
                local session=b.session(name)
                if session.active and not session.matching then finish("failed","Another NPC dialogue is open; close it before this bear test");return end
                local page=d.dialogue(name)
                if page then
                    d.release();d.event("bear_dialogue_resumed",{name=name,path=page.path,source=page.source})
                else
                    local destination=d.destination(npc)
                    if not destination then finish("failed","No supported bear interaction platform");return end
                    walk=d.walk(destination,function()return not valid()end)
                    while walk.status=="running" and valid()do d.sleep(0.05)end
                    if not valid()then finish("cancelled","Bear approach cancelled");return end
                    if walk.status~="success"then finish("failed","Bear approach failed: "..tostring(walk.reason));return end
                    d.release() -- Do not retain any approach command while the camera/dialogue takes control.
                    job.phase="Waiting for Talk popup"
                    local untilPopup=d.now()+3
                    while not d.talkReady(npc,name) and valid() and d.now()<untilPopup do d.sleep(0.05)end
                    if not valid()or not d.talkReady(npc,name)then finish("failed","Expected bear Talk popup/target not observed");return end
                    d.event("bear_talk_popup",{name=name})
                    local pressed,why=d.pressE(function()return not valid()end)
                    if not pressed then finish("failed","E interaction failed: "..tostring(why));return end
                    local untilDialogue=d.now()+5
                    while valid() and d.now()<untilDialogue do page=d.dialogue(name);if page then break end;d.sleep(0.05)end
                end
                if not page then
                    d.event("bear_dialogue_unrecognized",{name=name,observation=b.lastObservation})
                    finish("failed","No recognized NPC dialogue after E; captured active-controller/UI diagnostics");return
                end
                job.phase="Dialogue"
                local last,clicks,missing,lastClick=nil,0,nil,-math.huge
                local untilDone=d.now()+35
                while valid() and d.now()<untilDone and job.pages<80 do
                    page=d.dialogue(name)
                    if not page then
                        missing=missing or d.now()
                        if d.now()-missing>0.5 then finish("success","Observed bear dialogue open, advance and close");return end
                    else
                        missing=nil
                        if page.fingerprint~=last then
                            last,clicks=page.fingerprint,0;job.pages=job.pages+1
                            d.event("bear_dialogue_page",{name=name,path=page.path,text=page.preview,page=job.pages,source=page.source,advanceKind=page.advanceKind,controls=page.controls})
                        end
                        if page.button and d.now()-lastClick>=0.4 and clicks<3 then
                            local sent,why=d.click(page.button,page.root,page.advanceKind)
                            if not sent then finish("failed","Dialogue advance rejected: "..tostring(why));return end
                            clicks=clicks+1;lastClick=d.now()
                        end
                    end
                    d.sleep(0.1)
                end
                d.event("bear_dialogue_stalled",{name=name,observation=b.lastObservation,lastPage=last,clicks=clicks})
                finish("failed","Dialogue did not close; captured unrecognized controls/no-progress diagnostics")
            end)
            if not ok then finish("failed",tostring(err))end
        end)
        return job
    end
    return b
end

end)()

local makeScopedClick = (function()
-- Normal paired mouse input restricted to a currently observed UI scope.
return function(d)
    return function(control,scope,mode)
        if d.closed() or not control or not scope or not control.Parent or not d.visible(control)then return false,"UI scope is no longer visible"end
        if control~=scope and not control:IsDescendantOf(scope)then return false,"Control is outside its observed scope"end
        if mode=="teleport"then
            local prompt=d.teleportPrompt()
            if not prompt or prompt.root~=scope or prompt.button~=control or not d.keyboardClear()then return false,"Teleport prompt changed"end
        elseif not d.ready()then return false,"Input is blocked"end
        if not control:IsA("GuiButton") and not(mode=="input-surface" and control:IsA("GuiObject") and d.get(control,"Active")==true)then return false,"Unrecognized input surface"end
        local p,s=d.get(control,"AbsolutePosition"),d.get(control,"AbsoluteSize")
        if not p or not s or type(s.X)~="number" or type(s.Y)~="number" or s.X<2 or s.Y<2 then return false,"No visible UI rectangle"end
        local x,y=math.floor(p.X+s.X/2),math.floor(p.Y+s.Y/2)
        local core,pg=d.core(),d.gui()
        local inCore=core and control:IsDescendantOf(core)
        local function inspect(container)
            if not container then return nil end
            local ok,objects=pcall(function()return container:GetGuiObjectsAtPosition(x,y)end)
            if not ok then return false end
            for _,o in ipairs(objects)do
                if d.visible(o) and (o:IsA("GuiButton") or o:IsA("TextBox") or d.get(o,"Active")==true)then
                    if o==control or o:IsDescendantOf(control)then return true end
                    if not control:IsDescendantOf(o)then return false end
                end
            end
            return nil
        end
        local coreHit=inspect(core)
        if inCore then
            if coreHit~=true then return false,"Teleport control is covered or not hit-testable"end
        else
            if coreHit~=nil then return false,"Core UI covers the dialogue"end
            if inspect(pg)~=true then return false,"Dialogue surface is covered or not hit-testable"end
        end
        return d.press(x,y,mode)
    end
end

end)()

local makeProgressionReadiness = (function()
-- Observation and previews only. This module has no feeding/combat/input/remote dependency.
return function(d)
    local readiness={}
    local function finite(n)return type(n)=="number" and n==n and math.abs(n)<math.huge end
    local function integer(n)return finite(n) and n%1==0 end
    local function child(o,name)return o and o:FindFirstChild(name)end
    local function value(o,name,classes)
        local field=child(o,name)
        if not field then return end
        for _,class in ipairs(classes)do if d.isA(field,class)then return d.get(field,"Value")end end
    end
    local function nonnegative(n)return finite(n) and n>=0 and n or nil end
    local function gifted(traits)
        if type(traits)~="table"then return end
        local count,max,gift=0,0,false
        for key,trait in pairs(traits)do
            if not integer(key) or key<1 or key>128 or type(trait)~="string"then return end
            count,max=count+1,math.max(max,key)
            if trait=="Gifted"then gift=true end
        end
        if max~=count then return end
        return gift
    end
    local function inventory(stats)
        local raw=type(stats)=="table" and type(stats.Eggs)=="table" and stats.Eggs.Treat
        return integer(raw) and raw>=0 and raw or nil
    end
    local function boundedRaw(raw,depth,budget,seen)
        local kind=type(raw)
        if kind=="string"then return #raw<=160 and raw or raw:sub(1,160).."..."end
        if kind=="boolean" or finite(raw)then return raw end
        if kind~="table"then return {kind=kind,status="unsupported raw value"}end
        if seen[raw]then return {kind="table",truncated=true,reason="repeated reference"}end
        if depth>=3 or budget.left<=0 then return {kind="table",truncated=true}end
        seen[raw]=true
        local out={kind="table",entries={}}
        for key,v in pairs(raw)do
            if #out.entries>=16 or budget.left<=0 then out.truncated=true;break end
            if type(key)=="string" or integer(key)then
                budget.left=budget.left-1
                out.entries[#out.entries+1]={key=type(key)=="string" and key:sub(1,80) or key,value=boundedRaw(v,depth+1,budget,seen)}
            else out.truncated=true end
        end
        return out
    end
    local function mutation(cached)
        local result={status="unknown",source="BeeStats.GetMutations delegates to BeeStats.BeeMutations",rawFields={},
            reason="BeeMutations schema not captured; missing or empty raw fields do not establish no mutation"}
        if cached.Traits~=nil then result.rawTraits=boundedRaw(cached.Traits,0,{left=48},{})end
        local scanned=0
        for key,raw in pairs(cached)do
            scanned=scanned+1;if scanned>128 then result.capped=true;break end
            if type(key)=="string" and key:lower():find("mut",1,true)then
                if #result.rawFields>=8 then result.capped=true;break end
