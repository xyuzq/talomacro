            if not checked then return false,failure end
            append(checked)
        end
        return true,{points=points,seconds=pathSeconds(points,c)}
    end
    manager=d.factory({toVector=vector,toAction=function(name)return name=="Jump"and Enum.PathWaypointAction.Jump or Enum.PathWaypointAction.Walk end,
        validateEdge=validate,edgeTime=modelTime})
    function bridge.load(path)
        manifestAt=-math.huge
        local raw=d.atlasJSON
        if path or not raw then
            if not d.readfile then reason="No local compiled atlas available";return false,reason end
            local ok,value=pcall(d.readfile,path or d.filename("navigation-atlas-"..d.placeVersion..".json"))
            raw=ok and value or nil
        end
        local candidate,why=decode(raw)
        if not candidate then reason=why;return false,reason end
        local index=readManifest()
        if not compatible(index,candidate)or candidate.placeId~=d.placeId or candidate.placeVersion~=d.placeVersion then reason="Compiled atlas does not match the captured navigation geometry";return false,reason end
        if type(d.extendAtlas)=="function"then
            local base={placeId=candidate.placeId,placeVersion=candidate.placeVersion,fingerprint=candidate.fingerprint,navigationFingerprint=candidate.navigationFingerprint}
            local ok,extended,detail=pcall(d.extendAtlas,candidate)
            if not ok or type(extended)~="table"then reason="Dispenser route extension failed: "..tostring(ok and detail or extended);return false,reason end
            if extended.placeId~=base.placeId or extended.placeVersion~=base.placeVersion or extended.fingerprint~=base.fingerprint
                or extended.navigationFingerprint~=base.navigationFingerprint or not compatible(index,extended)then
                reason="Dispenser route extension changed the captured map identity";return false,reason
            end
            candidate=extended
        end
        local ok,err=manager.load(candidate)
        if not ok then reason=err;return false,reason end
        data,reason=candidate,"Compiled canonical routes loaded"
        return true,reason
    end
    local function makeContext(externalCancel,freshManifest)
        if not data or manager.status().loaded~=true then return nil,nil,reason,false end
        local index=readManifest(freshManifest)
        if data.placeId~=d.placeId or data.placeVersion~=d.placeVersion or not compatible(index,data)then return nil,index,"Navigation map changed; canonical atlas requires rebuilding",false end
        local model,h,root=d.character()
        if not model or not root or not h then return nil,index,"Live character unavailable",true end
        local deadline=d.now()+2.5
        local mode=d.mode and d.mode()
        local sourceData=data
        local c={placeId=d.placeId,placeVersion=d.placeVersion,fingerprint=data.fingerprint,bees=d.countBees(),discoveredTypes=d.discoveredTypes(),
            walkSpeed=h.WalkSpeed,jumpPower=h.JumpPower,jumpHeight=h.JumpHeight,useJumpPower=h.UseJumpPower,gravity=d.world.Gravity,
            maxSlopeAngle=h.MaxSlopeAngle,hipHeight=h.HipHeight,rootSize=root.Size,collisionGroup=root.CollisionGroup,
            gear={},rejections={},maxConnectorDistance=80,maxConnectors=4,maxValidations=24}
        c.contextActive=function()
            if data~=sourceData or d.closed()or externalCancel and externalCancel()or d.now()>=deadline or d.mode and d.mode()~=mode then return false end
            local m,hum,r=d.character()
            return m==model and hum==h and r==root and not(finite(h.Health)and h.Health<=0)
        end
        c.movementChanged=function()
            local m,hum,r=d.character()
            if m~=model or hum~=h or r~=root then return false end
            return h.WalkSpeed~=c.walkSpeed or h.JumpPower~=c.jumpPower
                or h.JumpHeight~=c.jumpHeight or h.UseJumpPower~=c.useJumpPower or d.world.Gravity~=c.gravity or h.MaxSlopeAngle~=c.maxSlopeAngle
                or h.HipHeight~=c.hipHeight or root.Size~=c.rootSize or root.CollisionGroup~=c.collisionGroup
        end
        c.cancelled=function()
            if not c.contextActive()then return true end
            if c.movementChanged()then c.profileInterrupted=true;return true end
            return false
        end
        local gear=d.gear();if gear=="Glider"or gear=="Parachute"then c.gear[gear]=true end
        return c,index,nil,true,gear
    end
    local function plan(start,goal,excluded,used,options)
        local c,index,contextReason,ready,gear=makeContext()
        if not c then return nil,nil,contextReason,ready end
        local destination=vector(goal)
        if destination then for _,node in ipairs(data.nodes)do
            if node.kind=="dispenser"and(node.requiresRouteScope=="free_royal_jelly"or node.requiresRouteScope=="free_blueberry"or node.requiresRouteScope=="free_strawberry")then
                local mapped=vector(node.position)
                if mapped and(destination-mapped).Magnitude<=5 then c.routeScope=node.requiresRouteScope;c.requiredOpenGate=node.requiredOpenGate;break end
            end
        end end
        if c.requiredOpenGate and not openGate(c.requiredOpenGate)then
            local why="Required "..c.requiredOpenGate.." is closed or unavailable"
            d.telemetry.canonical={status="rejected",reason=why};return nil,nil,why,true
        end
        local scoped=c.routeScope=="free_royal_jelly"or c.routeScope=="free_blueberry"or c.routeScope=="free_strawberry"
        local cannonUsable=false
        local walkingCoverage=data.dispenserRoutes and data.dispenserRoutes.strawberryWalking
        local pinnedWalk=false
        if scoped then
            local rule=d.transport("Red Cannon")
            cannonUsable=rule and d.rules.transportAccess(rule,c.bees,c.discoveredTypes)and c.gear.Glider==true and d.cannonAvailable("Red Cannon")or false
            local origin=vector(start)
            local near=origin and destination and(origin-destination).Magnitude<=100
            if options and options.walkOnly==true then c.transportPolicy="Walking requested for movement test";cannonUsable=false
            elseif used and used["Red Cannon"]then c.transportPolicy="Checked walk after the observed Red Cannon landing"
            elseif near then c.transportPolicy="Already near the dispenser; checked walking route"
            elseif cannonUsable then c.requiredCannon="Red Cannon";c.transportPolicy="Red Cannon available: fast source-timed glide"
            else c.transportPolicy="Red Cannon/Glider unavailable: checked walking route"end
            pinnedWalk=c.routeScope=="free_strawberry"and not near and not cannonUsable and type(walkingCoverage)=="table"
            if pinnedWalk and (not finite(c.bees)or c.bees<(walkingCoverage.minBees or math.huge))then
                local why=not finite(c.bees)and "Owned hive bee count is unavailable for the pinned walking itinerary"
                    or "Pinned walking itinerary crosses a 15-bee area; a lower-tier walking route has not been verified"
                local diagnostics={routeScope=c.routeScope,transportPolicy=c.transportPolicy,bees=c.bees,walkingItinerary=walkingCoverage}
                d.telemetry.canonical={status="rejected",reason=why,diagnostics=diagnostics};return nil,nil,why,true,diagnostics
            end
        end
