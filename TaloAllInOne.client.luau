                emit("conversion_start", {ok = sent, reason = reason})
                if not sent then fail("Conversion input unavailable: " .. tostring(reason), now) end
            elseif now - conversionSince >= 8 then
                fail("Make Honey state is unknown; stand at the owned hive and inspect its button", now)
            end
        end
    end
    function c.snapshot()
        return {mode = c.mode, phase = c.phase, message = c.message, field = c.field, fillAt = c.fillAt,
            cycles = c.cycles, retries = c.retries, netHoneyPerSecond = c.netHoneyPerSecond,
            cleanupPending = c.lease ~= nil, cleanupWarning = c.cleanupWarning, observation = c.observation, resetOnStart = c.resetOnStart}
    end
    return c
end

end)()

local makeNavigator = (function()
-- Path computation and grounded waypoint following. deps.steer is driven after player input.
return function(deps)
    local nav = {active = nil}
    local function distance(a, b) return (a - b).Magnitude end
    -- tolerance grows with speed: at haste speeds (~60) a 2.5-stud circle is crossed between steering ticks and the walker bounces.
    local function reached(a, b, tolerance)
        local delta = a - b
        return math.sqrt(delta.X * delta.X + delta.Z * delta.Z) <= (tolerance or 2.5) and math.abs(delta.Y) <= 2
    end
