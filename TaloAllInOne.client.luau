    local function quantity()
        local raw=quantityBox.Text
        if type(raw)~="string"or not raw:match("^%s*%d+%s*$")then return nil,"Enter a positive whole Treat quantity; decimals and negative values are not accepted",raw end
        local n=tonumber(raw)
        if not n or n~=n or n<1 or n>9007199254740991 or n%1~=0 then return nil,"Enter a positive whole Treat quantity within the exact integer range",raw end
        return n,nil,raw
    end
    local function adjustQuantity(delta)
        local n=quantity()or view.quantity
        n=math.max(1,n+delta)
        if type(availableTreats)=="number"and availableTreats>0 then n=math.min(n,availableTreats)end
        view.quantity=n;quantityBox.Text=string.format("%.0f",n);lastFeedMessage=nil
    end
    local function showValue(n)return n==nil and "?" or tostring(n)end
    local function rawText(value,depth)
        if type(value)~="table"then return tostring(value):sub(1,100)end
        if (depth or 0)>=2 then return "{…}"end
        local keys,items={},{}
        for key in pairs(value)do keys[#keys+1]=key end
        table.sort(keys,function(a,b)return tostring(a)<tostring(b)end)
        for i,key in ipairs(keys)do
            if i>5 then items[#items+1]="…";break end
            items[#items+1]=tostring(key).."="..rawText(value[key],(depth or 0)+1)
        end
        return "{"..table.concat(items,", ").."}"
    end
    local function refresh(progress)
