local function ownHive()
    local pointer = child(player, "Honeycomb")
    local hive = isA(pointer, "ObjectValue") and pointer.Value or nil
    local hives = child(Workspace, "Honeycombs")
    if not isA(hive,"Model") or hive.Parent~=hives or not isA(child(hive,"Owner"),"ObjectValue") or child(hive,"Owner").Value~=player then
        hive=nil
        for _,candidate in ipairs(hives and hives:GetChildren() or {})do
            local owner=child(candidate,"Owner")
            if isA(owner,"ObjectValue") and owner.Value==player then
                if hive then return nil end -- Ambiguous ownership must not choose a platform.
                hive=candidate
            end
        end
    end
    if not hive then return nil end
    local owner, spawn = child(hive, "Owner"), child(hive, "SpawnPos")
    if not isA(owner, "ObjectValue") or owner.Value ~= player or not isA(spawn, "CFrameValue") then return nil end
    if not vector(spawn.Value.Position) then return nil end
    return hive, spawn.Value.Position
end
