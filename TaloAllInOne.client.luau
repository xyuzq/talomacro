                    if candidate then
                        for _,key in ipairs({"projectId","projectIds","secondaryProjects","development","maxSegmentSeconds","sideWorkBudgetAllowed","item","targetItem"}) do
                            if proposal[key]~=nil then candidate[key]=copy(proposal[key]) end
                        end
