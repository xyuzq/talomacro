local function validSnapshot(s,now,age)
    return s.schemaVersion=="talo.progression-state/1" and type(s.accountId)=="string" and s.accountId~="" and not s.historical and fresh(s.observedAt,now,age)
end
local function makeReader(s,now,age)
    local current=validSnapshot(s,now,age)
    return function(path)
        local f=tableOf(s.facts)[path]
        if not current or type(f)~="table" or f.value==nil or f.historical or f.accountId~=nil and f.accountId~=s.accountId or not fresh(f.observedAt,now,age)
            or type(f.source)~="string" or f.source=="" or not validCoverage(f.coverage)
            or not(f.status=="observed" or f.status=="derived" and f.validated==true) then return nil end
        return f.value
    end,current
end
local function stageTarget(row,bees,overrides)
    local target=quantity(row.target) and row.target or 0
    if finite(bees) then
        local best=-1
        for _,stage in ipairs(tableOf(row.stages))do
            if finite(stage.minBees) and bees>=stage.minBees and stage.minBees>=best and quantity(stage.target) then best,target=stage.minBees,stage.target end
        end
    end
    local override=tableOf(overrides)[row.resource]
    if quantity(override) then target=override end
    return target
end
local function ageStatus(row,bees)
    if not quantity(bees) then return "unknown",false,"Observe the current occupied bee count" end
    if finite(row.minBees) and bees<row.minBees then return "waiting",false,"Starts from "..row.minBees.." occupied bees; do not interrupt earlier development" end
    if finite(row.maxBees) and bees>row.maxBees then return "disabled",false,"Earlier-stage project is dormant; do not replay starter upgrades" end
    return nil,true,nil
end
local function sideBudget(snapshot,settings,strategy,now,age)
    local share=finite(settings.sideWorkShare) and settings.sideWorkShare or strategy.sideWorkShare or strategy.sideWorkShareDefault or .2
    share=finite(share) and math.max(0,math.min(.35,share)) or .2
    local window=quantity(strategy.sideWorkWindowSeconds) and math.max(60,strategy.sideWorkWindowSeconds) or 600
    local raw=tableOf(tableOf(snapshot.runtime).developmentWork)
    local known=validSnapshot(snapshot,now,age) and fresh(raw.observedAt,now,age) and finite(raw.windowSeconds) and raw.windowSeconds>0
        and finite(raw.sideSeconds) and raw.sideSeconds>=0 and raw.sideSeconds<=raw.windowSeconds
        and (raw.accountId==nil or raw.accountId==snapshot.accountId)
    local used=known and raw.sideSeconds or nil
    local allowance=known and raw.windowSeconds*share or nil
    return {share=share,windowSeconds=known and raw.windowSeconds or window,usedSeconds=used,allowanceSeconds=allowance,
        allowed=known and share>0 and used<allowance or false,status=not known and "unknown" or share==0 and "disabled" or used>=allowance and "exhausted" or "available",
        reason=not known and "Observe side-work time before enabling a dedicated ingredient detour" or "Only a bounded share of time may go to dedicated development chores"}
end
local function auditFrom(snapshot,read,now,age)
    local audit=read("hive.audit")
    if type(audit)~="table" then
        audit=snapshot.hiveAudit
        if not validSnapshot(snapshot,now,age) or type(audit)~="table" or not fresh(audit.observedAt,now,age) or type(audit.source)~="string" or audit.source==""
            or not validCoverage(audit.coverage) or not(audit.status=="observed" or audit.status=="derived" and audit.validated==true) then audit=nil end
    end
    if type(audit)=="table" and not(audit.status=="observed" or audit.status=="derived" and audit.validated==true) then audit=nil end
