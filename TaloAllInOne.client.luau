local function allocationReservations(snapshot,now)
    local out={};local ledger=tableOf(snapshot.ledger)
    if ledger.accountId~=snapshot.accountId then return out end
    for _,r in pairs(tableOf(ledger.reservations))do
        if type(r)=="table" and type(r.amounts)=="table" then
            local tx=r.transactionId and tableOf(ledger.transactions)[r.transactionId]
            local pinned=type(tx)=="table" and (tx.state=="sent" or tx.state=="uncertain_after_send")
            if pinned or r.expiresAt==nil or finite(r.expiresAt) and r.expiresAt>now then
                for name,n in pairs(r.amounts)do if type(name)=="string" and quantity(n) then out[name]=math.min(LIMIT,(out[name] or 0)+n) end end
            end
        end
    end
    for resource,n in pairs(tableOf(ledger.protectedMinimums))do if quantity(n)then out[resource]=math.min(LIMIT,(out[resource] or 0)+n)end end
    return out
end
local function questOverlap(snapshot,now,age,current)
    local result={status="unknown",ready=false,fields={},reason="Observe current accepted quest definitions and explicit field access"}
    if not current then return result end
    local accessible={}
    for _,field in ipairs(tableOf(snapshot.fields))do
        if type(field)=="table" and type(field.name)=="string" and field.accessible==true and field.usable~=false then accessible[field.name]=field end
    end
    local mapped=false
    for index,quest in ipairs(tableOf(snapshot.quests))do
        -- A flat objective does not prove how many distinct quests are accepted.
        if type(quest)=="table" and type(quest.objectives)=="table" and quest.accepted~=false and quest.active~=false then
            local id=quest.id or quest.name
            if type(id)=="string" and id~="" then
                for _,objective in ipairs(quest.objectives)do
                    if type(objective)=="table" and (objective.status=="observed" or objective.status=="derived" and objective.validated==true)
                        and fresh(objective.observedAt,now,age) and type(objective.source)=="string" and objective.source~=""
                        and not objective.historical and (objective.coverage==nil or validCoverage(objective.coverage)) then
                        local remaining=objective.remaining
                        if not finite(remaining) and finite(objective.target) and finite(objective.current) then remaining=math.max(0,objective.target-objective.current) end
                        if finite(objective.target) and objective.target>0 and (finite(remaining) and remaining>0 or remaining==nil and objective.progressStatus=="unknown") then
                            for name,field in pairs(accessible)do
                                if ((objective.kind=="field_pollen" or objective.kind=="goo") and objective.field==name)
                                    or objective.kind=="color_pollen" and type(objective.color)=="string" and objective.color==field.color then
                                    result.fields[name]=result.fields[name] or {};result.fields[name][id]=true;mapped=true
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    local counts={}
    for _,name in ipairs(sortedKeys(result.fields))do
        local ids=sortedKeys(result.fields[name]);result.fields[name]=ids;counts[name]=#ids
        if #ids>=2 then result.ready=true;result.field=result.field or name end
    end
    result.counts=counts
    if mapped then result.status="observed";result.reason=result.ready and "Distinct current accepted quests overlap an explicitly accessible field; remaining amounts may still be unknown" or "Current mapped objectives do not yet establish a two-quest field overlap" end
    return result
end

function Development.evaluate(policy,snapshot,settings,now)
    settings=tableOf(settings);snapshot=tableOf(snapshot);policy=tableOf(policy);now=finite(now) and now or 0
    local config=tableOf(policy.development);local age=finite(settings.maxFactAgeSeconds) and settings.maxFactAgeSeconds or 120
    local read,current=makeReader(snapshot,now,age)
    local bees=read("hive.occupiedCells")
    local report={schemaVersion="talo.development-plan/1",projects={},materialPlan={},hiveAudit=auditFrom(snapshot,read,now,age),purchaseRules={},blockedPurchases={},
        fieldWeights={},fieldProjects={},potentialFieldWeights={},proposals={},protectedResources={},optionalSpendable={},ingredientDemand={},planningAllocations={},
        blockers={},strategy=copy(tableOf(config.strategy)),executionEnabled=false}
    report.sideWorkBudget=sideBudget(snapshot,settings,tableOf(config.strategy),now,age)
