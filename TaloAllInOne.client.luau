    end
    function bridge.inspect(now)
        local m,reason=main();local out={available=false,capabilities={},reason=reason,observedAt=now}
        if not m then latest=out;return out end
        out.present=true
        local capOK,caps=pcall(m.progressionCapabilities)
        local obsOK,observation=pcall(m.progressionObserve)
        if not capOK or not obsOK then out.reason="Main macro observation failed: "..tostring(not capOK and caps or observation):sub(1,220)
        elseif not bound(caps,now) or not bound(observation,now) then out.reason="Waiting for fresh main-macro observations for this account and map"
        else
            out.available=true;out.reason="Ready. Start runs the available progression actions."
            for action,cap in pairs(type(caps.actions)=="table" and caps.actions or {}) do
                if actions[action] and type(cap)=="table" then
                    local row=plain(cap);row.accountId=d.accountId;row.placeVersion=caps.placeVersion
                    row.observedAt=caps.observedAt;row.source=type(caps.source)=="string" and caps.source or "live macro capabilities"
                    out.capabilities[action]=row
                end
            end
