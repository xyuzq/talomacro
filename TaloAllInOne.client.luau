            local result,index={points[1]},1
            while index<#points do
                if not valid()then return nil end
                local chosen=index+1
                if not points[chosen].Action then
                    for j=math.min(#points,index+8),index+2,-1 do
                        local jump=false
                        for k=index+1,j do if points[k].Action then jump=true;break end end
                        if not jump then
                            local clear,needsJump=deps.segment(points[index].Position,points[j].Position)
                            if not valid()then return nil end
                            if clear and not needsJump then chosen=j;break end
                        end
                    end
                end
                result[#result+1]=points[chosen];index=chosen
            end
            return result
        end
        local supportedStart,startReason = sample(start.X, start.Z, start.Y)
        local supportedGoal,goalReason = sample(goal.X, goal.Z, goal.Y)
        if not supportedStart or not supportedGoal then return nil, "Start/goal has no suitable ground ["..(not supportedStart and "START:"..tostring(startReason or "UNKNOWN") or "GOAL:"..tostring(goalReason or "UNKNOWN")).."]" end
        if math.abs(supportedStart.Y-start.Y)>(options.startTolerance or 3)then return nil,"Start support disagrees with grounded character height [START_HEIGHT_MISMATCH: "..start.Y.." -> "..supportedStart.Y.."]"end
        if math.abs(supportedGoal.Y-goal.Y)>(options.goalTolerance or 3)then return nil,"Goal support disagrees with destination height [GOAL_HEIGHT_MISMATCH: "..goal.Y.." -> "..supportedGoal.Y.."]"end
        if not valid() then return nil, "Cancelled surface route" end
        if planar(supportedStart, supportedGoal) <= 360 then
            local clear, jump = deps.segment(supportedStart, supportedGoal)
            if not valid()then return nil,interrupted()end
            if clear and (not jump or planar(supportedStart, supportedGoal) <= step * 1.5) then
                return {{Position = supportedStart}, {Position = supportedGoal, Action = jump and "Jump" or nil}}, "grounded direct segment"
            end
        end
        local padding = math.max(75, math.min(160, planar(start, goal) * 0.35))
        local minX, maxX, minZ, maxZ = math.min(start.X, goal.X) - padding, math.max(start.X, goal.X) + padding,
            math.min(start.Z, goal.Z) - padding, math.max(start.Z, goal.Z) + padding
        local function key(x, z, y) return x .. ":" .. z .. ":" .. math.floor(y / 2+0.5) end
        local initial = {x = 0, z = 0, p = supportedStart, g = 0}
        initial.key, initial.f = key(0, 0, supportedStart.Y), length(supportedStart, supportedGoal)
        local heap, best, closed, expanded = {}, {[initial.key] = 0}, {}, 0
        push(heap, initial)
        while #heap > 0 and expanded < (options.nodes or 2400) and valid() do
            local node = pop(heap)
