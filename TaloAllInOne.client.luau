local function evaluate(node,read,settings)
    if type(node)~="table" then return "unknown",{} end
    local group=node.all or node.any
    if group then
        if type(group)~="table" or #group==0 then return "unknown",{} end
        local missing,hasUnknown,hasTrue,hasFalse={},false,false,false
        for _,child in ipairs(group) do
            local truth,unknown=evaluate(child,read,settings)
            hasUnknown=hasUnknown or truth=="unknown";hasTrue=hasTrue or truth=="true";hasFalse=hasFalse or truth=="false"
            for _,path in ipairs(unknown) do missing[#missing+1]=path end
        end
        if node.all and hasFalse then return "false",sortedUnique(missing) end
        if node.any and hasTrue then return "true",{} end
        return hasUnknown and "unknown" or node.all and "true" or "false",sortedUnique(missing)
    end
    if type(node.fact)~="string" then return "unknown",{} end
    local value=read(node.fact)
    if value==nil then return "unknown",{node.fact} end
    local expected=node.value
    if node.op=="gte_setting" or node.op=="eq_setting" then
        expected=lookup(settings,node.setting)
        if expected==nil then return "unknown",{"settings."..tostring(node.setting)} end
    end
    local result
    if node.op=="known" then result=true
    elseif node.op=="eq" or node.op=="eq_setting" then result=value==expected
    elseif node.op=="gte" or node.op=="gte_setting" then
        if not finite(value) or not finite(expected) then return "unknown",{node.fact} end
        result=value>=expected
    elseif node.op=="contains" then
        if type(value)~="table" then return "unknown",{node.fact} end
        result=includes(value,expected)
    elseif node.op=="in" then
        if type(expected)~="table" then return "unknown",{node.fact} end
        result=includes(expected,value)
    else return "unknown",{node.fact} end
    return result and "true" or "false",{}
end
local function resolveSettings(policy,input)
    local settings=copy(input or {})
