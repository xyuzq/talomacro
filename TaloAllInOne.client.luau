function clientTools.confirmEarlyHarvest()
    local pg=player:FindFirstChildOfClass("PlayerGui");if not pg then return false end
    local question
    for i,o in ipairs(pg:GetDescendants())do
        if i>8000 then break end
        if(o:IsA("TextLabel")or o:IsA("TextBox"))and visible(o)and type(o.Text)=="string"and o.Text:find("done growing",1,true)then question=o;break end
    end
    local scope=question and question:FindFirstAncestorOfClass("ScreenGui")
    if not scope then event("early_harvest_confirm",{ok=false,reason="Question not visible"});return false end
    for _,o in ipairs(scope:GetDescendants())do
        if o:IsA("GuiButton")and visible(o)then
            local label=o:IsA("TextButton")and o.Text or""
            if label==""then local t=o:FindFirstChildWhichIsA("TextLabel",true);label=t and t.Text or""end
            if label:lower():match("^%s*yes%s*$")then
                local ok,why=clickScoped(o,scope);event("early_harvest_confirm",{ok=ok,reason=why});return ok
            end
        end
    end
    event("early_harvest_confirm",{ok=false,reason="Yes button not found"});return false
end
