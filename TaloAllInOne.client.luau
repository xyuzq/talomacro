            local free,why,raw=available(resource,inventory,at,nil,minimums)
            if free==nil or free<n or raw<0 then return false,why or ("Insufficient unreserved "..resource) end
        end
        for resource in pairs(minimums) do
            local free,why,raw=available(resource,inventory,at,nil,minimums)
            if free==nil or raw<(amounts[resource] or 0) then return false,why or ("Protected minimum conflicts with reserved "..resource) end
        end
        for resource,n in pairs(minimums) do state.protectedMinimums[resource]=math.max(state.protectedMinimums[resource] or 0,n) end
