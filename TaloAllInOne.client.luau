                    if capturedGoal and deployed then transition("landing_hold","Over landing; waiting for verified support",part)end
                    if capturedGoal and deployed and horizontal<=closeRadius and math.abs(part.Position.Y-goal.Y)<=(short and 4 or 12) and landingSafe then
                        local safe,floorY=landingSafe(part.Position,goal)
