-- Same test as the game's Activatables.Shops.Search: Floor box plus 14 studs of headroom, or inside the Terrain part.
function clientTools.inShop(zone,kind,p)
    if kind=="floor"then
        local lo,hi=zone.Position-zone.Size/2,zone.Position+zone.Size/2+Vector3.new(0,14,0)
        return p.X>=lo.X and p.Y>=lo.Y and p.Z>=lo.Z and p.X<hi.X and p.Y<hi.Y and p.Z<hi.Z
    end
    local l=zone.CFrame:PointToObjectSpace(p)
    return math.abs(l.X)<=zone.Size.X/2 and math.abs(l.Y)<=zone.Size.Y/2 and math.abs(l.Z)<=zone.Size.Z/2
end
