                        local row={grid={x=x,y=y},x=x,y=y,slotId=id,slotName=tostring(d.get(cell,"Name") or ""):sub(1,100),
                            cellType=kind,locked=locked,status="empty",previewEligible=false}
                        if kind~="Empty"then
                            local label=kind:match("^(.+)Bee$")
                            local cacheType=type(cached)=="table" and cached.Type
