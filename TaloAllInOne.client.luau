            local contract=contracts[action] or {}
            local capability=type(snapshot.capabilities)=="table" and snapshot.capabilities[action] or nil
            local blocked={"policy_preview_only"}
            if not current then blocked[#blocked+1]="fresh_account_snapshot_required" end
            if action~="observe" and read("account.identity")==nil then blocked[#blocked+1]="account_identity_required" end
            if action~="observe" and action~="claim_hive" and read("hive.ownership")~="owned" then blocked[#blocked+1]="owned_hive_required" end
            if type(capability)~="table" or capability.implemented~=true then blocked[#blocked+1]="driver_not_implemented"
            elseif capability.liveAccepted~=true or capability.status=="failing" then blocked[#blocked+1]="driver_live_acceptance_pending" end
            if contract.requiresCostReservation then
