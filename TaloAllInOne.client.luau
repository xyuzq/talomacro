            local row=byId[goal.id];report.goals[#report.goals+1]=row
            if row.status=="complete" then report.completedGoalIds[#report.completedGoalIds+1]=row.id
            elseif row.status=="ready" or row.status=="unknown" then report.frontier[#report.frontier+1]=copy(row) end
        end
        table.sort(report.goals,function(a,b)return a.phase<b.phase or a.phase==b.phase and a.id<b.id end)
        table.sort(report.frontier,function(a,b)return a.phase<b.phase or a.phase==b.phase and a.id<b.id end)
        report.fieldScores=current and rankFields(snapshot,settings,now) or {}
