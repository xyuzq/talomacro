    local mine,other,shared=false,false,false
    for _,e in ipairs(evidence) do
        if e.kind=="shared" and e.value==true then shared=true
        elseif e.kind=="mine" and type(e.value)=="boolean" then
            if e.value then mine=true else other=true end
        elseif e.kind=="owner" and e.value~=nil and e.value~="" then
            if e.value==localId or e.value==localName or (type(e.value)=="string" and tonumber(e.value)==localId) then mine=true
            elseif type(e.value)=="number" or type(e.value)=="string" then other=true end
        end
    end
    if other then return "other" end -- Conflicting evidence never authorizes a detour.
    if mine then return "mine" end
    return shared and "shared" or "unknown"
end
function perception.radius(bees,attack,healthFraction)
    local weak=not finite(attack) or attack<20
    local r=weak and 11 or 8
    if not finite(bees) or bees<5 then r=math.max(r,13) end
    if finite(healthFraction) and healthFraction<0.5 then r=r+3 end
    return r
end
