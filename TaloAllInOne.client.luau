            if not o.atHive then fail("Moved away from the owned hive during conversion", now); return end
            if o.pollen <= 0 then
                if c.lease then c.lease.cleanupUntil = now + 8 end
                phase("Conversion finishing", "Bag empty; releasing this loop's conversion")
                return
            end
            if o.pollen < bestPollen then bestPollen, lastConversionProgress = o.pollen, now end
            if now - lastConversionProgress > 30 or now - conversionSince > 240 then
                fail("Conversion made no progress or exceeded its time budget", now); return
            end
