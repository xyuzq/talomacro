local makeReturnLandings = (function()
-- Candidate intermediate descent landings are sampled from live collision geometry.
return function(d)
    local m={}
    function m.add(nodes,goal,gear)
        local sources={}
        for id,n in pairs(nodes)do if id=="start" or n.takeoff or id:sub(1,4)=="rim:"then sources[#sources+1]={id=id,node=n}end end
        table.sort(sources,function(a,b)return a.id<b.id end)
        local count,queries,seen=0,0,{}
        for _,source in ipairs(sources)do
            local p=source.node.position;local v=goal-p;local length=math.sqrt(v.X*v.X+v.Z*v.Z)
            if length>30 and p.Y-goal.Y>20 then
                local x,z=v.X/length,v.Z/length
                for _,angle in ipairs({0,-0.65,0.65,-1.3,1.3})do
                    local c,s=math.cos(angle),math.sin(angle)
                    for _,distance in ipairs({35,60,90,120,170,220,280})do
                        if queries>=100 or count>=24 then return count end
                        queries=queries+1
                        local q=d.floor(Vector3.new(p.X+(x*c-z*s)*distance,p.Y,p.Z+(x*s+z*c)*distance))
                        local key=q and source.id..":"..math.floor(q.X/8)..":"..math.floor(q.Y/8)..":"..math.floor(q.Z/8)
                        if q and not seen[key] and q.Y<p.Y-20 and p.Y-q.Y<250 and d.eligible(p,q,gear) and d.allowed(q)then
                            seen[key]=true
                            count=count+1
                            nodes["drop:"..source.id..":"..count]={position=q,landing=true,descentFrom=source.id}
                        end
                    end
                end
            end
        end
        return count
    end
    return m
end

end)()

local makeUpperReturn = (function()
-- Prefer a supported nearby upper takeoff and an in-range intermediate base landing.
return function(d)
    local m={}
    local function nearbyPlan(start,goal,excluded,used)
        local blocked={}
        for key,value in pairs(used)do blocked[key]=value end
        for _,name in ipairs({"Red Cannon","Blue Cannon","Yellow Cannon","Slingshot"})do blocked[name]=true end
        local approaches,lastReason=0,"No untried supported takeoff and landing within measured glide range"
        for _,launch in ipairs(d.takeoffs(start,goal))do
            local id="descent:polar-return:"..launch.id
            if not excluded[id] and not used[id] and (launch.stages or approaches<3)then
                local landing
                for _,point in ipairs(d.landings(goal,launch.position))do
                    if d.eligible(launch.position,point,launch.apex)then landing=point;break end
                end
                if landing then
                    local route,cost,current={},0,start
                    local stages={}
                    if launch.stages and d.stages then
                        local required,why=d.stages()
                        if not required then lastReason=why or "Upper climbing landmarks unavailable"else
                            for _,stage in ipairs(required)do if stage.position.Y>=start.Y-6 then stages[#stages+1]=stage end end
                        end
                        if not required then stages=nil end
                    end
                    if stages then
                        stages[#stages+1]={position=launch.position,name=launch.name}
                        local valid=true
                        for _,stage in ipairs(stages)do
                            if (current-stage.position).Magnitude>5 then
                                if not launch.stages then approaches=approaches+1 end
                                local part,seconds=d.climb(current,stage.position,excluded,blocked)
                                if not part or #part==0 or not part[#part].position or (part[#part].position-stage.position).Magnitude>5 then
                                    valid=false;lastReason="Checked upper approach unavailable: "..tostring(seconds);break
                                end
                                for _,edge in ipairs(part)do if edge.kind~="walk"then valid=false;lastReason="Upper approach cannot use a cannon or lower descent";break end end
                                if not valid then break end
                                for _,edge in ipairs(part)do route[#route+1]=edge end
                                cost=cost+(seconds or 0)
                            end
                            current=stage.position
                        end
                        if valid then
                            route[#route+1]={kind="descent",name=launch.name.." jump + glider",id=id,from=launch.id,to="base-landing",position=landing,takeoff=launch.position,apex=launch.apex}
                            if (landing-goal).Magnitude>5 then route[#route+1]={kind="walk",id="walk:polar-base-to-owned-hive",from="base-landing",to="goal",position=goal}end
                            return route,cost+(launch.position-landing).Magnitude/70+(landing-goal).Magnitude/math.max(1,d.speed())+3
                        end
                    end
                end
            end
        end
        return nil,lastReason
    end
    function m.plan(start,goal,excluded,used)
        if d.takeoffs then return nearbyPlan(start,goal,excluded,used)end
        local takeoff=d.takeoff()
        if not takeoff then return nil,"Mountain Top takeoff has no verified live support"end
        local blockedFlights={}
        for k,v in pairs(used)do blockedFlights[k]=v end
        for _,name in ipairs({"Red Cannon","Blue Cannon","Yellow Cannon","Slingshot"})do blockedFlights[name]=true end
        local targets={}
        if d.stages and start.Y<takeoff.Y-6 then
            local stages,why=d.stages()
            if not stages then return nil,why or "Polar-side climbing landmarks unavailable"end
            for _,s in ipairs(stages)do if s.position.Y>=start.Y-6 then targets[#targets+1]=s end end
        end
        targets[#targets+1]={position=takeoff,name="Mountain Top rim"}
        local prefix,cost,current={},0,start
        for _,stage in ipairs(targets)do
            if (current-stage.position).Magnitude>=5 then
                local part,seconds=d.climb(current,stage.position,excluded,blockedFlights)
                if not part then return nil,"Custom upper approach unavailable: "..tostring(seconds)end
                if #part==0 or not part[#part].position or (part[#part].position-stage.position).Magnitude>5 then return nil,"Custom climb did not reach its required upper landmark"end
                for _,e in ipairs(part)do
                    if e.kind~="walk"then return nil,"Upper approach cannot use a low descent or cannon detour"end
                    prefix[#prefix+1]=e
                end
                if #part>0 then part[#part].name="Climb: "..stage.name end
                cost=cost+(seconds or 0)
            end
            current=stage.position
        end
        for i,landing in ipairs(d.landings(goal))do
            local id="descent:mountain-polar-base:"..i
            if not excluded[id] and not used[id] and d.eligible(takeoff,landing)then
                local route={}
                for _,e in ipairs(prefix)do route[#route+1]=e end
                route[#route+1]={kind="descent",name="Mountain Top / Polar-side jump + glider",id=id,from="mountain-rim",to="base-landing",position=landing,takeoff=takeoff,apex=true}
                if (landing-goal).Magnitude>5 then
                    route[#route+1]={kind="walk",id="walk:upper-base-to-owned-hive",from="base-landing",to="goal",position=goal}
                end
                return route,cost+(takeoff-landing).Magnitude/70+(landing-goal).Magnitude/math.max(1,d.speed())+3
            end
        end
        return nil,"No supported base landing within measured glide range"
    end
    return m
end

end)()

