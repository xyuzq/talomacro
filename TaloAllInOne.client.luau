function EconomyCatalog.checkRequirements(requirements,observation,now)

    local result={known=true,met=true,rows={}}

    local o=type(observation)=="table" and observation or {}

    local fresh=finite(now) and current(o.observedAt,now) and key(o.source) and o.complete==true

    for _,r in ipairs(type(requirements)=="table" and requirements or {})do

        local known,met,count=false,false,nil

        if fresh and type(r)=="table" then

            if r.Condition=="PlaceInfo.IsReleaseGame" and o.isReleaseGame==false then known,met=true,true

            elseif r.Condition==nil or r.Condition=="PlaceInfo.IsReleaseGame" and o.isReleaseGame==true then

                if r.Type=="Earn Badges" and type(o.badges)=="table" and quantity(r.Amount or 1) and (r.Tier==nil or quantity(r.Tier))then

                    known,count=true,0

                    for name,value in pairs(o.badges)do if not key(name) or not quantity(value)then known=false end end

                    if r.Set then

                        if not key(r.Set)then known=false

                        else count=o.badges[r.Set] or 0;if not quantity(count)then count=0;known=false end;if r.Tier~=nil then count=count>=r.Tier and 1 or 0 end end

                    else

                        for _,value in pairs(o.badges)do

                            if quantity(value)then count=count+(r.Tier~=nil and (value>=r.Tier and 1 or 0) or value)end

                        end

                    end

                    known=known and quantity(count)

                    met=known and count>=(r.Amount or 1)

                elseif r.Type=="Completed Quests" and key(r.Pool) and not r.Name and not r.Quests and not r.TotalTag and type(o.questPoolCounts)=="table" and quantity(r.Amount or 1)then

                    count=o.questPoolCounts[r.Pool] or 0;known=quantity(count);met=known and count>=(r.Amount or 1)

                end

            end

        end

        result.rows[#result.rows+1]={known=known,met=met,count=count,requirement=copy(r)}

        result.known=result.known and known;result.met=result.met and known and met

    end

