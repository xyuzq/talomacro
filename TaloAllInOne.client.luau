                    local x, z = node.x + delta[1], node.z + delta[2]
                    local wx, wz = supportedStart.X + x * step, supportedStart.Z + z * step
                    if wx >= minX and wx <= maxX and wz >= minZ and wz <= maxZ then
                        local p = sample(wx, wz, node.p.Y)
                        if p then
                            local id = key(x, z, p.Y)
                            local lower=node.g+length(node.p,p)+math.max(0,p.Y-node.p.Y)*0.4
                            if not closed[id] and (not best[id] or lower<best[id])then
                                local clear, jump = deps.segment(node.p, p)
                                local g=lower+(jump and (options.jumpPenalty or 8) or 0)
                                if best[id] and g>=best[id]then clear=false end
                                if clear then
                                    best[id] = g
                                    push(heap, {x = x, z = z, p = p, key = id, parent = node, jump = jump, g = g, f = g + length(p, supportedGoal)*heuristicWeight})
                                end
                            end
                        end
                    end
                end
            end
        end
        return nil, cancelled() and "Cancelled surface route" or ("No checked ground route within budget (" .. expanded .. " cells)")
    end
end

end)()

local makeController = (function()
-- Dependency-injected gameplay state machine; no Roblox globals or yielding calls.
return function(deps, options)
    local config = options or {}
