                                local nextPoint=waypoints[index+1]
                                local precision=point.Precision==true or(nextPoint and deps.isJump(nextPoint)and nextPoint.Takeoff and distance(point.Position,nextPoint.Takeoff)<=0.25)
                                local startSpeed = humanoid.WalkSpeed
                                if not (startSpeed > 0) then error("WalkSpeed is not positive") end
                                local started, lastMoved = deps.now(), deps.now()
