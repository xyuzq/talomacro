            local _,humanoid,part=deps.character()
            local delta=goal-part.Position
            local horizontal=math.sqrt(delta.X*delta.X+delta.Z*delta.Z)
            record.apexY=math.max(record.apexY,part.Position.Y)
            local velocity=part.AssemblyLinearVelocity
            if deps.now()-capturedAt>=(short and 0.03 or 0.15) and velocity and(deployed or record.descentClose)and deps.airborne(humanoid)then
                capturedAt=deps.now()
                local speed=math.sqrt(velocity.X^2+velocity.Z^2)
                if #record.samples<100 then record.samples[#record.samples+1]={t=deps.now()-started,x=part.Position.X,y=part.Position.Y,z=part.Position.Z,
                    vX=velocity.X,vY=velocity.Y,vZ=velocity.Z,horizontal=speed,closed=not deployed}end
