end
local function colorScoped(path)
    return path:find("selectedColor",1,true) or path:find("selectedBuild",1,true) or path:find("selectedGifted",1,true)
        or path=="completion.allEnabledCriteriaVerified"
end
local function coverageKnown(coverage)
    if type(coverage)=="string" then
        local lower=coverage:lower()
