                                row.bond=nonnegative(cached.Bond)
                                row.gifted=gifted(cached.Traits)
                                row.giftedSource=row.gifted~=nil and "complete cache Traits membership" or "unknown/malformed Traits"
                                row.mutation=mutation(cached)
                                row.beequip=beequip(cached,"Honeycomb.x"..x..".y"..y)
                                if child(cell,"GiftedCell")then
                                    row.giftedMarker=true
