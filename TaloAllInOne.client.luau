local worldRules = (function()
-- Field access is distinct from collector/discovery unlocks and route availability.
local rules = {}
-- color: dominant flower colour (standard BSS layout; "mixed" = no dominant colour). Used for quest/yield scoring only.
rules.fields = {
    {name = "Sunflower Field", bees = 0, color = "white"}, {name = "Dandelion Field", bees = 0, color = "white"},
    {name = "Mushroom Field", bees = 0, color = "red"}, {name = "Blue Flower Field", bees = 0, color = "blue"}, {name = "Clover Field", bees = 0, color = "mixed"},
    {name = "Spider Field", bees = 5, color = "white"}, {name = "Bamboo Field", bees = 5, color = "blue"}, {name = "Strawberry Field", bees = 5, color = "red"},
    {name = "Pineapple Patch", bees = 10, color = "white"}, {name = "Stump Field", bees = 10, color = "blue"},
    {name = "Cactus Field", bees = 15, color = "mixed"}, {name = "Pumpkin Patch", bees = 15, color = "white"},
    {name = "Pine Tree Forest", bees = 15, color = "blue"}, {name = "Rose Field", bees = 15, color = "red"},
    {name = "Mountain Top Field", bees = 25, color = "mixed"}, {name = "Coconut Field", bees = 35, color = "white"}, {name = "Pepper Patch", bees = 35, color = "red"},
    {name = "Ant Field", bees = 20, special = "Ant Pass and active challenge required"},
    {name = "Hub Field", special = "Portal access; walking route unavailable"},
    {name = "Mixed Brick Field", special = "Event transport; access not mapped"},
    {name = "Blue Brick Field", special = "Event transport; access not mapped"},
    {name = "Red Brick Field", special = "Event transport; access not mapped"},
    {name = "White Brick Field", special = "Event transport; access not mapped"},
}
rules.transports = {
    {name = "Red Cannon", types = 25, bees = 0, landing = "Mountain Top Field", landingBees = 25},
    {name = "Yellow Cannon", types = 12, bees = 10, landing = "Hive area", landingBees = 0},
    {name = "Slingshot", types = 8, bees = 0, landing = "Pineapple Patch", landingBees = 10},
    -- Its activation is catalogued, but a static landing is not fabricated.
    {name = "Blue Cannon", types = 16, bees = 15, landingBees = 0},
}
rules.gates = {
    {name = "5 Bee Gate", bees = 5}, {name = "10 Bee Gate", bees = 10}, {name = "15 Bee Gate", bees = 15},
    {name = "20 Bee Gate", bees = 20}, {name = "25 Bee Gate", bees = 25}, {name = "35 Bee Gate", bees = 35},
}
function rules.field(name)
    for _, entry in ipairs(rules.fields) do if entry.name == name then return entry end end
end
function rules.access(name, bees, present)
    local entry = rules.field(name)
    if not entry then return false, "unknown", "Unmapped field requirements" end
    if entry.bees and entry.bees > 0 and type(bees) ~= "number" then return false, "unknown", "Current bee count unavailable" end
    if entry.bees and type(bees) == "number" and bees < entry.bees then
        return false, "locked", string.format("Needs %d bees; you have %d", entry.bees, bees)
    end
    if entry.special then return false, "special", entry.special end
    if not present then return false, "not_streamed", "Field is not loaded on this client" end
    return true, "unlocked", entry.bees == 0 and "Starting field" or ("Unlocked: " .. entry.bees .. " bees")
end
function rules.transportAccess(entry, bees, types)
    if entry.bees > 0 and (type(bees) ~= "number" or bees < entry.bees) then return false, "Bee gate is locked" end
    if type(types) ~= "number" or types < entry.types then return false, "Needs " .. entry.types .. " discovered bee types" end
    if type(bees) ~= "number" or bees < entry.landingBees then return false, "Landing area's bee gate is locked" end
    return true
end
-- A nearby pair of freshly projected terrain tops can propose a multi-step
-- climb. This never proves a traversable path or changes a physical jump limit.
function rules.terraceLink(a,b,jumpHeight)
    local x,y=a.sourceBounds,b.sourceBounds
    if not a.terrain or not b.terrain or not x or not y or type(jumpHeight)~="number"then return false end
    local p,q=a.position,b.position
    local dx,dz=q.X-p.X,q.Z-p.Z
    local horizontal=math.sqrt(dx*dx+dz*dz)
    local rise=q.Y-p.Y
    if rise<=math.max(1.5,jumpHeight-0.9) or rise>math.min(80,jumpHeight*4) or horizontal>100 or horizontal<rise*0.75 then return false end
    local gx=math.max(0,x.minX-y.maxX,y.minX-x.maxX)
    local gz=math.max(0,x.minZ-y.maxZ,y.minZ-x.maxZ)
    return gx*gx+gz*gz<=12*12
end
-- Repeat a verified useful transport from the same origin region. Failed/locked edges are absent.
function rules.preferFlight(nodes,edges,name)
    local toy="toy:"..name
    if not nodes[toy]then return end
    local walkEdges={}
    for id,list in pairs(edges)do
        walkEdges[id]={}
        for _,e in ipairs(list)do if e.kind=="walk"then walkEdges[id][#walkEdges[id]+1]=e end end
    end
    local prefix,cost=rules.shortest(nodes,walkEdges,"start",toy)
    if not prefix then return end
    for _,e in ipairs(edges[toy] or {})do
        if e.kind=="flight" and e.to=="goal"then prefix[#prefix+1]=e;return prefix,cost+e.cost end
    end
end
-- Dijkstra chooses estimated time, including directed flight edges and failed-edge exclusions.
function rules.shortest(nodes, edges, startId, goalId)
    local cost, previous, visited = {[startId] = 0}, {}, {}
    while true do
        local best, bestCost
        for id, value in pairs(cost) do if not visited[id] and (not bestCost or value < bestCost or value==bestCost and tostring(id)<tostring(best)) then best, bestCost = id, value end end
        if not best then return nil, "No eligible route" end
        if best == goalId then
            local route, current = {}, goalId
            while current ~= startId do
                local edge = previous[current]
                if not edge then return nil, "Broken route graph" end
                table.insert(route, 1, edge); current = edge.from
            end
            return route, bestCost
        end
        visited[best] = true
        for _, edge in ipairs(edges[best] or {}) do
            if nodes[edge.to] and type(edge.cost) == "number" and edge.cost >= 0 then
                local nextCost = bestCost + edge.cost
                if not cost[edge.to] or nextCost < cost[edge.to] then cost[edge.to], previous[edge.to] = nextCost, edge end
            end
        end
    end
end
return rules

end)()

local perception = (function()
-- Ownership is evidence, never a Part name, child index or texture guess.
local perception={}
local function finite(n)return type(n)=="number" and n==n and math.abs(n)<math.huge end
function perception.ownership(evidence,localId,localName)
    local mine,other,shared=false,false,false
    for _,e in ipairs(evidence) do
        if e.kind=="shared" and e.value==true then shared=true
        elseif e.kind=="mine" and type(e.value)=="boolean" then
            if e.value then mine=true else other=true end
        elseif e.kind=="owner" and e.value~=nil and e.value~="" then
            if e.value==localId or e.value==localName or (type(e.value)=="string" and tonumber(e.value)==localId) then mine=true
            elseif type(e.value)=="number" or type(e.value)=="string" then other=true end
        end
    end
    if other then return "other" end -- Conflicting evidence never authorizes a detour.
    if mine then return "mine" end
    return shared and "shared" or "unknown"
end
function perception.radius(bees,attack,healthFraction)
    local weak=not finite(attack) or attack<20
    local r=weak and 11 or 8
    if not finite(bees) or bees<5 then r=math.max(r,13) end
    if finite(healthFraction) and healthFraction<0.5 then r=r+3 end
    return r
end
function perception.monsterRadius(name,base,body)
    -- Mondo Chick kills quickly and moves fast: keep a wide berth (native death on Mountain Top at the old 14-stud cap).
    if tostring(name):lower():find("mondo chick",1,true)then return math.max(28,base+body)end
    return base+math.min(8,body)
end
local function planar(a,b)local x,z=a.X-b.X,a.Z-b.Z;return math.sqrt(x*x+z*z) end
function perception.clear(a,b,monsters,margin)
    local dx,dz=b.X-a.X,b.Z-a.Z
    local len2=dx*dx+dz*dz
    for _,m in ipairs(monsters or {}) do
        local p=m.position
        if math.abs(a.Y-p.Y)<14 or math.abs(b.Y-p.Y)<14 then
            local r=m.radius+(margin or 0)
            local t=len2>0 and math.max(0,math.min(1,((p.X-a.X)*dx+(p.Z-a.Z)*dz)/len2)) or 0
            local x,z=a.X+t*dx-p.X,a.Z+t*dz-p.Z
            if x*x+z*z<r*r then
                local startDistance,endDistance=planar(a,p),planar(b,p)
                -- Permit leaving danger; never deepen an overlap or cut across its centre.
                if not (startDistance<r and endDistance>startDistance+1 and t<=0.05) then return false end
            end
        end
    end
    return true
end
function perception.tokenScore(token,position,goal,speed,allowUnknown)
    if token.owner=="other" or (token.owner=="unknown" and not allowUnknown) or token.active==false then return nil end
    local distance=planar(position,token.position)
    if distance<2 or distance>28 then return nil end
    local detour=distance+(goal and planar(token.position,goal)-planar(position,goal) or 0)
    if detour/math.max(1,speed)>3 then return nil end
    return (token.priority or 1)*4+(token.owner=="mine" and 4 or 0)-math.max(0,detour)/math.max(1,speed)
end
return perception

end)()

local motionGeometry = (function()
-- Ground probes and jump timing use the current Humanoid settings, never property writes.
local motion={}
-- Infer source ballistic time from signed horizontal progress, independent of E/ack latency.
-- The caller owns switch windows and deviation tolerances; negative progress remains observable.
function motion.cannonProgress(mount,shoot,force,gravity,current)
    local function finite(n)return type(n)=="number"and n==n and math.abs(n)<math.huge end
    if not finite(force)or force<=0 then return nil,nil,nil,"INVALID_FORCE"end
    if not finite(gravity)or gravity<=0 then return nil,nil,nil,"INVALID_GRAVITY"end
    local ok,mx,my,mz,sx,sy,sz,cx,cy,cz=pcall(function()
        return mount.X,mount.Y,mount.Z,shoot.X,shoot.Y,shoot.Z,current.X,current.Y,current.Z
    end)
    if not ok then return nil,nil,nil,"INVALID_POSITION"end
    local coordinates={mx,my,mz,sx,sy,sz,cx,cy,cz}
    for i=1,9 do if not finite(coordinates[i])then return nil,nil,nil,"INVALID_POSITION"end end
    local dx,dy,dz=sx-mx,sy-my,sz-mz
    local squared=dx*dx+dy*dy+dz*dz
    if not finite(squared)or squared<1e-12 then return nil,nil,nil,"INVALID_DIRECTION"end
    local scale=force/math.sqrt(squared)
    local vx,vy,vz=dx*scale,dy*scale,dz*scale
    local horizontal=vx*vx+vz*vz
    if not finite(horizontal)or horizontal<1 then return nil,nil,nil,"NO_HORIZONTAL_PROGRESS"end
    local elapsed=((cx-mx)*vx+(cz-mz)*vz)/horizontal
    if not finite(elapsed)then return nil,nil,nil,"INVALID_PROGRESS"end
    local px,py,pz=mx+vx*elapsed,my+vy*elapsed-0.5*gravity*elapsed*elapsed,mz+vz*elapsed
    if not finite(px)or not finite(py)or not finite(pz)then return nil,nil,nil,"INVALID_PREDICTION"end
    local deviation=math.sqrt((cx-px)^2+(cy-py)^2+(cz-pz)^2)
    if not finite(deviation)then return nil,nil,nil,"INVALID_DEVIATION"end
    return elapsed,Vector3.new(px,py,pz),deviation
end
-- During a scoped dispenser flight, native air drag changes horizontal speed.
-- Vertical velocity still supplies the gravity clock after the source impulse.
function motion.cannonObservedTime(mount,shoot,force,gravity,current,velocity)
    if type(force)~="number"or force<=0 or type(gravity)~="number"or gravity<=0 then return nil,"Invalid cannon physics"end
    local delta=shoot-mount
    if delta.Magnitude<.01 then return nil,"Invalid cannon direction"end
    local launch=delta.Unit*force
    local speed=math.sqrt(launch.X^2+launch.Z^2)
