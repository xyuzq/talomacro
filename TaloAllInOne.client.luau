                        points[#points]=nil
                        for i=2,#joined do points[#points+1]=joined[i]end
                        points[#points+1]=jump -- Keep the checked arc and all of its physics metadata.
                        previous=jump.Position
                        c.walkStats.takeoffJoins=(c.walkStats.takeoffJoins or 0)+1
                        return
                    end
                end
            end
            if #points==1 then points[1]=checked[1]end
            for i=2,#checked do points[#points+1]=checked[i]end
            previous=checked[#checked].Position
        end
        local i=1
        while i<=#routePoints do
            local raw=routePoints[i]
            if c.cancelled()then return false,"Canonical validation time/context expired"end
            local point=vector(raw.position or raw.Position or raw)
            if not point then return false,"Malformed canonical waypoint"end
            if (point-plannedPrevious).Magnitude>0.1 then
                local action=raw.action or raw.Action or(edge.kind=="jump"and i==#routePoints and"Jump")or"Walk"
                local following=routePoints[i+1]
                local nextJump=action=="Jump"and following and(following.action or following.Action)=="Jump"and vector(following.position or following.Position or following)or nil
                local checked,failure=checkedSegment(plannedPrevious,previous,point,action,c,nextJump,repairWalk)
                if not checked and action=="Walk"and edge.kind~="jump"and i<#routePoints and not c.cancelled()then
                    local nextRaw=routePoints[i+1]
                    local nextPoint=vector(nextRaw.position or nextRaw.Position or nextRaw)
                    local nextAction=nextRaw.action or nextRaw.Action or"Walk"
                    if nextPoint and nextAction=="Walk"and(nextPoint-previous).Magnitude<=24 and(nextPoint-point).Magnitude<=16 then
                        local shortcut=checkedSegment(plannedPrevious,previous,nextPoint,"Walk",c,nil,repairWalk)
                        if shortcut then
                            checked=shortcut;i=i+1
                            c.walkStats.cornerRepairs=(c.walkStats.cornerRepairs or 0)+1
                            c.walkRepairs=c.walkRepairs or{}
                            if #c.walkRepairs<16 then c.walkRepairs[#c.walkRepairs+1]={kind="checked corner bypass",skipped={x=point.X,y=point.Y,z=point.Z},
                                landing={x=nextPoint.X,y=nextPoint.Y,z=nextPoint.Z}}end
