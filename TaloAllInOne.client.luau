                if not options.force and not glider.eligible(part.Position,goal,gear,options)then return finish(false,"Cannon glide deployment window left the reachable envelope",part)end
                if deps.clear and not deps.clear(part.Position,goal)then return finish(false,"Cannon glide recovery corridor blocked; no second input",part)end
                record.deploymentRecoveryAttempted=true
